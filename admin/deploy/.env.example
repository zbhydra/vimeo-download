# Admin deployment environment template.
# Copy this file to .env.prod or .env.test, then fill values.
#
# 生产域名已统一为 vimeodownloader.app；Cloudflare Flexible SSL 在边缘终止 HTTPS。

SERVER_HOST=51.81.87.195
SERVER_USER=root
SERVER_PORT=22
SERVER_DEPLOY_ROOT=/data/vimeo-download/admin

DEPLOY_DOMAIN=admin9527.vimeodownloader.app
# 后端业务 API 根地址；build 时注入前端（VITE_API_BASE_URL），admin 直连后端，nginx 不再反代 /api/。
ADMIN_API_BASE_URL=https://api.vimeodownloader.app
REMOTE_NGINX_CONF=/usr/local/nginx/vhost/vimeo-admin.conf
NGINX_BIN=/usr/local/nginx/sbin/nginx

INSTALL_NGINX_CONF=1
SKIP_PUBLIC_VERIFY=0
SKIP_API_VERIFY=0

# Optional overrides:
# PUBLIC_VERIFY_URL=https://admin9527.vimeodownloader.app/
# ADMIN_CAPTCHA_URL=https://api.vimeodownloader.app/api/admin/auth/captcha
