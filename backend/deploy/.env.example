# vimeo-video-downloader deploy 环境配置模板（hydra 2026-04-30 决策：deploy 脚本接受 .env.* 参数）。
#
# 用法：
#   cp .env.example .env.prod       # 生产环境
#   # 填好下面的值后跑：
#   bash backend/deploy/init.sh   .env.prod       # 首次部署
#   bash backend/deploy/deploy.sh .env.prod       # Python 日常发版
#   bash backend/deploy/health_check.sh .env.prod       # Python 健康检查
#
# 设计：纯 shell `KEY=VALUE` 风格（最简；deploy 脚本 `source` 直接读）；
# 不依赖 yq / jq；注释用 `#`；值含空格或特殊字符必须加引号。
#
# 安全：.env.prod 等真实文件**不入 git**（.gitignore 已加）；
# 仅本模板 `.env.example` commit。secret 填在真实 .env 文件，由部署运维 1:1 与服务器同步。

###############################################################################
# 1. SSH 连接（init.sh / deploy.sh / health_check.sh 共用）
###############################################################################

# 服务器 IP 或域名
SERVER_HOST="51.81.87.195"

# SSH 端口
SERVER_PORT="22"

# SSH 用户
SERVER_USER="root"

# SSH 私钥路径（绝对路径；优先级最高）；留空 → 走 ~/.ssh/id_ed25519 或 ~/.ssh/id_rsa
# 也可改用 SSH_PASSWORD（不推荐；详 backend/deploy/README.md）
SSH_PRIVATE_KEY_PATH=""

###############################################################################
# 2. Git 仓库（init.sh / deploy.sh 共用）
###############################################################################

REPO_URL="git@github.com:CHANGE_ME/vimeo-video-downloader.git"
BRANCH="main"

###############################################################################
# 3. 部署目录（init.sh / deploy.sh 共用）
###############################################################################

# 远端部署根目录（必带尾 /）
DEPLOY_DIR="/data/vimeo-download/server/"

# 备份目录（deploy.sh 用）
BACKUP_DIR="/data/vimeo-download/server/.backups/"

# 保留备份版本数
KEEP_VERSIONS="5"

###############################################################################
# 4. 数据库（init.sh / deploy.sh 写入 backend/config.yaml）
###############################################################################

DB_HOST="127.0.0.1"
DB_USER="vimeo_download"
DB_PASSWD="1111111"
DB_NAME="vimeo_download"

# Redis 连接（可选；缺省走本机 127.0.0.1:6379 无密码，写入 backend/config.yaml）。
# 多套环境共用同一 Redis 时，靠 APP_NAME 隔离 key 前缀，不要靠改 db 编号区分。
REDIS_HOST="127.0.0.1"
REDIS_PORT="6379"
REDIS_PASSWORD=""

###############################################################################
# 5. 进程角色、对外地址与 Google 登录（init.sh / deploy.sh 写入 backend/config.yaml）
###############################################################################

# 业务服务器固定 business。
APP_NAME="vimeo-video-downloader-server"
APP_ROLE="business"
# 后端运行日志级别；正式环境建议 WARNING，避免普通 INFO 请求日志刷 supervisor。
LOGGER_LEVEL="WARNING"
# 生产域名已确定；
# backend/config.yaml 由这些值写入，代码侧默认值见 src/app/core/config_schema.py。
PUBLIC_API_BASE_URL="https://api.vimeodownloader.app"
PUBLIC_WEBSITE_BASE_URL="https://vimeodownloader.app"
JWT_SECRET_KEY="CHANGE_ME_RANDOM_JWT_SECRET"
# TODO(待替换): 旧 tg_download 项目的 client id 与 secret 已废弃。必须在 Google Cloud Console 建本项目的
# OAuth client，并把授权来源（网站 origin）与回调 `<PUBLIC_API_BASE_URL>/api/client/auth/google/oauth/callback`
# 登记进去。client id 是**必填**且须与 website 的 `PUBLIC_GOOGLE_CLIENT_ID` 完全一致（前端取 id_token、
# 后端校验 aud）；client secret 只留在后端、**不得进入任何 `PUBLIC_*` 前端配置**，且必须与新 client 同源。
# 占位值不阻塞部署与进程启动，只让 Google 登录在请求时失败，因此不要以为部署成功就等于配好了。
GOOGLE_CLIENT_ID="CHANGE_ME.apps.googleusercontent.com"
# 可选：仅新自定义 Google 按钮 OAuth code flow 需要（本值即上一条 TODO 里的 client secret）；留空不影响 One Tap 和旧 callback。
GOOGLE_CLIENT_SECRET=""

###############################################################################
# 6. 下载 token 签发与验签（init.sh / deploy.sh 写入 backend/config.yaml）
###############################################################################

DOWNLOAD_TOKEN_ALGORITHM="EdDSA"
# 业务服务器必须配置签发私钥；真实 PEM 可用字面 \n，或用 shell ANSI-C 引号保留换行。
DOWNLOAD_TOKEN_PRIVATE_KEY="CHANGE_ME_ED25519_PRIVATE_KEY_PEM"
# 验签公钥列表；轮换期间保留当前和上一轮公钥，没有上一轮时只留一条。
DOWNLOAD_TOKEN_PUBLIC_KEYS='
    - "CHANGE_ME_CURRENT_PUBLIC_KEY_PEM"
    - "CHANGE_ME_PREVIOUS_PUBLIC_KEY_PEM"
'
# business 和下载节点必须共用同一个 resource token secret。
RESOURCE_TOKEN_SECRET="CHANGE_ME_RESOURCE_TOKEN_SECRET"
# business 调用下载节点敏感 internal API 的共享凭证，business/download 必须一致。
SERVICE_NODE_INTERNAL_AUTH_TOKEN="RmY0R2pJ7V6vQxk9x2Z6bQn9D2uYpLwSxkM8cAa1bTqE"

###############################################################################
# 7. SMTP（init.sh / deploy.sh 写入 backend/config.yaml）
###############################################################################

SMTP_CONFIG='
smtp:
  - host: "smtp.resend.com"
    port: 587
    username: "resend"
    password: "CHANGE_ME"
    use_tls: true
    from_email: "validation@example.com"
    from_name: "Vimeo Video Downloader"
    timeout: 5
    weight: 100
  - host: "smtp.resend.com"
    port: 587
    username: "resend"
    password: "CHANGE_ME"
    use_tls: true
    from_email: "validation2@example.com"
    from_name: "Vimeo Video Downloader"
    timeout: 5
    weight: 100
'

###############################################################################
# 8. 业务后端进程与 Nginx（init.sh / deploy.sh / health_check.sh 用）
###############################################################################

# Python uvicorn 端口。
BACKEND_PORT_PY="7900"

# 业务 API Nginx 只监听 80，HTTPS 由 Cloudflare Flexible SSL 在边缘终止。
NGINX_SERVER_NAME="api.vimeodownloader.app"

###############################################################################
# 9. 飞书告警（init.sh / deploy.sh 写入 backend/config.yaml 的 feishu_alarm.webhook_url）
###############################################################################

# 飞书群机器人 webhook；它只走本变量注入，远端 config.yaml 每次发布都会被模板整份覆盖，
# 在服务器上手工改的值下次发布即失效。留空 = 告警跳过（记 WARNING、不发请求），非静默失败。
FEISHU_ALARM_WEBHOOK_URL=""
