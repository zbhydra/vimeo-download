---
import { getContent, type Locale } from '../i18n/content';
import { localeNames, localePaths, hreflangMap } from '../i18n/ui';
import { getCompanyContent } from '../company/companyContent';
import { getLegalContent } from '../legal/legalContent';
import {
  CHROME_WEB_STORE_URL,
  DEVELOPER_EMAIL,
  OFFICIAL_X_HANDLE,
  OFFICIAL_X_URL,
  PRODUCT_NAME
} from '../lib/site.mjs';
import SiteConfirmModal from '../components/site/SiteConfirmModal.astro';
import XBrandIcon from '../components/site/XBrandIcon.astro';

type JsonLdPrimitive = string | number | boolean | null;
type JsonLdValue = JsonLdPrimitive | JsonLdObject | JsonLdValue[];
interface JsonLdObject {
  [key: string]: JsonLdValue;
}
type JsonLd = JsonLdObject;

interface Props {
  locale: Locale;
  title?: string;
  description?: string;
  ogType?: string;
  ogImage?: string;
  includeSoftwareApplicationSchema?: boolean;
  structuredData?: JsonLd[];
  robots?: string;
  includeAlternateLanguageLinks?: boolean;
  includeLanguageSwitcher?: boolean;
  /** 独立流程页不渲染站点导航与页脚。 */
  standalone?: boolean;
}

// Base path for assets - change this if deploying to a subdirectory (e.g., '/vimeo-web')
// NOTE: import.meta.env.BASE_URL has a bug in Astro 5.x that returns '//' instead of '/'
const BASE = '/';

const {
  locale,
  title = 'Vimeo Video Download | Vimeo Video Downloader',
  description: descriptionProp,
  ogType = 'website',
  ogImage = `${BASE}og-image.png`,
  includeSoftwareApplicationSchema = true,
  structuredData = [],
  robots = 'index, follow',
  includeAlternateLanguageLinks = true,
  includeLanguageSwitcher = true,
  standalone = false,
} = Astro.props;

const t = getContent(locale);
const description = descriptionProp ?? t.site.description;
const companyContent = getCompanyContent(locale);
const legalContent = getLegalContent(locale);
const currentPath = Astro.url.pathname;
const normalizePathname = (pathname: string) => {
  if (pathname === '' || pathname === '/') {
    return '/';
  }

  return pathname.endsWith('/') ? pathname : `${pathname}/`;
};
const canonicalURL = new URL(normalizePathname(currentPath), Astro.site);

// Extract the page path without language prefix
// e.g., "/zh-tw/pricing/" → "/pricing/"
// e.g., "/pricing/" → "/pricing/"
const currentLocalePathPrefix = localePaths[locale] ? `/${localePaths[locale]}` : '';
const pagePathWithoutLocale = currentLocalePathPrefix
  ? currentPath.replace(currentLocalePathPrefix, '') || '/'
  : currentPath;
const normalizedPagePathWithoutLocale = normalizePathname(pagePathWithoutLocale);

// Build alternate language links with correct page paths
const alternateLinks = Object.entries(localePaths).map(([key, path]) => {
  // For each language, construct the full URL with language prefix + current page path
  const langPrefix = path === '' ? '' : `/${path}`;
  const url = `${langPrefix}${normalizedPagePathWithoutLocale}`;
  const fullUrl = new URL(url, Astro.site);
  return { locale: key as Locale, url: fullUrl.href };
});

const localePath = localePaths[locale] || '';
const currentLocalePath = localePath === '' ? '/' : `/${localePath}/`;
const termsPath = `${currentLocalePath}terms/`;
const privacyPath = `${currentLocalePath}privacy/`;
const aboutPath = `${currentLocalePath}about/`;
const contactPath = `${currentLocalePath}contact/`;
const pricingPath = `${currentLocalePath}pricing/`;
const languageOptionLinks = Object.entries(localePaths).map(([key, path]) => {
  const langPrefix = path === '' ? '' : `/${path}`;
  const targetPath = `${langPrefix}${normalizedPagePathWithoutLocale}`;
  return {
    locale: key as Locale,
    path: targetPath === '' ? '/' : targetPath
  };
});
const normalizedCurrentPath = normalizePathname(currentPath);
const isHomeActive = normalizedCurrentPath === currentLocalePath;
const isPricingActive = normalizedCurrentPath === pricingPath;
const schemaName = PRODUCT_NAME;
const siteHomeUrl = new URL('/', Astro.site).href;
const organizationId = new URL('/#organization', Astro.site).href;
const supportContactId = new URL('/#support', Astro.site).href;
const chromeWebStoreUrl = CHROME_WEB_STORE_URL;
const softwareApplicationSchema: JsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: schemaName,
  description: t.pages.homepage.softwareApplication.description,
  applicationCategory: 'BrowserExtension',
  operatingSystem: 'Chrome, Edge, Brave, and all Chromium-based browsers',
  browserRequirements: 'Requires JavaScript. Requires HTML5.',
  offers: {
    '@type': 'Offer',
    price: '0',
    priceCurrency: 'USD'
  },
  author: {
    '@id': organizationId
  },
  featureList: t.pages.homepage.softwareApplication.featureList
};
const organizationSchema: JsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  '@id': organizationId,
  name: schemaName,
  url: siteHomeUrl,
  logo: new URL('/favicon.png', Astro.site).href,
  email: DEVELOPER_EMAIL,
  contactPoint: {
    '@type': 'ContactPoint',
    '@id': supportContactId,
    contactType: 'customer support',
    email: DEVELOPER_EMAIL,
    url: new URL('/contact/', Astro.site).href,
    availableLanguage: Object.keys(localePaths)
  },
  sameAs: [chromeWebStoreUrl, OFFICIAL_X_URL]
};
const structuredDataItems = [
  ...(includeSoftwareApplicationSchema ? [softwareApplicationSchema] : []),
  ...structuredData,
  organizationSchema
];
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <!-- Google tag (gtag.js) -->
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-LBSKJD0H16"></script>
    <script is:inline define:vars={{ GA_ID: 'G-LBSKJD0H16' }}>
      window.dataLayer = window.dataLayer || [];
      window.gtag = function gtag(){window.dataLayer.push(arguments);}
      window.gtag('js', new Date());
      window.gtag('config', GA_ID);
    </script>
    <!-- Microsoft Clarity is temporarily disabled for performance testing.
    <script is:inline>
      (function(c,l,a,r,i,t,y){
        c[a]=c[a]||function(){(c[a].q=c[a].q||[]).push(arguments)};
        t=l.createElement(r);t.async=1;t.src="https://www.clarity.ms/tag/"+i;
        y=l.getElementsByTagName(r)[0];y.parentNode.insertBefore(t,y);
      })(window, document, "clarity", "script", "xyfmieibkw");
    </script>
    -->
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#ffffff" />
    <link rel="icon" type="image/png" sizes="128x128" href="/favicon.png" />
    <link rel="manifest" href="/manifest.json" />
    <link rel="canonical" href={canonicalURL} />
    <!-- SEO Meta Tags -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <!-- keywords 留空：现代搜索引擎忽略该标签，由引擎自行从正文提取关键词（与 Cloudflare 等站点做法一致） -->
    <meta name="keywords" content="" />
    <meta name="author" content={PRODUCT_NAME} />
    <meta name="robots" content={robots} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(ogImage, Astro.site)} />
    <meta property="og:locale" content={locale} />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalURL} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={new URL(ogImage, Astro.site)} />
    <meta name="twitter:site" content={OFFICIAL_X_HANDLE} />

    <!-- Alternate Language Links -->
    {includeAlternateLanguageLinks && alternateLinks.map(link => (
      <link rel="alternate" hreflang={hreflangMap[link.locale]} href={link.url} />
    ))}
    {includeAlternateLanguageLinks && (
      <link rel="alternate" hreflang="x-default" href={alternateLinks.find(l => l.locale === 'en-US')?.url || canonicalURL} />
    )}

    <!-- Structured Data -->
    {structuredDataItems.map(item => (
      <script type="application/ld+json" is:inline set:html={JSON.stringify(item)} />
    ))}
    <style is:inline is:global>
      /*
        Geist 亮色 token（取自 docs/references/specs/design.md，命名对齐，只收录用到的子集）。
      */
      :root {
        --background-100: #ffffff;
        --gray-100: #f2f2f2;
        --gray-700: #8f8f8f;
        --gray-900: #4d4d4d;
        --gray-1000: #171717;
        --gray-alpha-100: #0000000d;
        --gray-alpha-400: #00000014;
        --gray-alpha-500: #00000036;
        --gray-alpha-600: #0000003d;
        --blue-700: #006bff;
        --blue-800: #0059ec;
        --amber-100: #fff6de;
        --amber-900: #aa4d00;
        --background-200: #fafafa;
        --blue-100: #f0f7ff;
        --blue-200: #e9f4ff;
        --blue-400: #cae7ff;
        --blue-500: #94ccff;
        --red-100: #ffeeef;
        --red-400: #ffd7d6;
        --red-900: #d8001b;
        --green-100: #ecfdec;
        --green-400: #b9f5bc;
        --green-900: #107d32;

        --font-sans: ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, 'Noto Sans', sans-serif;

        --radius-sm: 6px;
        --radius-md: 12px;

        --shadow-card: 0 2px 2px rgba(0, 0, 0, 0.04);
        --shadow-popover: 0 1px 1px rgba(0, 0, 0, 0.02), 0 4px 8px -4px rgba(0, 0, 0, 0.04), 0 16px 24px -8px rgba(0, 0, 0, 0.06);
        --shadow-modal: 0 1px 1px rgba(0, 0, 0, 0.02), 0 8px 16px -4px rgba(0, 0, 0, 0.04), 0 24px 32px -8px rgba(0, 0, 0, 0.06);

        --focus-ring: 0 0 0 2px #fff, 0 0 0 4px #006bff;
        --transition-fast: 160ms;
        --transition-normal: 220ms;
      }

      * {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
      }

      html {
        scroll-behavior: smooth;
      }

      body {
        min-height: 100vh;
        font-family: var(--font-sans);
        font-size: 14px;
        line-height: 1.6;
        color: var(--gray-1000);
        background: var(--background-100);
        -webkit-font-smoothing: antialiased;
        -moz-osx-font-smoothing: grayscale;
      }

      a {
        color: inherit;
        text-decoration: none;
        transition: color var(--transition-fast), background-color var(--transition-fast), border-color var(--transition-fast);
      }

      button {
        font-family: inherit;
        border: none;
        background: none;
        cursor: pointer;
      }

      [hidden] {
        display: none !important;
      }

      img,
      svg {
        display: block;
      }

      h1,
      h2,
      h3,
      h4 {
        font-family: var(--font-sans);
        color: var(--gray-1000);
      }

      /* 全站焦点环：特异性 0,4,0，组件覆盖规则见 spec-website §4；tabindex="-1"（脚本聚焦）不显示。 */
      :root :is(a, button, input, select, textarea, summary, [tabindex]:not([tabindex="-1"])):focus-visible {
        outline: none;
        box-shadow: var(--focus-ring);
      }

      /* 全站按钮：主按钮 gray-1000 实底，次按钮白底加 gray-alpha-400 描边。 */
      .btn-primary,
      .btn-secondary {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        height: 40px;
        padding: 0 10px;
        border: 1px solid transparent;
        border-radius: var(--radius-sm);
        font-size: 14px;
        font-weight: 500;
        line-height: 20px;
        white-space: nowrap;
        transition: color var(--transition-fast), background-color var(--transition-fast), border-color var(--transition-fast);
      }

      .btn-primary {
        color: var(--background-100);
        background: var(--gray-1000);
      }

      .btn-primary:hover {
        background: var(--gray-900);
      }

      .btn-secondary {
        color: var(--gray-1000);
        background: var(--background-100);
        border-color: var(--gray-alpha-400);
      }

      .btn-secondary:hover {
        background: var(--gray-100);
        border-color: var(--gray-alpha-500);
      }

      .btn-primary:disabled,
      .btn-secondary:disabled {
        color: var(--gray-700);
        background: var(--gray-100);
        border-color: transparent;
        cursor: not-allowed;
      }

      .btn-primary-icon {
        width: 18px;
        height: 18px;
        flex: 0 0 18px;
      }

      /* 全站链接：accent blue-700 只用于链接与焦点。 */
      .text-link {
        color: var(--blue-700);
        text-decoration: underline;
        text-underline-offset: 3px;
      }

      .text-link:hover {
        color: var(--blue-800);
      }

      .container,
      .nav,
      .footer-content {
        width: min(1200px, calc(100vw - 32px));
        margin: 0 auto;
      }

      .header {
        position: sticky;
        top: 0;
        z-index: 100;
        background: var(--background-100);
        border-bottom: 1px solid var(--gray-alpha-400);
      }

      .nav {
        height: 64px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
      }

      .logo {
        display: flex;
        align-items: center;
        gap: 8px;
        min-width: 0;
        color: var(--gray-1000);
      }

      .logo span {
        overflow: hidden;
        font-size: 16px;
        font-weight: 600;
        letter-spacing: -0.32px;
        text-overflow: ellipsis;
        white-space: nowrap;
      }

      .logo img {
        width: 32px;
        height: 32px;
        flex: 0 0 32px;
        border-radius: var(--radius-sm);
      }

      .nav-links {
        display: flex;
        align-items: center;
        gap: 4px;
        margin-right: auto;
        margin-left: 24px;
      }

      .nav-links a {
        padding: 6px 12px;
        border-radius: var(--radius-sm);
        color: var(--gray-900);
        font-size: 14px;
        font-weight: 500;
        line-height: 20px;
      }

      .nav-links a:hover,
      .nav-links a.active {
        color: var(--gray-1000);
        background: var(--gray-100);
      }

      .nav-actions {
        display: flex;
        align-items: center;
        flex: 0 0 auto;
        gap: 8px;
      }

      .nav-install-link {
        gap: 8px;
        height: 32px;
        padding: 0 10px 0 8px;
      }

      .nav-install-icon {
        width: 20px;
        height: 20px;
        flex: 0 0 20px;
      }

      .lang-switcher {
        position: relative;
      }

      .lang-btn {
        display: flex;
        align-items: center;
        gap: 8px;
        height: 32px;
        max-width: 160px;
        padding: 0 10px;
        border: 1px solid var(--gray-alpha-400);
        border-radius: var(--radius-sm);
        color: var(--gray-1000);
        background: var(--background-100);
        font-size: 14px;
        font-weight: 500;
        white-space: nowrap;
      }

      .lang-btn:hover {
        background: var(--gray-100);
        border-color: var(--gray-alpha-500);
      }

      .lang-dropdown {
        position: absolute;
        top: calc(100% + 8px);
        right: 0;
        min-width: 160px;
        padding: 4px;
        background: var(--background-100);
        border: 1px solid var(--gray-alpha-400);
        border-radius: var(--radius-md);
        box-shadow: var(--shadow-popover);
        opacity: 0;
        visibility: hidden;
        transform: translateY(-4px);
        transition: opacity var(--transition-fast), transform var(--transition-fast), visibility var(--transition-fast);
      }

      .lang-dropdown.show {
        opacity: 1;
        visibility: visible;
        transform: translateY(0);
      }

      .lang-dropdown .lang-option {
        display: block;
        width: 100%;
        padding: 8px 12px;
        border-radius: var(--radius-sm);
        text-align: left;
        font-size: 14px;
        color: var(--gray-900);
      }

      .lang-dropdown .lang-option:hover,
      .lang-dropdown .lang-option.current {
        background: var(--gray-100);
        color: var(--gray-1000);
      }

      .mobile-menu-btn {
        display: none;
        flex-direction: column;
        justify-content: center;
        gap: 4px;
        width: 32px;
        height: 32px;
        border: 1px solid var(--gray-alpha-400);
        border-radius: var(--radius-sm);
        background: var(--background-100);
      }

      .mobile-menu-btn:hover {
        background: var(--gray-100);
      }

      .hamburger {
        display: block;
        width: 14px;
        height: 1.5px;
        margin: 0 auto;
        background: var(--gray-1000);
        border-radius: 1px;
        transition: transform var(--transition-fast), opacity var(--transition-fast);
      }

      .mobile-nav {
        position: absolute;
        top: 100%;
        left: 0;
        right: 0;
        background: var(--background-100);
        border-bottom: 1px solid var(--gray-alpha-400);
        box-shadow: var(--shadow-popover);
        max-height: 0;
        overflow: hidden;
        visibility: hidden;
        transition: max-height var(--transition-normal) ease-out, visibility var(--transition-normal);
      }

      .mobile-nav.open {
        max-height: 320px;
        visibility: visible;
      }

      .mobile-nav-inner {
        display: flex;
        flex-direction: column;
        width: min(1200px, calc(100vw - 32px));
        margin: 0 auto;
        padding: 8px 0 16px;
        gap: 4px;
      }

      .mobile-nav a {
        padding: 10px 12px;
        border-radius: var(--radius-sm);
        font-size: 14px;
        font-weight: 500;
        color: var(--gray-900);
      }

      .mobile-nav a:hover,
      .mobile-nav a.active {
        background: var(--gray-100);
        color: var(--gray-1000);
      }

      .header.menu-open .mobile-menu-btn .hamburger:nth-child(1) {
        transform: translateY(5.5px) rotate(45deg);
      }

      .header.menu-open .mobile-menu-btn .hamburger:nth-child(2) {
        opacity: 0;
      }

      .header.menu-open .mobile-menu-btn .hamburger:nth-child(3) {
        transform: translateY(-5.5px) rotate(-45deg);
      }

      .page-hero h1 {
        font-size: clamp(3rem, 7vw, 5rem);
        line-height: 0.95;
        letter-spacing: -0.06em;
      }

      .footer {
        margin-top: 80px;
        border-top: 1px solid var(--gray-alpha-400);
        background: var(--background-100);
      }

      .footer-content {
        padding-top: 40px;
        padding-bottom: 24px;
      }

      .footer-link-groups {
        display: grid;
        grid-template-columns: repeat(2, minmax(160px, 240px));
        gap: 48px;
        padding-bottom: 32px;
        text-align: left;
      }

      .footer-link-group {
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        gap: 8px;
        min-width: 0;
      }

      .footer-link-title {
        margin-bottom: 4px;
        color: var(--gray-1000);
        font-size: 14px;
        font-weight: 600;
        line-height: 20px;
      }

      .footer-meta {
        display: flex;
        align-items: center;
        min-height: 56px;
        padding-top: 16px;
        border-top: 1px solid var(--gray-alpha-400);
      }

      .footer-brand-row {
        display: flex;
        align-items: center;
        gap: 8px;
      }

      .footer-brand-icon {
        position: relative;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 24px;
        height: 24px;
        flex: 0 0 24px;
        background: url('/favicon.png') center / contain no-repeat;
      }

      .footer-brand-icon img {
        position: absolute;
        inset: 0;
        width: 24px;
        height: 24px;
        flex: 0 0 24px;
        border-radius: var(--radius-sm);
      }

      .footer-link-group a,
      .footer-meta p {
        color: var(--gray-900);
        font-size: 14px;
      }

      .footer-link-group a {
        max-width: 100%;
        line-height: 20px;
        overflow-wrap: anywhere;
      }

      .footer-link-group .footer-social-link {
        display: inline-flex;
        align-items: center;
        gap: 8px;
      }

      .footer-link-group a:hover {
        color: var(--gray-1000);
        text-decoration: underline;
        text-underline-offset: 3px;
      }

      @media (max-width: 960px) {
        .nav-links,
        .nav-actions > .nav-install-link {
          display: none;
        }

        .lang-btn {
          max-width: 128px;
        }

        .lang-btn span {
          overflow: hidden;
          text-overflow: ellipsis;
        }

        .mobile-menu-btn {
          display: flex;
        }

        .footer-link-groups {
          grid-template-columns: repeat(2, minmax(0, 1fr));
          gap: 32px 24px;
        }
      }

      @media (max-width: 600px) {
        .footer {
          margin-top: 64px;
        }

        .footer-content {
          padding-top: 32px;
          padding-bottom: 20px;
        }
      }
    </style>

  </head>
  <body>
    {!standalone && <header class="header">
      <nav class="nav">
        <a href={currentLocalePath} class="logo">
          <img src="/favicon.png" width="40" height="40" alt="" />
          <span>{t.layout.nav.brand}</span>
        </a>

        <!-- Desktop Navigation -->
        <div class="nav-links">
          <a href={currentLocalePath} class={isHomeActive ? 'active' : ''}>
            {t.layout.nav.home}
          </a>
          <a
            href={pricingPath}
            class={isPricingActive ? 'active' : ''}
            data-ga-event="internal_workflow_click"
            data-ga-source="nav"
            data-ga-target="pricing"
          >
            {t.layout.nav.pricing}
          </a>
        </div>

        <div class="nav-actions">
          <a
            href={chromeWebStoreUrl}
            target="_blank"
            rel="noopener"
            class="btn-secondary nav-install-link"
            aria-label={t.common.installCta}
            data-ga-event="outbound_chrome_store_click"
            data-ga-source="nav"
          >
            <img
              src="/googe-ext-logo-192px.svg"
              width="192"
              height="192"
              alt=""
              class="nav-install-icon"
              fetchpriority={isHomeActive ? 'high' : undefined}
            />
            <span>{t.common.installCta}</span>
          </a>

          {includeLanguageSwitcher && (
            <div class="lang-switcher">
              <button class="lang-btn" aria-label="Language switcher">
                <span>{localeNames[locale]}</span>
                <svg width="12" height="12" viewBox="0 0 12 12" fill="none">
                  <path d="M2 4L6 8L10 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </button>
              <div class="lang-dropdown">
                {languageOptionLinks.map(link => (
                  <button
                    data-locale={link.locale}
                    data-path={link.path}
                    data-ga-event="language_switch"
                    data-ga-locale={link.locale}
                    data-ga-from={locale}
                    class={`lang-option ${link.locale === locale ? 'current' : ''}`}
                  >
                    {localeNames[link.locale]}
                  </button>
                ))}
              </div>
            </div>
          )}

          <!-- Mobile Menu Button -->
          <button class="mobile-menu-btn" aria-label="Toggle menu" aria-expanded="false">
            <span class="hamburger"></span>
            <span class="hamburger"></span>
            <span class="hamburger"></span>
          </button>
        </div>
      </nav>

      <!-- Mobile Navigation Menu -->
      <div class="mobile-nav">
        <div class="mobile-nav-inner">
          <a href={currentLocalePath} class={isHomeActive ? 'active' : ''}>
            {t.layout.nav.home}
          </a>
          <a
            href={pricingPath}
            class={isPricingActive ? 'active' : ''}
            data-ga-event="internal_workflow_click"
            data-ga-source="mobile_nav"
            data-ga-target="pricing"
          >
            {t.layout.nav.pricing}
          </a>
          <a
            href={chromeWebStoreUrl}
            target="_blank"
            rel="noopener"
            data-ga-event="outbound_chrome_store_click"
            data-ga-source="mobile_nav"
          >
            {t.common.installCta}
          </a>
        </div>
      </div>
    </header>}

    <main class="main">
      <slot />
    </main>

    {!standalone && <footer class="footer">
      <div class="footer-content">
        <nav
          class="footer-link-groups"
          aria-label={`${companyContent.footerGroupLabel} / ${t.layout.footer.resources}`}
        >
          <div class="footer-link-group">
            <p class="footer-link-title">{companyContent.footerGroupLabel}</p>
            <a
              href={aboutPath}
              data-ga-event="internal_workflow_click"
              data-ga-source="footer"
              data-ga-target="about"
            >
              {companyContent.about.navLabel}
            </a>
            <a
              href={contactPath}
              data-ga-event="internal_workflow_click"
              data-ga-source="footer"
              data-ga-target="contact"
            >
              {companyContent.contact.navLabel}
            </a>
            <a
              class="footer-social-link"
              href={OFFICIAL_X_URL}
              target="_blank"
              rel="me noopener noreferrer"
              aria-label={`${companyContent.officialXLabel} (${OFFICIAL_X_HANDLE})`}
              data-ga-event="official_x_click"
              data-ga-source="footer"
              data-ga-target="official_x"
            >
              <XBrandIcon />
              <span>{companyContent.officialXLabel}</span>
            </a>
          </div>
          <div class="footer-link-group" data-footer-resources>
            <p class="footer-link-title">{t.layout.footer.resources}</p>
            <a
              href={termsPath}
              data-ga-event="internal_workflow_click"
              data-ga-source="footer"
              data-ga-target="terms"
            >
              {legalContent.terms.navLabel}
            </a>
            <a
              href={privacyPath}
              data-ga-event="internal_workflow_click"
              data-ga-source="footer"
              data-ga-target="privacy"
            >
              {legalContent.privacy.navLabel}
            </a>
          </div>
        </nav>
        <div class="footer-meta">
          <div class="footer-brand-row">
            <span class="footer-brand-icon" data-footer-brand-icon></span>
            <p>{t.layout.footer.rights}</p>
          </div>
        </div>
      </div>
    </footer>}

    <SiteConfirmModal />

    <script>
      import { installFrontendErrorCapture } from '../scripts/runtime/frontend-error-capture'
      import { initializeFooterBrandIcon } from '../scripts/runtime/device'
      import { initializeWebsiteFirstOpenedMark } from '../scripts/runtime/first-opened-mark'
      import '../scripts/globalClickEvents'

      void initializeFooterBrandIcon()
      initializeWebsiteFirstOpenedMark()

      installFrontendErrorCapture(capturedError => {
        void import('../scripts/runtime/sls-mark')
          .then(({ reportFrontendCapturedErrorToSls }) => {
            reportFrontendCapturedErrorToSls(capturedError)
          })
          .catch(error => {
            console.error(
              new Error('[layout] Failed to load the frontend error reporter.', { cause: error })
            )
          })
      })

    </script>

    <script>
      import { initializeLanguageSwitcher } from '../scripts/site/language-switcher'

      initializeLanguageSwitcher()

      // Mobile menu toggle
      const mobileMenuBtn = document.querySelector('.mobile-menu-btn');
      const mobileNav = document.querySelector('.mobile-nav');
      const header = document.querySelector('.header');

      mobileMenuBtn?.addEventListener('click', () => {
        const isOpen = mobileNav?.classList.toggle('open');
        mobileMenuBtn?.setAttribute('aria-expanded', String(isOpen));
        header?.classList.toggle('menu-open', isOpen);
      });

      // Close mobile menu when clicking outside
      document.addEventListener('click', (e) => {
        if (mobileNav?.classList.contains('open')) {
          const target = e.target as HTMLElement;
          if (!target.closest('.mobile-nav') && !target.closest('.mobile-menu-btn')) {
            mobileNav.classList.remove('open');
            mobileMenuBtn?.setAttribute('aria-expanded', 'false');
            header?.classList.remove('menu-open');
          }
        }
      });

      // Close mobile menu when clicking on a link
      const mobileNavLinks = document.querySelectorAll('.mobile-nav a');
      mobileNavLinks.forEach(link => {
        link.addEventListener('click', () => {
          mobileNav?.classList.remove('open');
          mobileMenuBtn?.setAttribute('aria-expanded', 'false');
          header?.classList.remove('menu-open');
        });
      });
    </script>
  </body>
</html>
