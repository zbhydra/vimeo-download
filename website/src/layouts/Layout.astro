---
import { getContent, type Locale } from '../i18n/content';
import { defaultLocale, localeNames, localePaths, hreflangMap, locales } from '../i18n/ui';
import { getCompanyContent } from '../company/companyContent';
import { getGuideLocales, getGuidesContent, getGuidesPath } from '../guides/guidesContent';
import {
  CHROME_WEB_STORE_URL,
  DEVELOPER_EMAIL,
  OFFICIAL_X_HANDLE,
  OFFICIAL_X_URL,
  OPERATOR_LEGAL_NAME,
  PRODUCT_NAME
} from '../lib/site.mjs';
import SiteConfirmModal from '../components/site/SiteConfirmModal.astro';

type JsonLdPrimitive = string | number | boolean | null;
type JsonLdValue = JsonLdPrimitive | JsonLdObject | JsonLdValue[];
interface JsonLdObject {
  [key: string]: JsonLdValue;
}
type JsonLd = JsonLdObject;

interface Props {
  locale: Locale;
  title: string;
  description?: string;
  ogType?: string;
  ogImage?: string;
  includeSoftwareApplicationSchema?: boolean;
  structuredData?: JsonLd[];
  robots?: string;
  /**
   * 与本页内容对等、且允许索引的语言版本，hreflang 只在这些版本之间互指。
   * 默认全部语言；不足 2 个时不输出 hreflang，因为没有可互指的对等版本。
   */
  alternateLocales?: readonly Locale[];
  /**
   * 本页实际存在的语言版本，默认全部语言。语言切换器只列这些语言，不足 2 个时不显示。
   * 与 alternateLocales 不同：法务页渲染英文回退稿的语言路由存在，但不参与 hreflang。
   */
  availableLocales?: readonly Locale[];
  /** 独立流程页不渲染站点导航与页脚。 */
  standalone?: boolean;
}

// Base path for assets - change this if deploying to a subdirectory (e.g., '/vimeo-web')
// NOTE: import.meta.env.BASE_URL has a bug in Astro 5.x that returns '//' instead of '/'
const BASE = '/';

const {
  locale,
  title,
  description: descriptionProp,
  ogType = 'website',
  ogImage = `${BASE}og-image.png`,
  includeSoftwareApplicationSchema = true,
  structuredData = [],
  robots = 'index, follow',
  alternateLocales = locales,
  availableLocales = locales,
  standalone = false,
} = Astro.props;

const t = getContent(locale);
const description = descriptionProp ?? t.site.description;
const companyContent = getCompanyContent(locale);
const currentPath = Astro.url.pathname;
const normalizePathname = (pathname: string) => {
  if (pathname === '' || pathname === '/') {
    return '/';
  }

  return pathname.endsWith('/') ? pathname : `${pathname}/`;
};
const canonicalURL = new URL(normalizePathname(currentPath), Astro.site);

// Extract the page path without language prefix
// e.g., "/zh-tw/ext-pricing/" → "/ext-pricing/"
// e.g., "/ext-pricing/" → "/ext-pricing/"
const currentLocalePathPrefix = localePaths[locale] ? `/${localePaths[locale]}` : '';
const pagePathWithoutLocale = currentLocalePathPrefix
  ? currentPath.replace(currentLocalePathPrefix, '') || '/'
  : currentPath;
const normalizedPagePathWithoutLocale = normalizePathname(pagePathWithoutLocale);

// Build alternate language links with correct page paths
const alternateLinks = alternateLocales.length > 1
  ? alternateLocales.map(alternateLocale => {
      // For each language, construct the full URL with language prefix + current page path
      const path = localePaths[alternateLocale];
      const langPrefix = path === '' ? '' : `/${path}`;
      const url = `${langPrefix}${normalizedPagePathWithoutLocale}`;
      const fullUrl = new URL(url, Astro.site);
      return { locale: alternateLocale, url: fullUrl.href };
    })
  : [];
const xDefaultLink = alternateLinks.find(link => link.locale === defaultLocale);

const localePath = localePaths[locale] || '';
const currentLocalePath = localePath === '' ? '/' : `/${localePath}/`;
const termsPath = `${currentLocalePath}terms/`;
const privacyPath = `${currentLocalePath}privacy/`;
const aboutPath = `${currentLocalePath}about/`;
const contactPath = `${currentLocalePath}contact/`;
const languageOptionLinks = Object.entries(localePaths)
  .filter(([key]) => availableLocales.some(availableLocale => availableLocale === key))
  .map(([key, path]) => {
    const langPrefix = path === '' ? '' : `/${path}`;
    const targetPath = `${langPrefix}${normalizedPagePathWithoutLocale}`;
    return {
      locale: key as Locale,
      path: targetPath === '' ? '/' : targetPath
    };
  });
const showLanguageSwitcher = languageOptionLinks.length > 1;
// 页脚 Guides 入口只在当前语言有文章时出现，文章没有回退语言。
const guidesPath = (await getGuideLocales()).includes(locale) ? getGuidesPath(locale) : undefined;
const guidesContent = getGuidesContent(locale);
const normalizedCurrentPath = normalizePathname(currentPath);
const isHomeActive = normalizedCurrentPath === currentLocalePath;
const schemaName = PRODUCT_NAME;
const siteHomeUrl = new URL('/', Astro.site).href;
const websiteId = new URL('/#website', Astro.site).href;
const organizationId = new URL('/#organization', Astro.site).href;
const supportContactId = new URL('/#support', Astro.site).href;
const chromeWebStoreUrl = CHROME_WEB_STORE_URL;
const softwareApplicationSchema: JsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: schemaName,
  description: t.pages.homepage.softwareApplication.description,
  applicationCategory: 'BrowserExtension',
  operatingSystem: 'Chrome, Edge, Brave, and all Chromium-based browsers',
  browserRequirements: 'Requires JavaScript. Requires HTML5.',
  offers: {
    '@type': 'Offer',
    price: '0',
    priceCurrency: 'USD'
  },
  author: {
    '@id': organizationId
  },
  featureList: t.pages.homepage.softwareApplication.featureList
};
// WebSite.name 是 Google 站点名称的首选来源，与导航、页脚、og:site_name 用同一个品牌词。
const websiteSchema: JsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': websiteId,
  name: schemaName,
  url: siteHomeUrl,
  publisher: {
    '@id': organizationId
  }
};
const organizationSchema: JsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  '@id': organizationId,
  name: schemaName,
  legalName: OPERATOR_LEGAL_NAME,
  url: siteHomeUrl,
  logo: new URL('/favicon.png', Astro.site).href,
  email: DEVELOPER_EMAIL,
  contactPoint: {
    '@type': 'ContactPoint',
    '@id': supportContactId,
    contactType: 'customer support',
    email: DEVELOPER_EMAIL,
    url: new URL('/contact/', Astro.site).href,
    availableLanguage: Object.keys(localePaths)
  },
  sameAs: [chromeWebStoreUrl, OFFICIAL_X_URL]
};
const structuredDataItems = [
  ...(includeSoftwareApplicationSchema ? [softwareApplicationSchema] : []),
  ...structuredData,
  websiteSchema,
  organizationSchema
];
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <!-- Google tag (gtag.js) -->
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-B5RGH4W50V"></script>
    <script is:inline define:vars={{ GA_ID: 'G-B5RGH4W50V' }}>
      window.dataLayer = window.dataLayer || [];
      window.gtag = function gtag(){window.dataLayer.push(arguments);}
      window.gtag('js', new Date());
      window.gtag('config', GA_ID);
    </script>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#070B18" />
    <link rel="icon" type="image/png" sizes="128x128" href="/favicon.png" />
    <link rel="manifest" href="/manifest.json" />
    <link rel="canonical" href={canonicalURL} />
    <!-- SEO Meta Tags -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <!-- keywords 留空：现代搜索引擎忽略该标签，由引擎自行从正文提取关键词（与 Cloudflare 等站点做法一致） -->
    <meta name="keywords" content="" />
    <meta name="author" content={PRODUCT_NAME} />
    <meta name="application-name" content={PRODUCT_NAME} />
    <meta name="robots" content={robots} />

    <!-- Open Graph / Facebook -->
    <meta property="og:site_name" content={PRODUCT_NAME} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(ogImage, Astro.site)} />
    <meta property="og:locale" content={locale} />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalURL} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={new URL(ogImage, Astro.site)} />
    <meta name="twitter:site" content={OFFICIAL_X_HANDLE} />

    <!-- Alternate Language Links -->
    {alternateLinks.map(link => (
      <link rel="alternate" hreflang={hreflangMap[link.locale]} href={link.url} />
    ))}
    {xDefaultLink && <link rel="alternate" hreflang="x-default" href={xDefaultLink.url} />}

    <!-- Structured Data -->
    {structuredDataItems.map(item => (
      <script type="application/ld+json" is:inline set:html={JSON.stringify(item)} />
    ))}
    <style is:inline is:global>
      /*
        全站深色 token。中性色沿用 Geist 的 token 名（对齐 docs/references/specs/design.md），
        值翻转为偏蓝的深色，与 Geist 暗色主题（design.dark.md）同一种做法：语义名不变，值翻转。
        只收录用到的子集；取值与对比度依据见 docs/feat/000.架构/plans/005 §2.2。
        跨组件使用的颜色只能从这里取，纯白只用于主按钮文字与 Chrome 图标的小白底板。
      */
      :root {
        color-scheme: dark;

        --background-100: #070b18;
        --background-200: #0a1020;
        --gray-100: #0e1529;
        --gray-200: #131c36;
        --gray-700: #7e88a4;
        --gray-900: #a3acc4;
        --gray-1000: #e3e8f5;
        --gray-alpha-100: rgba(148, 163, 255, 0.06);
        --gray-alpha-400: rgba(148, 163, 255, 0.12);
        --gray-alpha-500: rgba(148, 163, 255, 0.22);
        --gray-alpha-600: rgba(148, 163, 255, 0.28);
        --blue-700: #8ab4ff;
        --blue-800: #a9c6ff;
        --blue-100: rgba(96, 150, 255, 0.1);
        --blue-200: rgba(96, 150, 255, 0.16);
        --blue-400: rgba(96, 150, 255, 0.28);
        --blue-500: rgba(96, 150, 255, 0.45);
        --amber-100: rgba(251, 146, 60, 0.1);
        --amber-400: rgba(251, 146, 60, 0.28);
        --amber-900: #fed7aa;
        --red-100: rgba(248, 113, 113, 0.1);
        --red-400: rgba(248, 113, 113, 0.28);
        --red-900: #fca5a5;
        --green-100: rgba(74, 222, 128, 0.1);
        --green-400: rgba(74, 222, 128, 0.28);
        --green-900: #86efac;
        --violet-200: rgba(139, 92, 246, 0.16);
        --violet-900: #c4b5fd;

        --brand-500: #2d6ae8;
        --brand-600: #1f4fcc;
        --gradient-button: linear-gradient(180deg, #2f6bea 0%, var(--brand-600) 100%);
        --gradient-brand: linear-gradient(100deg, #2f6bea 0%, #5b5bf0 50%, #6d4ae6 100%);
        --gradient-brand-text: linear-gradient(100deg, #8ab4ff 0%, #a78bfa 55%, #c4b5fd 100%);
        --gradient-border: linear-gradient(
          140deg,
          rgba(138, 180, 255, 0.75) 0%,
          rgba(167, 139, 250, 0.35) 50%,
          rgba(103, 232, 249, 0.55) 100%
        );
        --neon-cyan: #67e8f9;
        --glass-bg: rgba(255, 255, 255, 0.06);
        --glass-border: rgba(255, 255, 255, 0.12);
        --on-brand: #fff;
        --overlay-bg: rgba(3, 6, 14, 0.72);
        --payment-plate: #e6ebf3;
        --shadow-glow: 0 8px 20px -8px rgba(45, 106, 232, 0.65);
        --shadow-badge-color: rgba(45, 106, 232, 0.8);

        --font-sans: ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, 'Noto Sans', sans-serif;

        --radius-sm: 6px;
        --radius-md: 12px;
        --radius-lg: 16px;
        --radius-xl: 20px;
        --radius-2xl: 24px;

        --shadow-card: inset 0 1px 0 rgba(255, 255, 255, 0.04), 0 20px 40px -24px rgba(0, 0, 0, 0.6);
        --shadow-popover: 0 24px 48px -12px rgba(0, 0, 0, 0.6);
        --shadow-modal: 0 24px 48px -12px rgba(0, 0, 0, 0.6);

        --focus-ring: 0 0 0 2px #070b18, 0 0 0 4px #8ab4ff;
        --transition-fast: 160ms;
        --transition-normal: 220ms;

        /* 吸顶 header 的高度；SiteStage 据此向上延伸到 header 下面。 */
        --header-height: 68px;
      }

      * {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
      }

      html {
        scroll-behavior: smooth;
      }

      body {
        min-height: 100vh;
        font-family: var(--font-sans);
        font-size: 16px;
        line-height: 1.6;
        color: var(--gray-1000);
        background: var(--background-100);
        -webkit-font-smoothing: antialiased;
        -moz-osx-font-smoothing: grayscale;
      }

      a {
        color: inherit;
        text-decoration: none;
        transition: color var(--transition-fast), background-color var(--transition-fast), border-color var(--transition-fast);
      }

      button {
        font-family: inherit;
        border: none;
        background: none;
        color: inherit;
        cursor: pointer;
      }

      [hidden] {
        display: none !important;
      }

      img,
      svg {
        display: block;
      }

      h1,
      h2,
      h3,
      h4 {
        font-family: var(--font-sans);
        color: var(--gray-1000);
      }

      /* 全站焦点环：特异性 0,4,0，组件覆盖规则见 spec-website §4；tabindex="-1"（脚本聚焦）不显示。 */
      :root :is(a, button, input, select, textarea, summary, [tabindex]:not([tabindex="-1"])):focus-visible {
        outline: none;
        box-shadow: var(--focus-ring);
      }

      /* 全站按钮：主按钮是品牌蓝渐变加光晕，次按钮是玻璃面，全站只有这两种。 */
      .btn-primary,
      .btn-secondary {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        height: 40px;
        padding: 0 14px;
        border: 1px solid transparent;
        border-radius: 10px;
        font-size: 14px;
        font-weight: 600;
        line-height: 20px;
        white-space: nowrap;
        transition: color var(--transition-fast), background-color var(--transition-fast), border-color var(--transition-fast), filter var(--transition-fast);
      }

      .btn-primary {
        color: var(--on-brand);
        background: var(--gradient-button);
        box-shadow: var(--shadow-glow);
      }

      .btn-primary:hover {
        filter: brightness(1.1);
      }

      .btn-secondary {
        color: var(--gray-1000);
        background: var(--glass-bg);
        border-color: rgba(255, 255, 255, 0.16);
      }

      .btn-secondary:hover {
        background: var(--gray-alpha-400);
        border-color: var(--gray-alpha-600);
      }

      .btn-primary:disabled,
      .btn-secondary:disabled {
        color: var(--gray-700);
        background: var(--gray-100);
        border-color: var(--gray-alpha-400);
        box-shadow: none;
        filter: none;
        cursor: not-allowed;
      }

      .btn-primary-icon {
        width: 18px;
        height: 18px;
        flex: 0 0 18px;
      }

      /* Chrome 图标的小白底板（纯白白名单之一）：彩色图标在渐变蓝按钮上看不清，包一层白底方圆角。 */
      .btn-chrome-plate {
        display: inline-flex;
        flex: 0 0 22px;
        align-items: center;
        justify-content: center;
        width: 22px;
        height: 22px;
        border-radius: 6px;
        background: #fff;
      }

      .btn-chrome-plate img {
        display: block;
      }

      /* 全站链接：用 --blue-700；选中态、目录当前项也用同一个蓝，不是链接专属。 */
      .text-link {
        color: var(--blue-700);
        text-decoration: underline;
        text-underline-offset: 3px;
      }

      .text-link:hover {
        color: var(--blue-800);
      }

      .container,
      .nav,
      .footer-content {
        width: min(1200px, calc(100vw - 32px));
        margin: 0 auto;
      }

      /* header / 菜单 / 页脚共用的分隔线色，只在 Layout 内使用，不进全局 token 表。 */
      .header,
      .footer {
        --divider: rgba(255, 255, 255, 0.08);
      }

      .header {
        position: sticky;
        top: 0;
        z-index: 100;
        background: rgba(7, 11, 24, 0.78);
        -webkit-backdrop-filter: saturate(160%) blur(14px);
        backdrop-filter: saturate(160%) blur(14px);
        border-bottom: 1px solid var(--divider);
      }

      .nav {
        height: calc(var(--header-height) - 1px);
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
      }

      .logo {
        display: flex;
        align-items: center;
        gap: 10px;
        min-width: 0;
        color: var(--gray-1000);
      }

      .logo span {
        overflow: hidden;
        font-size: 16px;
        font-weight: 650;
        letter-spacing: -0.16px;
        text-overflow: ellipsis;
        white-space: nowrap;
      }

      .logo img {
        width: 32px;
        height: 32px;
        flex: 0 0 32px;
        border-radius: 8px;
      }

      .nav-links {
        display: flex;
        align-items: center;
        gap: 4px;
        margin-right: auto;
        margin-left: 24px;
      }

      .nav-links a {
        padding: 8px 12px;
        border-radius: 8px;
        color: var(--gray-900);
        font-size: 14px;
        font-weight: 500;
        line-height: 20px;
      }

      .nav-links a:hover,
      .nav-links a.active {
        color: var(--gray-1000);
        background: var(--glass-bg);
      }

      .nav-actions {
        display: flex;
        align-items: center;
        flex: 0 0 auto;
        gap: 8px;
      }

      .nav-install-link {
        padding: 0 14px 0 10px;
      }

      /* Chrome 图标的小白底板：彩色图标在品牌蓝按钮上需要白底才看得清。 */
      .nav-install-icon {
        width: 20px;
        height: 20px;
        flex: 0 0 20px;
        padding: 1px;
        border-radius: 50%;
        background: #fff;
      }

      .lang-switcher {
        position: relative;
      }

      .lang-btn {
        display: flex;
        align-items: center;
        gap: 6px;
        height: 44px;
        max-width: 160px;
        padding: 0 10px;
        border-radius: 10px;
        color: var(--gray-900);
        font-size: 14px;
        font-weight: 500;
        white-space: nowrap;
      }

      .lang-btn:hover {
        background: var(--glass-bg);
        color: var(--gray-1000);
      }

      .lang-btn-globe {
        flex: 0 0 auto;
      }

      .lang-dropdown {
        position: absolute;
        top: calc(100% + 8px);
        right: 0;
        min-width: 160px;
        padding: 4px;
        background: var(--gray-100);
        border: 1px solid var(--gray-alpha-400);
        border-radius: var(--radius-md);
        box-shadow: var(--shadow-popover);
        opacity: 0;
        visibility: hidden;
        transform: translateY(-4px);
        transition: opacity var(--transition-fast), transform var(--transition-fast), visibility var(--transition-fast);
      }

      .lang-dropdown.show {
        opacity: 1;
        visibility: visible;
        transform: translateY(0);
      }

      .lang-dropdown .lang-option {
        display: block;
        width: 100%;
        padding: 10px 12px;
        border-radius: 8px;
        text-align: left;
        font-size: 14px;
        color: var(--gray-900);
      }

      .lang-dropdown .lang-option:hover,
      .lang-dropdown .lang-option.current {
        background: var(--glass-bg);
        color: var(--gray-1000);
      }

      .mobile-menu-btn {
        display: none;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 5px;
        width: 44px;
        height: 44px;
        border-radius: 10px;
        color: var(--gray-1000);
      }

      .mobile-menu-btn:hover {
        background: var(--glass-bg);
      }

      .hamburger {
        display: block;
        width: 18px;
        height: 2px;
        background: currentColor;
        border-radius: 1px;
        transition: transform var(--transition-fast), opacity var(--transition-fast);
      }

      .mobile-nav {
        position: absolute;
        top: 100%;
        left: 0;
        right: 0;
        background: var(--background-100);
        border-bottom: 1px solid var(--divider);
        box-shadow: 0 24px 48px -24px rgba(0, 0, 0, 0.8);
        max-height: 0;
        overflow: hidden;
        visibility: hidden;
        transition: max-height var(--transition-normal) ease-out, visibility var(--transition-normal);
      }

      .mobile-nav.open {
        max-height: 360px;
        visibility: visible;
      }

      .mobile-nav-inner {
        display: flex;
        flex-direction: column;
        width: min(1200px, calc(100vw - 32px));
        margin: 0 auto;
        padding: 8px 0 16px;
      }

      .mobile-nav a:not(.btn-primary) {
        position: relative;
        display: flex;
        align-items: center;
        min-height: 52px;
        padding: 0 14px;
        font-size: 16px;
        font-weight: 500;
        color: var(--gray-900);
      }

      .mobile-nav a:not(.btn-primary) + a:not(.btn-primary) {
        border-top: 1px solid var(--divider);
      }

      .mobile-nav a:not(.btn-primary):hover,
      .mobile-nav a.active {
        color: var(--gray-1000);
      }

      .mobile-nav a.active {
        font-weight: 600;
      }

      /* 当前项左侧的发光竖条。 */
      .mobile-nav a.active::before {
        content: '';
        position: absolute;
        left: 0;
        top: 14px;
        bottom: 14px;
        width: 2px;
        border-radius: 2px;
        background: var(--blue-700);
        box-shadow: 0 0 10px rgba(138, 180, 255, 0.8);
      }

      .mobile-nav-install {
        width: 100%;
        height: 48px;
        margin-top: 16px;
        border-radius: var(--radius-md);
        font-size: 15px;
      }

      .header.menu-open .mobile-menu-btn .hamburger:nth-child(1) {
        transform: translateY(7px) rotate(45deg);
      }

      .header.menu-open .mobile-menu-btn .hamburger:nth-child(2) {
        opacity: 0;
      }

      .header.menu-open .mobile-menu-btn .hamburger:nth-child(3) {
        transform: translateY(-7px) rotate(-45deg);
      }

      .page-hero h1 {
        font-size: clamp(3rem, 7vw, 5rem);
        line-height: 0.95;
        letter-spacing: -0.06em;
      }

      .footer {
        margin-top: 80px;
        border-top: 1px solid var(--divider);
        background: #05080f;
      }

      .footer-content {
        padding-top: 56px;
        padding-bottom: 32px;
      }

      .footer-main {
        display: flex;
        flex-wrap: wrap;
        gap: 40px 64px;
      }

      .footer-brand {
        flex: 1 1 280px;
        min-width: 0;
      }

      .footer-brand-link {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        color: var(--gray-1000);
        font-size: 16px;
        font-weight: 650;
      }

      .footer-brand-icon {
        position: relative;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 28px;
        height: 28px;
        flex: 0 0 28px;
        background: url('/favicon.png') center / contain no-repeat;
        border-radius: 7px;
      }

      /* 挂载点里的透明 SVG 由 device.ts 注入，叠在 favicon 底图上，不能隐藏或懒加载。 */
      .footer-brand-icon img {
        position: absolute;
        inset: 0;
        width: 28px;
        height: 28px;
        flex: 0 0 28px;
      }

      .footer-link-groups {
        display: grid;
        grid-template-columns: repeat(2, 160px);
        gap: 40px 64px;
        text-align: left;
      }

      .footer-link-group {
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        gap: 10px;
        min-width: 0;
      }

      .footer-link-title {
        margin-bottom: 6px;
        color: var(--gray-1000);
        font-size: 13px;
        font-weight: 600;
        line-height: 20px;
      }

      .footer-meta {
        margin-top: 48px;
        padding-top: 24px;
        border-top: 1px solid var(--divider);
      }

      .footer-meta p {
        color: var(--gray-700);
        font-size: 13px;
      }

      .footer-meta p + p {
        margin-top: 4px;
      }

      .footer-link-group a {
        max-width: 100%;
        color: var(--gray-900);
        font-size: 14px;
        line-height: 20px;
        overflow-wrap: anywhere;
      }

      .footer-link-group a:hover {
        color: var(--gray-1000);
        text-decoration: underline;
        text-underline-offset: 3px;
      }

      @media (max-width: 960px) {
        .nav-links,
        .nav-actions > .nav-install-link {
          display: none;
        }

        .lang-btn {
          max-width: 128px;
        }

        .lang-btn-label {
          overflow: hidden;
          text-overflow: ellipsis;
        }

        .mobile-menu-btn {
          display: flex;
        }

        .footer-link-groups {
          flex: 1 1 100%;
          grid-template-columns: repeat(2, minmax(0, 1fr));
          gap: 32px 12px;
        }
      }

      @media (max-width: 600px) {
        :root {
          --header-height: 60px;
        }

        .nav {
          width: 100%;
          padding: 0 8px 0 16px;
          gap: 12px;
        }

        .nav-actions {
          gap: 4px;
        }

        .logo {
          gap: 8px;
          min-height: 44px;
        }

        .logo img {
          width: 28px;
          height: 28px;
          flex-basis: 28px;
          border-radius: 7px;
        }

        .logo span {
          font-size: 15px;
        }

        /* 只留地球图标；语言名用视觉隐藏保留为可访问名称。 */
        .lang-btn {
          justify-content: center;
          width: 44px;
          padding: 0;
        }

        .lang-btn-label,
        .lang-btn-chevron {
          position: absolute;
          width: 1px;
          height: 1px;
          overflow: hidden;
          clip-path: inset(50%);
          white-space: nowrap;
        }

        .lang-btn-globe {
          width: 20px;
          height: 20px;
        }

        .footer {
          margin-top: 64px;
        }

        .footer-content {
          padding-top: 40px;
          padding-bottom: 24px;
        }

        .footer-main {
          gap: 28px 12px;
        }

        .footer-brand {
          flex-basis: 100%;
        }

        .footer-brand-link {
          min-height: 44px;
        }

        .footer-link-group {
          gap: 0;
        }

        .footer-link-group a {
          display: flex;
          align-items: center;
          min-height: 44px;
          font-size: 15px;
        }

        .footer-meta {
          margin-top: 28px;
          padding-top: 20px;
        }

        .footer-meta p {
          line-height: 1.5;
        }
      }
    </style>

  </head>
  <body>
    {!standalone && <header class="header">
      <nav class="nav">
        <a href={currentLocalePath} class="logo">
          <img src="/favicon.png" width="40" height="40" alt="" />
          <span>{t.layout.nav.brand}</span>
        </a>

        <!-- Desktop Navigation -->
        <div class="nav-links">
          <a
            href={currentLocalePath}
            class={isHomeActive ? 'active' : ''}
            aria-current={isHomeActive ? 'page' : undefined}
          >
            {t.layout.nav.home}
          </a>
        </div>

        <div class="nav-actions">
          <a
            href={chromeWebStoreUrl}
            target="_blank"
            rel="noopener"
            class="btn-primary nav-install-link"
            aria-label={t.common.installCta}
            data-ga-event="outbound_chrome_store_click"
            data-ga-source="nav"
          >
            <img
              src="/googe-ext-logo-192px.svg"
              width="192"
              height="192"
              alt=""
              class="nav-install-icon"
              fetchpriority={isHomeActive ? 'high' : undefined}
            />
            <span>{t.common.installCta}</span>
          </a>

          {showLanguageSwitcher && (
            <div class="lang-switcher">
              <button class="lang-btn">
                <svg class="lang-btn-globe" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <circle cx="12" cy="12" r="9" />
                  <path d="M3 12h18" />
                  <path d="M12 3a14 14 0 0 1 0 18a14 14 0 0 1 0-18z" />
                </svg>
                <span class="lang-btn-label">{localeNames[locale]}</span>
                <svg class="lang-btn-chevron" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M6 9l6 6 6-6" />
                </svg>
              </button>
              <div class="lang-dropdown">
                {languageOptionLinks.map(link => (
                  <button
                    data-locale={link.locale}
                    data-path={link.path}
                    data-ga-event="language_switch"
                    data-ga-locale={link.locale}
                    data-ga-from={locale}
                    class={`lang-option ${link.locale === locale ? 'current' : ''}`}
                  >
                    {localeNames[link.locale]}
                  </button>
                ))}
              </div>
            </div>
          )}

          <!-- Mobile Menu Button -->
          <button class="mobile-menu-btn" aria-label="Toggle menu" aria-expanded="false">
            <span class="hamburger"></span>
            <span class="hamburger"></span>
            <span class="hamburger"></span>
          </button>
        </div>
      </nav>

      <!-- Mobile Navigation Menu -->
      <div class="mobile-nav">
        <div class="mobile-nav-inner">
          <a
            href={currentLocalePath}
            class={isHomeActive ? 'active' : ''}
            aria-current={isHomeActive ? 'page' : undefined}
          >
            {t.layout.nav.home}
          </a>
          <a
            href={chromeWebStoreUrl}
            target="_blank"
            rel="noopener"
            class="btn-primary mobile-nav-install"
            data-ga-event="outbound_chrome_store_click"
            data-ga-source="mobile_nav"
          >
            <img src="/googe-ext-logo-192px.svg" width="192" height="192" alt="" class="nav-install-icon" loading="lazy" />
            <span>{t.common.installCta}</span>
          </a>
        </div>
      </div>
    </header>}

    <main class="main">
      <slot />
    </main>

    {!standalone && <footer class="footer">
      <div class="footer-content">
        <div class="footer-main">
          <div class="footer-brand">
            <a href={currentLocalePath} class="footer-brand-link">
              <span class="footer-brand-icon" data-footer-brand-icon></span>
              <span>{t.layout.nav.brand}</span>
            </a>
          </div>
          <nav
            class="footer-link-groups"
            aria-label={`${companyContent.footerGroupLabel} / ${t.layout.footer.resources}`}
          >
            <div class="footer-link-group">
              <p class="footer-link-title">{companyContent.footerGroupLabel}</p>
              <a
                href={aboutPath}
                data-ga-event="internal_workflow_click"
                data-ga-source="footer"
                data-ga-target="about"
              >
                {companyContent.about.navLabel}
              </a>
              <a
                href={contactPath}
                data-ga-event="internal_workflow_click"
                data-ga-source="footer"
                data-ga-target="contact"
              >
                {companyContent.contact.navLabel}
              </a>
            </div>
            <div class="footer-link-group" data-footer-resources>
              <p class="footer-link-title">{t.layout.footer.resources}</p>
              {guidesPath && (
                <a
                  href={guidesPath}
                  data-ga-event="internal_workflow_click"
                  data-ga-source="footer"
                  data-ga-target="guides"
                >
                  {guidesContent.sectionLabel}
                </a>
              )}
              <a
                href={termsPath}
                data-ga-event="internal_workflow_click"
                data-ga-source="footer"
                data-ga-target="terms"
              >
                {companyContent.termsLabel}
              </a>
              <a
                href={privacyPath}
                data-ga-event="internal_workflow_click"
                data-ga-source="footer"
                data-ga-target="privacy"
              >
                {companyContent.privacyLabel}
              </a>
            </div>
          </nav>
        </div>
        <div class="footer-meta">
          <p>{t.layout.footer.rights}</p>
          <p>{companyContent.operatorStatement}</p>
        </div>
      </div>
    </footer>}

    <SiteConfirmModal />

    <script>
      import { installFrontendErrorCapture } from '../scripts/runtime/frontend-error-capture'
      import { initializeFooterBrandIcon } from '../scripts/runtime/device'
      import { initializeWebsiteFirstOpenedMark } from '../scripts/runtime/first-opened-mark'
      import '../scripts/globalClickEvents'

      void initializeFooterBrandIcon()
      initializeWebsiteFirstOpenedMark()

      installFrontendErrorCapture(capturedError => {
        void import('../scripts/runtime/sls-mark')
          .then(({ reportFrontendCapturedErrorToSls }) => {
            reportFrontendCapturedErrorToSls(capturedError)
          })
          .catch(error => {
            console.error(
              new Error('[layout] Failed to load the frontend error reporter.', { cause: error })
            )
          })
      })

    </script>

    <script>
      import { initializeLanguageSwitcher } from '../scripts/site/language-switcher'

      initializeLanguageSwitcher()

      // Mobile menu toggle
      const mobileMenuBtn = document.querySelector('.mobile-menu-btn');
      const mobileNav = document.querySelector('.mobile-nav');
      const header = document.querySelector('.header');

      mobileMenuBtn?.addEventListener('click', () => {
        const isOpen = mobileNav?.classList.toggle('open');
        mobileMenuBtn?.setAttribute('aria-expanded', String(isOpen));
        header?.classList.toggle('menu-open', isOpen);
      });

      // Close mobile menu when clicking outside
      document.addEventListener('click', (e) => {
        if (mobileNav?.classList.contains('open')) {
          const target = e.target as HTMLElement;
          if (!target.closest('.mobile-nav') && !target.closest('.mobile-menu-btn')) {
            mobileNav.classList.remove('open');
            mobileMenuBtn?.setAttribute('aria-expanded', 'false');
            header?.classList.remove('menu-open');
          }
        }
      });

      // Close mobile menu when clicking on a link
      const mobileNavLinks = document.querySelectorAll('.mobile-nav a');
      mobileNavLinks.forEach(link => {
        link.addEventListener('click', () => {
          mobileNav?.classList.remove('open');
          mobileMenuBtn?.setAttribute('aria-expanded', 'false');
          header?.classList.remove('menu-open');
        });
      });
    </script>
  </body>
</html>
