---
/** ClinkBill Hosted Checkout 成功/取消结果页。 */
import { paymentReturnContent } from '../../i18n/payment-return'
interface Props {
  /** 支付结果。 */
  status: 'success' | 'cancel'
  /** success 页的等待、确认与失败文案。 */
  successCopy: {
    waiting: { title: string; description: string }
    confirmed: { title: string; description: string }
    failed: { title: string; description: string }
  }
  /** cancel 页文案。 */
  cancelCopy: { title: string; description: string }
}

const { status, successCopy, cancelCopy } = Astro.props
const copy = status === 'success' ? successCopy.waiting : cancelCopy
---

<section
  class="clink-return-page"
  data-payment-return
  data-payment-return-status={status}
  data-payment-return-state={status === 'success' ? 'waiting' : 'cancelled'}
>
  <span
    data-payment-return-copy="waiting"
    data-title={successCopy.waiting.title}
    data-description={successCopy.waiting.description}
    hidden
  ></span>
  <span
    data-payment-return-copy="confirmed"
    data-title={successCopy.confirmed.title}
    data-description={successCopy.confirmed.description}
    hidden
  ></span>
  <span
    data-payment-return-copy="failed"
    data-title={successCopy.failed.title}
    data-description={successCopy.failed.description}
    hidden
  ></span>
  <section class="clink-return-card" aria-live="polite">
    <img src="/payment-icons/clinkbill.png" alt="" aria-hidden="true" width="32" height="32" />
    <p class="clink-return-eyebrow">Clink</p>
    <h1 data-payment-return-title>{copy.title}</h1>
    <p data-payment-return-description>{copy.description}</p>
    <a class="btn-primary clink-return-pricing" href="/pricing/" data-subscription-href="/ext-pricing/">{paymentReturnContent.backToPricing}</a>
  </section>
</section>

<script>
  import { initPaymentReturnPage } from '@website-shared/components/credit-purchase/paypal-return'

  const root = document.querySelector<HTMLElement>('[data-payment-return]')
  const status = root?.dataset.paymentReturnStatus
  if (status === 'success' || status === 'cancel') {
    initPaymentReturnPage({ provider: 'clink', status, orderNo: null })
  } else {
    console.error(
      new Error(`clink return page: invalid or missing status=${String(status)}`)
    )
  }
</script>

<style>
  .clink-return-page {
    display: grid;
    min-height: 68vh;
    place-items: center;
    padding: 120px 24px 72px;
    background: var(--color-gray-50);
  }

  .clink-return-card {
    width: min(620px, 100%);
    padding: 34px;
    border: 1px solid rgba(15, 23, 42, 0.08);
    border-radius: 28px;
    background: rgba(255, 255, 255, 0.92);
    box-shadow: 0 28px 70px rgba(15, 23, 42, 0.12);
    text-align: center;
  }

  [data-payment-return-copy][hidden] {
    display: none;
  }

  [data-payment-return-state='confirmed'] .clink-return-card {
    border-color: #86efac;
  }

  [data-payment-return-state='failed'] .clink-return-card {
    border-color: var(--color-error);
  }

  .clink-return-card img {
    display: block;
    margin: 0 auto 10px;
  }

  .clink-return-eyebrow {
    margin: 0 0 12px;
    color: #d85f54;
    font-size: 13px;
    font-weight: 900;
    letter-spacing: 0;
  }

  .clink-return-card h1 {
    margin: 0;
    color: var(--color-gray-900);
    font-size: 40px;
    letter-spacing: 0;
  }

  [data-payment-return-description] {
    margin: 16px 0 0;
    color: var(--color-gray-600);
    font-size: 17px;
    font-weight: 700;
    line-height: 1.6;
  }

  .clink-return-pricing {
    margin-top: 24px;
  }

  @media (max-width: 560px) {
    .clink-return-card {
      padding: 28px 20px;
    }

    .clink-return-card h1 {
      font-size: 32px;
    }
  }
</style>
