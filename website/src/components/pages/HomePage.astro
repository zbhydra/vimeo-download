---
/**
 * 首页：工具首屏 + 8 个静态展示区块。
 *
 * 区块顺序：Hero（下载工作区 + Trust Points）→ 插件介绍 → 功能 → 使用步骤
 * → 网页版与插件对比 → 适用范围与边界 → 方案概览 → FAQ → 结尾 CTA。
 *
 * 关键约定：
 * - 页面唯一 H1 = 下载工作区的解析工具标题（workspace.parse.title），区块标题各为一个 H2。
 * - 展示区块纯静态、不带客户端脚本；只有下载工作区运行前端状态机。
 * - FAQPage JSON-LD 经 Layout 的 structuredData prop 注入，内容与可见 FAQ 同源。
 */
import Layout from '../../layouts/Layout.astro'
import HomeIntroSection from '../homepage/HomeIntroSection.astro'
import HomeFeaturesSection from '../homepage/HomeFeaturesSection.astro'
import HomeStepsSection from '../homepage/HomeStepsSection.astro'
import HomeComparisonSection from '../homepage/HomeComparisonSection.astro'
import HomeScopeSection from '../homepage/HomeScopeSection.astro'
import HomePlansSection from '../homepage/HomePlansSection.astro'
import HomeFaqSection from '../homepage/HomeFaqSection.astro'
import HomeFinalCtaSection from '../homepage/HomeFinalCtaSection.astro'
import DownloadWorkspace from '../download/DownloadWorkspace.astro'
import { CHROME_WEB_STORE_URL } from '../../lib/site.mjs'
import { getContent, type Locale } from '../../i18n/content'
import { localePaths } from '../../i18n/ui'

interface Props {
  locale?: Locale
}

const installUrl = CHROME_WEB_STORE_URL

const { locale = 'en-US' } = Astro.props as Props
const homepage = getContent(locale).pages.homepage
const { title, description } = homepage.meta
const localePath = localePaths[locale] || ''
const pricingPath = `${localePath === '' ? '/' : `/${localePath}/`}pricing/`

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: homepage.faq.items.map(item => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: item.answer
    }
  }))
}
---

<Layout
  locale={locale}
  title={title}
  description={description}
  structuredData={[faqSchema]}
>
  <section class="hero-tool">
    <div class="container">
      <DownloadWorkspace
        copy={homepage.workspace}
        installUrl={installUrl}
        showLargeFileExtensionGuideByDefault
        deferRuntime
      />
      <ul class="hero-trust-points">
        {homepage.heroTrustPoints.map(point => (
          <li class="hero-trust-point">
            <svg class="hero-trust-check" viewBox="0 0 20 20" aria-hidden="true">
              <path d="M5 10.5l3.2 3.2L15 7" />
            </svg>
            <span>{point}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <HomeIntroSection copy={homepage.intro} installUrl={installUrl} pricingPath={pricingPath} />
  <HomeFeaturesSection copy={homepage.features} />
  <HomeStepsSection copy={homepage.steps} />
  <HomeComparisonSection copy={homepage.comparison} />
  <HomeScopeSection copy={homepage.scope} />
  <HomePlansSection copy={homepage.plans} pricingPath={pricingPath} />
  <HomeFaqSection copy={homepage.faq} />
  <HomeFinalCtaSection copy={homepage.finalCta} installUrl={installUrl} />
</Layout>

<style>
  .hero-tool {
    padding: 40px 0 32px;
  }

  .hero-trust-points {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 24px;
    margin-top: 16px;
    list-style: none;
  }

  .hero-trust-point {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: var(--gray-900);
    font-size: 14px;
    line-height: 20px;
  }

  .hero-trust-check {
    flex-shrink: 0;
    width: 16px;
    height: 16px;
    fill: none;
    stroke: var(--gray-1000);
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  @media (max-width: 960px) {
    .hero-tool {
      padding: 24px 0;
    }
  }
</style>
