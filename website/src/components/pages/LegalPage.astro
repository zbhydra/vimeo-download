---
/**
 * Legal document page.
 *
 * Render flow:
 * route -> legal content fallback -> SiteBandHeader + TOC/article body -> Layout SEO/schema.
 *
 * 索引规则：只有该语言自己有审校过的法务译本时，页面才可索引、才参与 hreflang。
 * 渲染英文回退稿的语言路由保留（站内导航不断），但设为 noindex、不输出 hreflang，
 * 正文标注真实语言 en-US；否则 13 个语言 URL 会成为同一份英文的重复页。sitemap 读页面的 robots 声明自动排除这些页。
 *
 * 目录在 DOM 里先于正文：桌面是左栏，手机是正文上方的横向胶囊行，Tab 顺序与视觉一致（不用 CSS order）。
 */
import Layout from '../../layouts/Layout.astro'
import SiteBandHeader from '../site/SiteBandHeader.astro'
import {
  getLegalContentLocale,
  getLegalPageContent,
  LEGAL_CONTENT_LOCALES,
  type LegalPageKind
} from '../../legal/legalContent'
import { type Locale } from '../../i18n/content'

interface Props {
  /** Current locale route. */
  locale?: Locale
  /** Which legal page to render. */
  pageKind: LegalPageKind
}

/** A paragraph split into plain text, bold runs, and links. */
interface InlineNode {
  text: string
  bold?: boolean
  href?: string
}

const INLINE_TOKEN_PATTERN = /\*\*([^*]+)\*\*|\[([^\]]+)\]\(([^)\s]+)\)/g
const PARAGRAPH_BREAK_PATTERN = /\n{2,}/
const HTML_ESCAPES: Record<string, string> = {
  '&': '&amp;',
  '<': '&lt;',
  '>': '&gt;',
  '"': '&quot;'
}

const escapeHtml = (value: string) => value.replace(/[&<>"]/g, character => HTML_ESCAPES[character])

/**
 * Splits `**bold**` and `[label](href)` markup into nodes.
 *
 * Legal copy is authored as plain strings that mirror its Markdown source, so
 * both markers are resolved here rather than baked into every locale file.
 */
const toInlineNodes = (value: string): InlineNode[] => {
  const nodes: InlineNode[] = []
  let cursor = 0

  for (const match of value.matchAll(INLINE_TOKEN_PATTERN)) {
    const index = match.index ?? 0
    if (index > cursor) {
      nodes.push({ text: value.slice(cursor, index) })
    }

    if (match[1] !== undefined) {
      nodes.push({ text: match[1], bold: true })
    } else {
      nodes.push({ text: match[2], href: match[3] })
    }

    cursor = index + match[0].length
  }

  if (cursor < value.length) {
    nodes.push({ text: value.slice(cursor) })
  }

  return nodes
}

/** Renders inline markup to escaped HTML for `set:html`. */
const renderInlineHtml = (value: string) =>
  toInlineNodes(value)
    .map(node => {
      const text = escapeHtml(node.text)
      if (node.href !== undefined) {
        return `<a href="${escapeHtml(node.href)}">${text}</a>`
      }

      return node.bold ? `<strong>${text}</strong>` : text
    })
    .join('')

const { locale = 'en-US', pageKind } = Astro.props as Props
const page = getLegalPageContent(locale, pageKind)
const contentLocale = getLegalContentLocale(locale)
const isFallback = contentLocale !== locale
const introParagraphs = page.intro.split(PARAGRAPH_BREAK_PATTERN)
const toSectionId = (title: string) => title.toLowerCase().replaceAll(' ', '-')
const normalizePathname = (pathname: string) => {
  if (pathname === '' || pathname === '/') {
    return '/'
  }

  return pathname.endsWith('/') ? pathname : `${pathname}/`
}
const pageUrl = new URL(normalizePathname(Astro.url.pathname), Astro.site).href
const legalSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  url: pageUrl,
  name: page.title,
  description: page.seoDescription,
  publisher: {
    '@id': new URL('/#organization', Astro.site).href
  }
}
const structuredDataItems = page.updatedAtIso
  ? [{ ...legalSchema, dateModified: page.updatedAtIso }]
  : [legalSchema]
---

<Layout
  locale={locale}
  title={page.seoTitle}
  description={page.seoDescription}
  includeSoftwareApplicationSchema={false}
  structuredData={structuredDataItems}
  robots={isFallback ? 'noindex, follow' : undefined}
  alternateLocales={isFallback ? [] : LEGAL_CONTENT_LOCALES}
>
  <article
    class="legal-page"
    data-legal-page
    data-legal-page-kind={pageKind}
    lang={isFallback ? contentLocale : undefined}
  >
    <SiteBandHeader
      title={page.title}
      updatedLabel={page.updatedLabel}
      updatedAt={page.updatedAt}
      updatedAtIso={page.updatedAtIso}
      updatedColon
    >
      {introParagraphs.map(paragraph => <p class="site-band-intro" set:html={renderInlineHtml(paragraph)} />)}
    </SiteBandHeader>

    <div class="container legal-layout">
      <nav class="legal-toc" aria-label={page.navLabel}>
        {page.sections.map(section => (
          <a href={`#${toSectionId(section.title)}`}>{section.title}</a>
        ))}
      </nav>

      <div class="legal-content">
        {page.sections.map(section => (
          <section class="legal-section" id={toSectionId(section.title)}>
            <h2>{section.title}</h2>
            {section.blocks.map(block => block.kind === 'paragraph' ? (
              <p set:html={renderInlineHtml(block.text)} />
            ) : (
              <ul>
                {block.items.map(item => <li set:html={renderInlineHtml(item)} />)}
              </ul>
            ))}
          </section>
        ))}
      </div>
    </div>
  </article>
</Layout>

<script>
  /**
   * 目录当前项：给「正在阅读的章节」对应的目录链接设置 aria-current="location"。
   *
   * 判定：滚动时取最后一个顶边已越过 scroll-margin-top 的章节（都没越过时取第一个）；
   * 滚到页面底部时取最后一个，否则短的末尾章节永远越不过阈值。
   *
   * 点击目录链接立即切换，并记下这次点击的落点（目标顶边减 scroll-margin，夹到最大可滚动距离内）。
   * 平滑滚动途中、以及停在落点后，当前项保持在被点的链接上：靠近页尾的短章节滚不到阈值，
   * 不钉住会被滚动判定覆盖回前一项。钉住的解除只看滚动位置，不看输入方式：
   * 滚动位置到落点的距离一旦比上次变大（离开落点或越过落点），就恢复正常判定，
   * 因此滚轮、触摸、键盘、拖滚动条、页内查找、前进后退都一样生效，不依赖枚举输入事件，也不依赖 scrollend。
   *
   * 渐进增强：没有 JS 时目录只是普通锚点链接。无动画、无持久状态，也不滚动胶囊行。
   */
  const toc = document.querySelector<HTMLElement>('.legal-toc')
  const links = toc ? Array.from(toc.querySelectorAll<HTMLAnchorElement>('a[href^="#"]')) : []
  const entries = links.flatMap(link => {
    const section = document.getElementById(decodeURIComponent(link.hash.slice(1)))
    return section ? [{ link, section }] : []
  })

  /** 判定滚动位置"变远"的容差，吸收亚像素抖动。 */
  const DISTANCE_TOLERANCE = 1

  if (entries.length > 0) {
    /** 点击钉住：被点链接、落点 scrollY、最近一次到落点的距离。 */
    let pin: { link: HTMLAnchorElement; target: number; distance: number } | null = null
    let frame = 0

    const scrollMarginOf = (section: HTMLElement) => parseFloat(getComputedStyle(section).scrollMarginTop)

    const setCurrent = (current: HTMLAnchorElement) => {
      for (const { link } of entries) {
        if (link === current) {
          link.setAttribute('aria-current', 'location')
        } else {
          link.removeAttribute('aria-current')
        }
      }
    }

    const update = () => {
      frame = 0
      if (pin) {
        const distance = Math.abs(window.scrollY - pin.target)
        if (distance <= pin.distance + DISTANCE_TOLERANCE) {
          pin.distance = Math.min(pin.distance, distance)
          setCurrent(pin.link)
          return
        }
        pin = null
      }
      const atBottom = window.innerHeight + window.scrollY >= document.documentElement.scrollHeight - 2
      let current = entries[0]
      if (atBottom) {
        current = entries[entries.length - 1]
      } else {
        for (const entry of entries) {
          if (entry.section.getBoundingClientRect().top <= scrollMarginOf(entry.section) + 2) {
            current = entry
          }
        }
      }
      setCurrent(current.link)
    }

    const schedule = () => {
      if (frame === 0) {
        frame = requestAnimationFrame(update)
      }
    }

    toc?.addEventListener('click', event => {
      const link = (event.target as Element).closest<HTMLAnchorElement>('a')
      const entry = entries.find(item => item.link === link)
      if (!entry) {
        return
      }
      const maxScroll = document.documentElement.scrollHeight - window.innerHeight
      const target = Math.min(
        Math.max(window.scrollY + entry.section.getBoundingClientRect().top - scrollMarginOf(entry.section), 0),
        maxScroll
      )
      pin = { link: entry.link, target, distance: Math.abs(window.scrollY - target) }
      setCurrent(entry.link)
    })
    window.addEventListener('scroll', schedule, { passive: true })
    window.addEventListener('resize', schedule)
    update()
  }
</script>

<style>
  .legal-layout {
    display: grid;
    grid-template-columns: 260px minmax(0, 760px);
    gap: 64px;
    align-items: start;
    padding-top: 56px;
    padding-bottom: 120px;
  }

  .legal-toc {
    position: sticky;
    top: calc(var(--header-height) + 24px);
    display: flex;
    flex-direction: column;
    gap: 2px;
    border-left: 1px solid var(--gray-alpha-400);
  }

  .legal-page .legal-toc a {
    margin-left: -1px;
    padding: 8px 14px;
    border-left: 2px solid transparent;
    color: var(--gray-900);
    font-size: 14px;
    line-height: 20px;
    text-decoration: none;
  }

  .legal-page .legal-toc a:hover {
    color: var(--gray-1000);
  }

  /* 当前项样式：aria-current 由本文件的 <script> 按滚动位置维护。 */
  .legal-page .legal-toc a[aria-current] {
    border-left-color: var(--blue-700);
    background: var(--blue-100);
    color: var(--blue-700);
    font-weight: 600;
  }

  .legal-content {
    min-width: 0;
  }

  .legal-section {
    padding: 36px 0;
    border-bottom: 1px solid var(--gray-alpha-100);
    scroll-margin-top: calc(var(--header-height) + 24px);
  }

  .legal-section:first-child {
    padding-top: 0;
  }

  .legal-section:last-child {
    padding-bottom: 0;
    border-bottom: 0;
  }

  .legal-section h2 {
    color: var(--gray-1000);
    font-size: 24px;
    font-weight: 650;
    line-height: 1.25;
    letter-spacing: -0.02em;
  }

  .legal-section p,
  .legal-section li {
    color: var(--gray-900);
    font-size: 16px;
    line-height: 1.75;
  }

  .legal-section p {
    margin-top: 16px;
  }

  .legal-section p + p {
    margin-top: 14px;
  }

  .legal-section ul {
    display: grid;
    gap: 10px;
    margin-top: 16px;
    padding: 0;
    list-style: none;
  }

  .legal-section li {
    position: relative;
    padding-left: 18px;
  }

  .legal-section li::before {
    position: absolute;
    top: 0.75em;
    left: 0;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--blue-700);
    content: '';
  }

  /* 正文内链接由 set:html 注入，需 :global 命中。 */
  .legal-content :global(a) {
    color: var(--blue-700);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .legal-content :global(a:hover) {
    color: var(--blue-800);
  }

  .legal-content :global(strong) {
    color: var(--gray-1000);
    font-weight: 600;
  }

  @media (max-width: 960px) {
    .legal-layout {
      grid-template-columns: minmax(0, 1fr);
      gap: 24px;
      padding-top: 24px;
    }

    /* 目录收成横向胶囊行：行本身滚动，页面不出现横向滚动。 */
    .legal-toc {
      position: static;
      flex-direction: row;
      gap: 8px;
      padding: 0 0 4px;
      overflow-x: auto;
      border-left: 0;
      scrollbar-width: thin;
    }

    .legal-page .legal-toc a {
      display: inline-flex;
      flex: none;
      align-items: center;
      min-height: 44px;
      margin-left: 0;
      padding: 0 16px;
      border: 1px solid var(--gray-alpha-400);
      border-radius: 9999px;
      background: var(--gray-100);
      font-weight: 500;
      white-space: nowrap;
    }

    .legal-page .legal-toc a[aria-current] {
      border-color: var(--blue-400);
    }
  }

  @media (max-width: 600px) {
    .legal-layout {
      padding-bottom: 64px;
    }

    .legal-section {
      padding: 28px 0;
    }

    .legal-section h2 {
      font-size: 22px;
    }
  }
</style>
