---
/**
 * 公共订单 checkout 弹窗 DOM 壳。
 *
 * 所有购买入口共用两个 dialog：
 * - 支付方式选择：展示调用方传入的商品摘要和渠道
 * - 订单等待：外部支付页打开后轮询订单状态
 */
import type { OrderCheckoutModalContent } from './order-checkout-types'
import type { OrderCheckoutCopy } from './order-checkout-types'

const { copy } = Astro.props as {
  copy: OrderCheckoutModalContent
}
const { auth, checkout, subscription } = copy
const checkoutCopy: OrderCheckoutCopy = {
  paymentMethodLabel: checkout.paymentMethodLabel,
  paymentTitle: checkout.paymentTitle,
  selectedPackageLabel: checkout.selectedPackageLabel,
  confirmPurchase: checkout.confirmPurchase,
  backToProducts: checkout.backToProducts,
  agreementText: checkout.agreementText,
  failed: checkout.failed,
  close: subscription.close,
  creatingOrder: subscription.creatingOrder,
  pendingPayment: subscription.pendingPayment,
  pendingPaymentTitle: subscription.pendingPaymentTitle,
  cancelPayment: subscription.cancelPayment,
  supportMailPrefix: subscription.supportMailPrefix,
  successTitle: subscription.successTitle,
  successDescription: subscription.successDescription,
  createFailed: subscription.createFailed,
  invalidPaymentData: subscription.invalidPaymentData,
  priceUpdated: subscription.priceUpdated,
  gatewayFailed: subscription.gatewayFailed,
  paymentCanceled: subscription.paymentCanceled,
  pollFailed: subscription.pollFailed,
  pollTimeout: subscription.pollTimeout,
  orderNotFound: subscription.orderNotFound,
  orderExpired: subscription.orderExpired,
  fulfillmentFailed: subscription.fulfillmentFailed,
  authExpired: subscription.authExpired
}
---

<div
  class="order-checkout-modal"
  data-order-checkout-modal
  data-clink-methods={checkout.clinkMethods}
  hidden
>
  <script
    is:inline
    type="application/json"
    data-order-checkout-copy
    set:html={JSON.stringify(checkoutCopy)}
  />

  <div class="order-checkout-backdrop" aria-hidden="true"></div>

  <section
    class="order-checkout-payment-dialog"
    data-order-checkout-payment-dialog
    role="dialog"
    aria-modal="true"
    aria-labelledby="order-checkout-payment-title"
    hidden
  >
    <header class="order-checkout-payment-header">
      <div>
        <p class="order-checkout-payment-kicker">{checkoutCopy.paymentMethodLabel}</p>
        <h2 id="order-checkout-payment-title" data-order-checkout-payment-title>
          {checkoutCopy.paymentTitle}
        </h2>
      </div>
      <button
        type="button"
        class="order-checkout-close"
        data-order-checkout-close
        aria-label={checkoutCopy.close}
      >
        <span aria-hidden="true">×</span>
      </button>
    </header>

    <main class="order-checkout-payment-middle">
      <p class="order-checkout-error" data-order-checkout-payment-error role="alert" hidden></p>
      <section class="order-checkout-selected-summary" data-order-checkout-selected-summary>
        <p class="order-checkout-selected-label">{checkoutCopy.selectedPackageLabel}</p>
        <div class="order-checkout-selected-values">
          <p data-order-checkout-selected-title></p>
          <p data-order-checkout-selected-price></p>
        </div>
        <p class="order-checkout-selected-usage" data-order-checkout-selected-usage hidden></p>
      </section>
      <div class="order-checkout-channel-list" data-order-checkout-channel-list></div>
    </main>

    <footer class="order-checkout-payment-footer">
      <label class="order-checkout-agreement">
        <input type="checkbox" data-order-checkout-agreement checked />
        <span>
          {checkoutCopy.agreementText}
          {' '}
          <a href="/terms" target="_blank" rel="noopener" data-order-checkout-terms>
            {auth.termsLink}
          </a>
          <span aria-hidden="true"> · </span>
          <a href="/privacy" target="_blank" rel="noopener" data-order-checkout-privacy>
            {auth.privacyLink}
          </a>
        </span>
      </label>
      <div class="order-checkout-payment-actions">
        <button type="button" class="btn-secondary order-checkout-back" data-order-checkout-back>
          {checkoutCopy.backToProducts}
        </button>
        <button type="button" class="btn-primary order-checkout-submit" data-order-checkout-submit>
          {checkoutCopy.confirmPurchase}
        </button>
      </div>
    </footer>
  </section>

  <section
    class="order-checkout-order-dialog"
    data-order-checkout-order-dialog
    role="dialog"
    aria-modal="true"
    aria-labelledby="order-checkout-order-title"
    hidden
  >
    <header class="order-checkout-order-header">
      <h2 id="order-checkout-order-title" data-order-checkout-order-title>
        {checkoutCopy.pendingPaymentTitle}
      </h2>
      <p data-order-checkout-order-message>
        {checkoutCopy.pendingPayment}
      </p>
    </header>

    <main class="order-checkout-order-middle" aria-live="polite">
      <div class="order-checkout-order-spinner" data-order-checkout-order-spinner aria-hidden="true"></div>
      <div class="order-checkout-success" data-order-checkout-success-panel aria-live="polite" hidden>
        <div class="order-checkout-success-mark" aria-hidden="true">
          <svg viewBox="0 0 24 24" focusable="false">
            <path d="M9.2 16.6 4.9 12.3l1.7-1.7 2.6 2.6 8.2-8.2 1.7 1.7-9.9 9.9Z"></path>
          </svg>
        </div>
        <div class="order-checkout-success-copy">
          <p class="order-checkout-success-primary" data-order-checkout-success-primary hidden></p>
          <p class="order-checkout-success-secondary" data-order-checkout-success-secondary hidden></p>
        </div>
      </div>
      <p class="order-checkout-order-error" data-order-checkout-order-error role="alert" hidden></p>
      <p class="order-checkout-order-support" data-order-checkout-order-support hidden><span data-order-checkout-order-support-prefix></span><a data-order-checkout-order-support-mail href=""></a></p>
    </main>

    <footer class="order-checkout-order-footer">
      <button
        type="button"
        class="btn-secondary order-checkout-order-cancel"
        data-order-checkout-close
        data-order-checkout-order-close
      >
        {checkoutCopy.cancelPayment}
      </button>
    </footer>
  </section>
</div>

<script>
  void import('./order-checkout-controller').catch(error => {
    console.error(
      new Error('[order-checkout-modal] Failed to load the checkout controller.', {
        cause: error
      })
    )
  })
</script>

<style is:global>
  .order-checkout-modal[hidden],
  .order-checkout-payment-dialog[hidden],
  .order-checkout-order-dialog[hidden],
  .order-checkout-success[hidden] {
    display: none;
  }

  .order-checkout-modal {
    position: fixed;
    inset: 0;
    z-index: 145;
    display: grid;
    place-items: center;
    padding: 24px;
    color: var(--gray-1000);
  }

  .order-checkout-backdrop {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.4);
  }

  .order-checkout-payment-dialog {
    position: relative;
    display: grid;
    grid-template-rows: auto minmax(0, 1fr) auto;
    width: min(560px, calc(100vw - 48px));
    max-height: min(680px, calc(100vh - 48px));
    overflow: hidden;
    border: 1px solid var(--gray-alpha-400);
    border-radius: var(--radius-md);
    background: var(--background-100);
    box-shadow: var(--shadow-modal);
  }

  .order-checkout-payment-header,
  .order-checkout-payment-footer {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 0 24px;
  }

  .order-checkout-payment-header {
    min-height: 80px;
    border-bottom: 1px solid var(--gray-alpha-400);
  }

  .order-checkout-payment-footer {
    flex-wrap: wrap;
    padding-block: 16px;
    border-top: 1px solid var(--gray-alpha-400);
    background: var(--background-200);
  }

  .order-checkout-payment-header h2 {
    margin: 0;
    color: var(--gray-1000);
    font-size: 24px;
    font-weight: 600;
    letter-spacing: -0.96px;
    line-height: 32px;
  }

  .order-checkout-payment-kicker {
    margin: 0 0 4px;
    color: var(--gray-900);
    font-size: 13px;
    font-weight: 500;
    line-height: 18px;
  }

  .order-checkout-close {
    display: inline-grid;
    place-items: center;
    width: 32px;
    height: 32px;
    border: 0;
    border-radius: var(--radius-sm);
    background: transparent;
    color: var(--gray-900);
    cursor: pointer;
    font-size: 22px;
    line-height: 1;
    transition:
      background var(--transition-fast),
      color var(--transition-fast);
  }

  .order-checkout-close:hover {
    background: var(--gray-100);
    color: var(--gray-1000);
  }

  .order-checkout-payment-middle {
    display: grid;
    align-content: start;
    gap: 16px;
    min-height: 0;
    overflow-y: auto;
    padding: 24px;
  }

  .order-checkout-error,
  .order-checkout-order-error,
  .order-checkout-order-support {
    margin: 0;
    font-size: 14px;
    line-height: 20px;
  }

  .order-checkout-error,
  .order-checkout-order-error {
    padding: 8px 12px;
    border: 1px solid var(--red-400);
    border-radius: var(--radius-sm);
    background: var(--red-100);
    color: var(--red-900);
    font-weight: 500;
  }

  .order-checkout-order-error {
    width: min(520px, 100%);
    text-align: center;
  }

  .order-checkout-selected-summary {
    display: grid;
    gap: 8px;
    padding: 16px;
    border: 1px solid var(--gray-alpha-400);
    border-radius: var(--radius-sm);
    background: var(--background-100);
  }

  .order-checkout-selected-label,
  .order-checkout-selected-values p {
    margin: 0;
  }

  .order-checkout-selected-label {
    color: var(--gray-900);
    font-size: 13px;
    line-height: 18px;
  }

  .order-checkout-selected-values {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 8px 16px;
  }

  .order-checkout-selected-values p:first-child {
    color: var(--gray-1000);
    font-size: 20px;
    font-weight: 600;
    letter-spacing: -0.4px;
    line-height: 26px;
  }

  .order-checkout-selected-values p:last-child {
    color: var(--gray-1000);
    font-size: 16px;
    font-weight: 500;
    font-variant-numeric: tabular-nums;
  }

  .order-checkout-selected-usage {
    margin: 0;
    color: var(--gray-900);
    font-size: 13px;
    line-height: 18px;
  }

  .order-checkout-channel-list {
    display: grid;
    gap: 8px;
  }

  .order-checkout-channel-button {
    min-width: 0;
    display: flex;
    align-items: center;
    justify-content: flex-start;
    gap: 12px;
    min-height: 56px;
    padding: 0 16px;
    border: 1px solid var(--gray-alpha-400);
    border-radius: var(--radius-sm);
    background: var(--background-100);
    color: var(--gray-1000);
    cursor: pointer;
    font-size: 14px;
    font-weight: 500;
    transition:
      border-color var(--transition-fast),
      background var(--transition-fast);
  }

  .order-checkout-channel-button:hover {
    border-color: var(--gray-alpha-500);
    background: var(--gray-100);
  }

  /* 选中态用 gray-1000 描边加外圈；外圈排除 :focus-visible，否则会盖住全站焦点环。 */
  .order-checkout-channel-button.is-selected:not(:focus-visible) {
    border-color: var(--gray-1000);
    box-shadow: 0 0 0 1px var(--gray-1000);
    background: var(--background-100);
  }

  .order-checkout-channel-icon {
    display: inline-grid;
    place-items: center;
    width: 32px;
    height: 32px;
    flex: 0 0 auto;
  }

  .order-checkout-channel-icon img {
    display: block;
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
  }

  .order-checkout-channel-label {
    min-width: 0;
  }

  .order-checkout-channel-button:has(.order-checkout-channel-methods) {
    display: grid;
    grid-template-columns: 32px minmax(0, 1fr);
    gap: 2px 12px;
    align-content: center;
    padding-block: 8px;
    text-align: left;
  }

  .order-checkout-channel-button:has(.order-checkout-channel-methods) .order-checkout-channel-icon {
    grid-row: 1 / 3;
  }

  .order-checkout-channel-button:has(.order-checkout-channel-methods) .order-checkout-channel-icon img {
    width: 32px;
    height: 32px;
  }

  .order-checkout-channel-methods {
    grid-column: 2 / -1;
    color: var(--gray-900);
    font-size: 12px;
    font-weight: 400;
    line-height: 16px;
    overflow-wrap: anywhere;
  }

  .order-checkout-agreement {
    display: flex;
    align-items: flex-start;
    gap: 8px;
    flex: 1 1 240px;
    min-width: 0;
    color: var(--gray-900);
    font-size: 13px;
    line-height: 18px;
  }

  .order-checkout-agreement input {
    width: 16px;
    height: 16px;
    margin-top: 1px;
    accent-color: var(--gray-1000);
    flex: 0 0 auto;
  }

  .order-checkout-agreement a,
  .order-checkout-order-support a {
    color: var(--blue-700);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .order-checkout-agreement a:hover,
  .order-checkout-order-support a:hover {
    color: var(--blue-800);
  }

  .order-checkout-payment-actions {
    display: flex;
    gap: 8px;
    flex: 0 0 auto;
  }

  /* 按钮外观来自共享 .btn-primary / .btn-secondary，这里只定宽度并允许长文案换行。 */
  .order-checkout-back,
  .order-checkout-submit,
  .order-checkout-order-cancel {
    height: auto;
    min-height: 40px;
    white-space: normal;
    text-align: center;
  }

  .order-checkout-submit {
    min-width: 160px;
  }

  .order-checkout-order-dialog {
    position: relative;
    display: grid;
    grid-template-rows: auto minmax(150px, 1fr) auto;
    width: min(560px, calc(100vw - 48px));
    max-height: min(540px, calc(100vh - 48px));
    overflow: hidden;
    border: 1px solid var(--gray-alpha-400);
    border-radius: var(--radius-md);
    background: var(--background-100);
    box-shadow: var(--shadow-modal);
  }

  .order-checkout-order-header {
    padding: 24px;
    border-bottom: 1px solid var(--gray-alpha-400);
  }

  .order-checkout-order-header h2 {
    margin: 0;
    color: var(--gray-1000);
    font-size: 24px;
    font-weight: 600;
    letter-spacing: -0.96px;
    line-height: 32px;
  }

  .order-checkout-order-header p {
    max-width: 560px;
    margin: 8px 0 0;
    color: var(--gray-900);
    font-size: 14px;
    line-height: 20px;
  }

  .order-checkout-order-middle {
    display: grid;
    place-items: center;
    gap: 16px;
    min-height: 0;
    padding: 24px;
  }

  .order-checkout-order-spinner {
    width: 40px;
    height: 40px;
    border: 3px solid var(--gray-alpha-400);
    border-top-color: var(--gray-1000);
    border-radius: 9999px;
    transform-origin: 50% 50%;
    will-change: transform;
    animation: orderCheckoutSpin 800ms linear infinite;
  }

  .order-checkout-success {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    align-items: center;
    gap: 12px;
    width: min(430px, 100%);
    padding: 16px;
    border: 1px solid var(--green-400);
    border-radius: var(--radius-sm);
    background: var(--green-100);
  }

  .order-checkout-success-mark {
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    border-radius: 9999px;
    background: var(--green-900);
    color: var(--background-100);
  }

  .order-checkout-success-mark svg {
    width: 20px;
    height: 20px;
    fill: currentColor;
  }

  .order-checkout-success-copy {
    display: grid;
    gap: 4px;
    min-width: 0;
  }

  .order-checkout-success p {
    margin: 0;
    color: var(--green-900);
    line-height: 20px;
  }

  .order-checkout-success-primary {
    font-size: 16px;
    font-weight: 600;
  }

  .order-checkout-success-secondary {
    font-size: 13px;
  }

  .order-checkout-order-support {
    width: min(520px, 100%);
    color: var(--gray-900);
    text-align: center;
  }

  .order-checkout-order-footer {
    display: flex;
    justify-content: center;
    padding: 0 24px 24px;
  }

  .order-checkout-order-cancel {
    width: min(100%, 260px);
    padding: 0 20px;
  }

  @keyframes orderCheckoutSpin {
    from {
      transform: rotate(0deg);
    }

    to {
      transform: rotate(360deg);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .order-checkout-channel-button,
    .order-checkout-close {
      transition: none;
    }
  }

  @media (max-width: 760px) {
    .order-checkout-modal {
      padding: 12px;
    }

    .order-checkout-order-dialog,
    .order-checkout-payment-dialog {
      width: calc(100vw - 24px);
      max-height: calc(100vh - 24px);
    }

    .order-checkout-payment-header,
    .order-checkout-payment-footer {
      padding-inline: 16px;
    }

    .order-checkout-payment-header h2 {
      font-size: 20px;
      line-height: 26px;
    }

    .order-checkout-channel-button,
    .order-checkout-submit,
    .order-checkout-back {
      width: 100%;
    }

    .order-checkout-payment-middle {
      padding: 20px 16px;
    }

    .order-checkout-payment-footer {
      align-items: stretch;
      flex-direction: column;
      justify-content: center;
    }

    .order-checkout-payment-actions {
      width: 100%;
      flex-direction: column-reverse;
    }

    .order-checkout-order-header {
      padding: 20px 16px;
    }

    .order-checkout-order-middle {
      min-height: 170px;
      padding: 24px 16px;
    }

    .order-checkout-order-footer {
      padding: 0 16px 20px;
    }
  }

  /* 手机浏览器的 100vh 含工具栏后方区域，会把底部「继续支付」等按钮藏在工具栏后；支持动态视口单位时只占可视高度。 */
  @supports (height: 100dvh) {
    .order-checkout-modal {
      height: 100dvh;
    }

    .order-checkout-payment-dialog {
      max-height: min(680px, calc(100dvh - 48px));
    }

    .order-checkout-order-dialog {
      max-height: min(540px, calc(100dvh - 48px));
    }

    @media (max-width: 760px) {
      .order-checkout-order-dialog,
      .order-checkout-payment-dialog {
        max-height: calc(100dvh - 24px);
      }
    }
  }
</style>
