---
/** 区块 7：FAQ，原生 details/summary，无脚本；FAQPage JSON-LD 由页面根据同一份文案输出。 */
import HomeSection from './HomeSection.astro'
import type { HomepageContent } from '../../i18n/schema'

const { copy } = Astro.props as { copy: HomepageContent['faq'] }
---

<HomeSection id="home-faq" heading={copy.heading}>
  <div class="home-faq-list">
    {copy.items.map(item => (
      <details class="home-faq-item">
        <summary>
          <span>{item.question}</span>
          <svg class="home-faq-marker" viewBox="0 0 24 24" aria-hidden="true">
            <path d="m6 9 6 6 6-6" />
          </svg>
        </summary>
        <p>{item.answer}</p>
      </details>
    ))}
  </div>
</HomeSection>

<style>
  .home-faq-list {
    max-width: 800px;
    border: 1px solid var(--gray-alpha-400);
    border-radius: var(--radius-md);
    overflow: hidden;
  }

  .home-faq-item + .home-faq-item {
    border-top: 1px solid var(--gray-alpha-400);
  }

  .home-faq-item summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 16px 24px;
    font-size: 16px;
    font-weight: 600;
    line-height: 24px;
    cursor: pointer;
    list-style: none;
  }

  .home-faq-item summary::-webkit-details-marker {
    display: none;
  }

  .home-faq-item summary:hover {
    background: var(--gray-100);
  }

  .home-faq-marker {
    flex: 0 0 20px;
    width: 20px;
    height: 20px;
    fill: none;
    stroke: var(--gray-900);
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .home-faq-item[open] .home-faq-marker {
    transform: rotate(180deg);
  }

  .home-faq-item p {
    padding: 0 24px 16px;
    color: var(--gray-900);
    font-size: 14px;
    line-height: 20px;
  }
</style>
