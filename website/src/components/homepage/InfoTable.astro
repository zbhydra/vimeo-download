---
/**
 * 通用信息表格区块
 *
 * 首页「情景匹配表（situation）」与「方法对比表（comparison）」共用同一组件。
 * - situation：带 intro 引导段、2 列。
 * - comparison：无 intro、4 列。
 * intro 用 `{copy.intro && ...}` 条件渲染兼容两者。
 *
 * 响应式：≤640px 表头隐藏，每行转为一张纵向卡片堆叠；
 * 每个 td 用 `::before content: attr(data-label)` 显示对应列名作为行内标签
 * （data-label 由 headers 按列序注入），避免移动端横向滚动。
 */
import type { InfoTableMessage } from '../../i18n/schema'

interface Props {
  /** 表格内容（标题 / 可选 intro / 表头 / 数据行） */
  copy: InfoTableMessage
}

const { copy } = Astro.props as Props
---

<section class="info-table">
  <div class="container">
    <div class="info-table-shell">
      <h2>{copy.title}</h2>
      {copy.intro && <p class="info-table-intro">{copy.intro}</p>}
      <table>
        <thead>
          <tr>
            {copy.headers.map(header => <th>{header}</th>)}
          </tr>
        </thead>
        <tbody>
          {copy.rows.map(row => (
            <tr>
              {row.cells.map((cell, index) => (
                <td data-label={copy.headers[index]}>{cell}</td>
              ))}
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </div>
</section>

<style>
  .info-table {
    padding: 0 0 28px;
  }

  /* shell 与现有 homepage-howto-shell 视觉保持一致 */
  .info-table-shell {
    border-radius: 36px;
    border: 1px solid rgba(15, 23, 42, 0.08);
    background: linear-gradient(180deg, rgba(255, 255, 255, 0.96), rgba(255, 255, 255, 0.86));
    box-shadow: 0 28px 72px rgba(15, 23, 42, 0.08);
    padding: clamp(28px, 4vw, 42px);
  }

  .info-table-shell h2 {
    font-size: clamp(1.7rem, 2.8vw, 2.35rem);
    line-height: 1.12;
    color: var(--color-gray-900);
  }

  .info-table-intro {
    margin-top: 12px;
    color: var(--color-gray-600);
    font-size: 15px;
    line-height: 1.65;
  }

  table {
    width: 100%;
    border-collapse: collapse;
    margin-top: 24px;
  }

  thead th {
    text-align: left;
    font-size: 13px;
    font-weight: 800;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-gray-500);
    padding: 12px 16px;
    border-bottom: 1px solid rgba(15, 23, 42, 0.1);
  }

  tbody td {
    padding: 16px;
    font-size: 15px;
    line-height: 1.7;
    color: var(--color-gray-600);
    border-bottom: 1px solid rgba(15, 23, 42, 0.06);
    vertical-align: top;
  }

  /* 首列强调（情景列） */
  tbody td:first-child {
    color: var(--color-gray-900);
    font-weight: 700;
  }

  /* ≤640px：表格转纵向卡片堆叠，禁止横向滚动 */
  @media (max-width: 640px) {
    .info-table-shell {
      padding: 24px 20px;
      border-radius: 28px;
    }

    thead {
      /* 移动端隐藏表头，列名改由每个 td 的 ::before 标签呈现 */
      position: absolute;
      width: 1px;
      height: 1px;
      padding: 0;
      margin: -1px;
      overflow: hidden;
      clip: rect(0, 0, 0, 0);
      white-space: nowrap;
      border: 0;
    }

    tr {
      display: block;
      border: 1px solid rgba(15, 23, 42, 0.08);
      border-radius: 18px;
      padding: 16px;
      margin-bottom: 12px;
      background: rgba(248, 250, 252, 0.92);
    }

    tbody td {
      display: block;
      padding: 0;
      border-bottom: none;
    }

    tbody td + td {
      margin-top: 12px;
    }

    /* 用 headers 注入的 data-label 作为行内列名标签 */
    tbody td::before {
      content: attr(data-label);
      display: block;
      margin-bottom: 4px;
      font-size: 12px;
      font-weight: 800;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      color: var(--color-gray-500);
    }
  }
</style>
