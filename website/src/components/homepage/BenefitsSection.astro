---
/**
 * 首页卖点网格区块（原飞书稿 "Why Use an Online Video Downloader?"）
 *
 * 结构与 CrossLinksSection 同构：标题 → intro 引导段 → 卡片网格。
 * 卡片为 <article>（仅标题+描述、不可点击、无跳转），复用 PlatformFeatureMessage。
 *
 * 响应式：网格 auto-fit minmax(280px,1fr)；≤960px 显式转单列（与 CrossLinksSection 一致）。
 */
import type { PlatformFeatureMessage } from '../../i18n/schema'

interface Props {
  /** 区块标题 */
  title: string
  /** 引导段 */
  intro: string
  /** 卖点卡列表 */
  items: PlatformFeatureMessage[]
}

const { title, intro, items } = Astro.props as Props
---

<section class="benefits">
  <div class="container">
    <div class="benefits-shell">
      <h2>{title}</h2>
      <p class="benefits-intro">{intro}</p>
      <div class="benefits-grid">
        {items.map(item => (
          <article class="benefit-card">
            <h3>{item.title}</h3>
            <p>{item.description}</p>
          </article>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .benefits {
    padding: 0 0 28px;
  }

  /* 区块外壳：与 InfoTable / HowTo / Solutions 的 shell 同规格，让标题+卡片网格整体收进一张大卡，与全页"每区块一张卡"的节奏一致 */
  .benefits-shell {
    border-radius: 36px;
    border: 1px solid rgba(15, 23, 42, 0.08);
    background: linear-gradient(180deg, rgba(255, 255, 255, 0.96), rgba(255, 255, 255, 0.86));
    box-shadow: 0 28px 72px rgba(15, 23, 42, 0.08);
    padding: clamp(28px, 4vw, 42px);
  }

  .benefits h2 {
    font-size: clamp(1.75rem, 3vw, 2.5rem);
    line-height: 1.1;
    letter-spacing: -0.02em;
  }

  .benefits-intro {
    margin-top: 12px;
    color: var(--color-gray-600);
    font-size: 15px;
    line-height: 1.65;
  }

  .benefits-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 18px;
    margin-top: 24px;
  }

  /* 卖点卡：偏灰底，与白色 shell 形成层次（对齐 HowTo step-card），不可点击（<article>） */
  .benefit-card {
    padding: 28px;
    border-radius: 26px;
    border: 1px solid rgba(15, 23, 42, 0.08);
    background: rgba(248, 250, 252, 0.92);
    box-shadow: 0 20px 40px rgba(15, 23, 42, 0.06);
  }

  .benefit-card h3 {
    font-size: 20px;
    line-height: 1.2;
    letter-spacing: -0.02em;
  }

  .benefit-card p {
    margin-top: 10px;
    color: var(--color-gray-600);
    font-size: 15px;
    line-height: 1.65;
  }

  @media (max-width: 960px) {
    .benefits-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 640px) {
    .benefits-shell {
      padding: 24px 20px;
      border-radius: 28px;
    }

    .benefit-card {
      padding: 22px;
      border-radius: 22px;
    }
  }
</style>
