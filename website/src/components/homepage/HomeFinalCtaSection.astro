---
/**
 * 区块 8：结尾 CTA，唯一动作是 Add to Chrome。
 * 卡片底是 SiteStage 的 `card` 变体（光束、网格、渐变描边都由它实现）；右侧是旋转 -2° 的插件面板示意，
 * 复用 ExtensionMockup 的 `panel` 模式，这里只负责定位与旋转。面板是装饰，包在 figure 里（aria-hidden）。
 * ≤ 600 px 纵向堆叠、按钮满宽、不放面板示意。
 */
import SiteStage from '../site/SiteStage.astro'
import ExtensionMockup from './ExtensionMockup.astro'
import type { HomepageContent } from '../../i18n/schema'

const { copy, installUrl, rows } = Astro.props as {
  copy: HomepageContent['finalCta']
  installUrl: string
  /** 面板行标签（本地化），与插件展示同源。 */
  rows: HomepageContent['intro']['panel']['rows']
}
---

<section class="home-cta" aria-labelledby="home-final-cta-heading">
  <div class="container">
    <SiteStage variant="card">
      <div class="home-cta-inner">
        <div class="home-cta-copy">
          <h2 id="home-final-cta-heading" class="home-cta-heading">{copy.heading}</h2>
          <p class="home-cta-description">{copy.description}</p>
          <a
            class="btn-primary home-cta-button"
            href={installUrl}
            target="_blank"
            rel="noopener"
            data-ga-event="outbound_chrome_store_click"
            data-ga-source="homepage_final_cta"
          >
            <span class="btn-chrome-plate">
              <img src="/googe-ext-logo-192px.svg" alt="" width="16" height="16" loading="lazy" aria-hidden="true" />
            </span>
            <span>{copy.primaryCta}</span>
          </a>
        </div>
        <figure class="home-cta-panel" aria-hidden="true">
          <ExtensionMockup part="panel" rows={rows} />
        </figure>
      </div>
    </SiteStage>
  </div>
</section>

<style>
  .home-cta {
    padding: 24px 0 120px;
  }

  .home-cta-inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 40px;
    padding: 72px 56px;
  }

  .home-cta-copy {
    flex: 1 1 420px;
    min-width: 0;
  }

  .home-cta-heading {
    color: var(--gray-1000);
    font-size: clamp(30px, 3.6vw, 42px);
    font-weight: 700;
    line-height: 1.12;
    letter-spacing: -0.035em;
  }

  .home-cta-description {
    max-width: 520px;
    margin-top: 16px;
    color: var(--gray-900);
    font-size: 18px;
    line-height: 1.6;
  }

  /* 本地化按钮文案可能很长，允许换行而不是撑破布局。 */
  .home-cta-button {
    height: auto;
    min-height: 52px;
    margin-top: 32px;
    padding: 12px 24px;
    border-radius: var(--radius-md);
    font-size: 16px;
    white-space: normal;
    text-align: center;
  }

  .home-cta-panel {
    flex: 0 1 360px;
    min-width: 260px;
    margin: 0;
    transform: rotate(-2deg);
  }

  @media (max-width: 960px) {
    .home-cta {
      padding-bottom: 80px;
    }

    .home-cta-inner {
      padding: 56px 40px;
    }
  }

  @media (max-width: 600px) {
    .home-cta {
      padding: 8px 0 64px;
    }

    .home-cta-inner {
      display: block;
      padding: 40px 24px;
    }

    .home-cta-heading {
      font-size: 30px;
      line-height: 1.15;
      letter-spacing: -0.03em;
    }

    .home-cta-description {
      margin-top: 14px;
      font-size: 16px;
    }

    .home-cta-button {
      display: flex;
      margin-top: 28px;
    }

    .home-cta-panel {
      display: none;
    }
  }
</style>
