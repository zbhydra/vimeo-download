---
import type { HomepageWorkspaceContent } from '../../i18n/schema'

const { copy } = Astro.props as { copy: HomepageWorkspaceContent }
---

<div class="homepage-auth-modal" data-homepage-auth-modal hidden>
  <button
    type="button"
    class="homepage-auth-backdrop"
    data-homepage-auth-close
    aria-label={copy.auth.closeLabel ?? 'Close'}
  ></button>

  <div class="homepage-auth-dialog" role="dialog" aria-modal="true" aria-labelledby="homepage-auth-title">
    <div class="homepage-auth-heading">
      <p class="homepage-auth-eyebrow">{copy.auth.eyebrow}</p>
      <h2 id="homepage-auth-title">{copy.auth.modalTitle ?? copy.auth.title}</h2>
      {copy.auth.modalDescription && <p>{copy.auth.modalDescription}</p>}
    </div>

    <button
      type="button"
      class="homepage-auth-close"
      data-homepage-auth-close
      aria-label={copy.auth.closeLabel ?? 'Close'}
    >
      <span aria-hidden="true">×</span>
    </button>

    <div
      class="homepage-google-button"
      data-homepage-google-login
      aria-label={copy.auth.continueWithGoogle}
    ></div>

    <form class="homepage-auth-form" data-homepage-auth-form hidden>
      <label class="homepage-field">
        <span class="homepage-field-label">{copy.auth.emailLabel}</span>
        <input
          type="email"
          autocomplete="email"
          class="homepage-input"
          placeholder={copy.auth.emailPlaceholder}
          data-homepage-login-email
        />
      </label>

      <button
        type="button"
        class="homepage-secondary-button homepage-continue-email-button"
        data-homepage-continue-email
      >
        {copy.auth.continueWithEmail}
      </button>

      <div class="homepage-email-code-area" data-homepage-email-code-area hidden>
        <label class="homepage-field">
          <span class="homepage-field-label">{copy.auth.codeLabel}</span>
          <div class="homepage-code-row">
            <input
              type="text"
              inputmode="numeric"
              autocomplete="one-time-code"
              class="homepage-input homepage-code-input"
              placeholder={copy.auth.codePlaceholder}
              data-homepage-login-code
            />
            <button
              type="button"
              class="homepage-secondary-button homepage-send-code-button"
              data-homepage-send-code
            >
              {copy.auth.sendAgain}
            </button>
          </div>
        </label>

        <button type="submit" class="homepage-primary-button" data-homepage-login-submit hidden>
          {copy.auth.signIn}
        </button>
      </div>

      <p
        class="homepage-inline-status"
        data-homepage-send-code-status
        role="status"
        aria-live="polite"
      ></p>
    </form>

    <div class="homepage-auth-footer" data-homepage-email-entry>
      <span>{copy.auth.or}</span>
      <button type="button" class="homepage-email-link" data-homepage-email-entry-button>
        {copy.auth.continueWithEmail}
      </button>
    </div>
    <p class="homepage-auth-terms">
      {copy.auth.termsNotice}
      {' '}
      <a href="/terms">{copy.auth.termsLink}</a>
      <span aria-hidden="true"> · </span>
      <a href="/privacy">{copy.auth.privacyLink}</a>
    </p>
    <p class="homepage-inline-error" data-homepage-auth-error role="alert" hidden></p>
  </div>
</div>

<style is:global>
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .homepage-auth-heading {
    display: grid;
    gap: 10px;
    margin-bottom: 22px;
    padding-right: 54px;
  }

  .homepage-auth-heading h2 {
    margin: 0;
    color: #0f172a;
    font-size: 28px;
    line-height: 1.08;
  }

  .homepage-auth-heading p {
    margin: 0;
    max-width: 34ch;
    color: #475569;
    font-size: 14px;
    line-height: 1.6;
  }

  .homepage-auth-eyebrow {
    width: max-content;
    padding: 6px 10px;
    border: 1px solid rgba(37, 99, 235, 0.14);
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.62);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.72);
    color: #2563eb !important;
    font-size: 11px !important;
    font-weight: 800;
    letter-spacing: 0;
    text-transform: uppercase;
  }

  .homepage-field {
    display: grid;
    gap: 10px;
  }

  .homepage-auth-form,
  .homepage-email-code-area {
    display: grid;
    gap: 16px;
  }

  .homepage-code-row {
    display: flex;
    align-items: stretch;
    gap: 12px;
  }

  .homepage-field-label {
    color: #64748b;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0;
    text-transform: uppercase;
  }

  .homepage-input {
    width: 100%;
    min-height: 58px;
    padding: 0 20px;
    border: 1px solid rgba(37, 99, 235, 0.16);
    border-radius: 18px;
    background: rgba(255, 255, 255, 0.72);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.86),
      0 10px 24px rgba(15, 23, 42, 0.05);
    color: #0f172a;
    font-size: 17px;
    backdrop-filter: blur(14px);
  }

  .homepage-input:focus {
    outline: 3px solid rgba(14, 165, 233, 0.18);
    border-color: rgba(37, 99, 235, 0.42);
    background: rgba(255, 255, 255, 0.9);
  }

  .homepage-code-input {
    min-width: 0;
  }

  .homepage-primary-button,
  .homepage-secondary-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 58px;
    padding: 0 22px;
    border-radius: 18px;
    font-size: 15px;
    font-weight: 800;
    transition: all var(--transition-normal);
  }

  .homepage-primary-button {
    color: white;
    background: linear-gradient(135deg, #2563eb, #1d4ed8);
    box-shadow: 0 18px 30px rgba(37, 99, 235, 0.24);
  }

  .homepage-primary-button:hover {
    transform: translateY(-1px);
  }

  .homepage-secondary-button {
    color: #0f172a;
    background: rgba(255, 255, 255, 0.54);
    border: 1px solid rgba(37, 99, 235, 0.14);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.76);
    backdrop-filter: blur(12px);
  }

  .homepage-secondary-button:hover {
    border-color: rgba(37, 99, 235, 0.24);
    color: var(--color-primary);
  }

  .homepage-continue-email-button {
    color: white;
    background: linear-gradient(135deg, #2563eb, #1d4ed8);
    border-color: rgba(37, 99, 235, 0.88);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.22),
      0 16px 30px rgba(37, 99, 235, 0.22);
  }

  .homepage-continue-email-button:hover {
    color: white;
    border-color: #1d4ed8;
    transform: translateY(-1px);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.24),
      0 20px 38px rgba(37, 99, 235, 0.28);
  }

  .homepage-google-button {
    width: 100%;
    min-height: 54px;
    margin-bottom: 18px;
    display: grid;
  }

  .google-oauth-button {
    width: 100%;
    min-height: 54px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    padding: 0 18px;
    border: 1px solid rgba(15, 23, 42, 0.14);
    border-radius: 8px;
    background: #fff;
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.92),
      0 12px 24px rgba(15, 23, 42, 0.08);
    color: #0f172a;
    font-size: 15px;
    font-weight: 800;
    transition:
      transform var(--transition-normal),
      border-color var(--transition-normal),
      box-shadow var(--transition-normal);
  }

  .google-oauth-button:hover {
    border-color: rgba(37, 99, 235, 0.28);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.92),
      0 16px 30px rgba(15, 23, 42, 0.12);
    transform: translateY(-1px);
  }

  .google-oauth-button:disabled {
    cursor: wait;
    opacity: 0.72;
    transform: none;
  }

  .google-oauth-button-icon {
    width: 20px;
    height: 20px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex: 0 0 auto;
    line-height: 0;
  }

  .homepage-primary-button:disabled,
  .homepage-secondary-button:disabled {
    cursor: not-allowed;
    opacity: 0.64;
    transform: none;
  }

  .homepage-send-code-button {
    min-height: 54px;
    padding: 0 18px;
    white-space: nowrap;
    flex-shrink: 0;
    width: auto;
  }

  .homepage-inline-status,
  .homepage-inline-error,
  .homepage-auth-terms {
    min-height: 20px;
    font-size: 13px;
  }

  .homepage-inline-status {
    color: #475569;
  }

  .homepage-inline-error {
    color: var(--color-error);
  }

  .homepage-auth-terms {
    margin: 0;
    color: #64748b;
    line-height: 1.5;
  }

  .homepage-auth-terms a {
    color: #0f172a;
    font-weight: 700;
  }

  .homepage-auth-footer {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 7px;
    margin-top: 18px;
    color: #64748b;
    font-size: 13px;
    line-height: 1.5;
  }

  .homepage-email-link {
    min-height: 32px;
    padding: 0;
    border: 0;
    background: transparent;
    color: #1d4ed8;
    cursor: pointer;
    font: inherit;
    font-weight: 800;
  }

  .homepage-email-link:hover {
    color: #0f172a;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .homepage-auth-modal[hidden],
  .homepage-auth-form[hidden],
  .homepage-auth-footer[hidden],
  .homepage-email-code-area[hidden],
  .homepage-primary-button[hidden],
  .homepage-continue-email-button[hidden] {
    display: none;
  }

  .homepage-auth-modal {
    position: fixed;
    inset: 0;
    z-index: 130;
    display: grid;
    place-items: center;
    padding: 20px;
  }

  .homepage-auth-backdrop {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(135deg, rgba(15, 23, 42, 0.46), rgba(37, 99, 235, 0.2)),
      rgba(2, 6, 23, 0.24);
    backdrop-filter: blur(12px) saturate(1.12);
  }

  .homepage-auth-dialog {
    position: relative;
    width: min(520px, 100%);
    padding: 34px 26px 24px;
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.72);
    border-radius: 30px;
    background:
      linear-gradient(145deg, rgba(255, 255, 255, 0.94), rgba(239, 246, 255, 0.78)),
      rgba(255, 255, 255, 0.72);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.88),
      inset 0 -1px 0 rgba(37, 99, 235, 0.08),
      0 32px 90px rgba(15, 23, 42, 0.28);
    backdrop-filter: blur(28px) saturate(1.24);
  }

  .homepage-auth-dialog::before {
    content: "";
    position: absolute;
    inset: 0 0 auto;
    height: 120px;
    background: linear-gradient(180deg, rgba(255, 255, 255, 0.68), rgba(255, 255, 255, 0));
    pointer-events: none;
  }

  .homepage-auth-close {
    width: 40px;
    height: 40px;
    position: absolute;
    top: 18px;
    right: 18px;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.58);
    border: 1px solid rgba(37, 99, 235, 0.12);
    color: #0f172a;
    font-size: 24px;
    line-height: 1;
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.76),
      0 12px 24px rgba(15, 23, 42, 0.08);
    backdrop-filter: blur(12px);
  }

  @media (max-width: 720px) {
    .homepage-auth-modal {
      padding: 14px;
    }

    .homepage-auth-dialog {
      padding: 30px 18px 20px;
      border-radius: 26px;
    }

    .homepage-auth-heading h2 {
      font-size: 24px;
    }

    .homepage-primary-button,
    .homepage-secondary-button {
      width: 100%;
    }

    .homepage-code-row {
      flex-wrap: wrap;
    }

    .homepage-send-code-button {
      width: 100%;
    }
  }
</style>
