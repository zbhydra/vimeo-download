---
/** 区块 2：插件功能卡片网格。 */
import HomeSection from './HomeSection.astro'
import type { HomepageContent } from '../../i18n/schema'

const { copy } = Astro.props as { copy: HomepageContent['features'] }
---

<HomeSection id="home-features" heading={copy.heading}>
  <ul class="home-feature-grid">
    {copy.items.map(item => (
      <li class="home-feature-card">
        <h3>{item.title}</h3>
        <p>{item.description}</p>
      </li>
    ))}
  </ul>
</HomeSection>

<style>
  .home-feature-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 16px;
    list-style: none;
  }

  .home-feature-card {
    padding: 24px;
    border: 1px solid var(--gray-alpha-400);
    border-radius: var(--radius-md);
    background: var(--background-100);
    box-shadow: var(--shadow-card);
  }

  .home-feature-card h3 {
    font-size: 16px;
    font-weight: 600;
    line-height: 24px;
    letter-spacing: -0.32px;
  }

  .home-feature-card p {
    margin-top: 8px;
    color: var(--gray-900);
    font-size: 14px;
    line-height: 20px;
  }

  @media (max-width: 1200px) {
    .home-feature-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 960px) {
    .home-feature-grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
