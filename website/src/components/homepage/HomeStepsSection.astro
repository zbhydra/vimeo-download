---
/**
 * 区块 3：使用步骤，序号由 CSS 计数器生成。
 * 桌面是 4 张卡；≤ 960 px 单列，≤ 600 px 改成竖向时间线（左侧编号圆点，圆点之间用渐变竖线连接）。
 */
import HomeSection from './HomeSection.astro'
import type { HomepageContent } from '../../i18n/schema'

const { copy } = Astro.props as { copy: HomepageContent['steps'] }
---

<HomeSection id="home-steps" heading={copy.heading} center>
  <ol class="home-steps">
    {
      copy.items.map(item => (
        <li class="home-step">
          <h3>{item.title}</h3>
          <p>{item.description}</p>
        </li>
      ))
    }
  </ol>
</HomeSection>

<style>
  .home-steps {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 16px;
    list-style: none;
    counter-reset: home-step;
  }

  .home-step {
    position: relative;
    counter-increment: home-step;
    padding: 28px;
    border: 1px solid var(--gray-alpha-400);
    border-radius: var(--radius-xl);
    background: var(--gray-100);
    box-shadow: var(--shadow-card);
  }

  /* 徽标数字用纯白：近白色在渐变起点只有 4.45:1，低于 AA（spec-website §4 白名单：`--gradient-brand` 底上的徽标文字）。 */
  .home-step::before {
    content: counter(home-step);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: var(--gradient-brand);
    color: var(--on-brand);
    font-size: 15px;
    font-weight: 700;
    line-height: 1;
    box-shadow: 0 8px 16px -8px var(--shadow-badge-color);
  }

  .home-step h3 {
    margin-top: 20px;
    color: var(--gray-1000);
    font-size: 17px;
    font-weight: 600;
    line-height: 1.3;
  }

  .home-step p {
    margin-top: 8px;
    color: var(--gray-900);
    font-size: 15px;
    line-height: 1.6;
  }

  @media (max-width: 960px) {
    .home-steps {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  /* 时间线：卡片摊平成「圆点 + 文字」，圆点之间的竖线用 ::after 画在圆点下方。 */
  @media (max-width: 600px) {
    .home-steps {
      gap: 0;
    }

    .home-step {
      padding: 0 0 28px 52px;
      border: 0;
      border-radius: 0;
      background: none;
      box-shadow: none;
    }

    .home-step:last-child {
      padding-bottom: 0;
    }

    .home-step::before {
      position: absolute;
      top: 0;
      left: 0;
    }

    .home-step:not(:last-child)::after {
      content: '';
      position: absolute;
      top: 42px;
      bottom: 6px;
      left: 17px;
      width: 2px;
      border-radius: 2px;
      background: linear-gradient(180deg, rgba(138, 180, 255, 0.6), rgba(167, 139, 250, 0.15));
    }

    .home-step h3 {
      margin-top: 0;
      padding-top: 6px;
    }

    .home-step p {
      margin-top: 6px;
    }
  }
</style>
