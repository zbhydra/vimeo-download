---
/** 区块 3：使用步骤，序号由 CSS 计数器生成。 */
import HomeSection from './HomeSection.astro'
import type { HomepageContent } from '../../i18n/schema'

const { copy } = Astro.props as { copy: HomepageContent['steps'] }
---

<HomeSection id="home-steps" heading={copy.heading}>
  <ol class="home-steps">
    {copy.items.map(item => (
      <li class="home-step">
        <h3>{item.title}</h3>
        <p>{item.description}</p>
      </li>
    ))}
  </ol>
</HomeSection>

<style>
  .home-steps {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 16px;
    list-style: none;
    counter-reset: home-step;
  }

  .home-step {
    counter-increment: home-step;
    padding: 24px;
    border: 1px solid var(--gray-alpha-400);
    border-radius: var(--radius-md);
    background: var(--background-100);
  }

  .home-step::before {
    content: counter(home-step);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 24px;
    height: 24px;
    margin-bottom: 16px;
    border-radius: 9999px;
    background: var(--gray-1000);
    color: var(--background-100);
    font-size: 12px;
    font-weight: 500;
    line-height: 16px;
  }

  .home-step h3 {
    font-size: 16px;
    font-weight: 600;
    line-height: 24px;
    letter-spacing: -0.32px;
  }

  .home-step p {
    margin-top: 8px;
    color: var(--gray-900);
    font-size: 14px;
    line-height: 20px;
  }

  @media (max-width: 1200px) {
    .home-steps {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 960px) {
    .home-steps {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
