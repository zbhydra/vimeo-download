---
import type { HomepageHowToMessage } from '../../i18n/schema'

const { copy } = Astro.props as { copy: HomepageHowToMessage }
---

<section class="homepage-howto" data-homepage-howto>
  <div class="container">
    <div class="homepage-howto-shell">
      <div class="homepage-howto-lead">
        <h2>{copy.title}</h2>
        <p class="homepage-howto-subtitle">{copy.subtitle}</p>
      </div>

      <div class="homepage-howto-timeline">
        {copy.steps.map((step, index) => (
          <article class="homepage-howto-step" data-homepage-howto-step>
            <div class="homepage-howto-step-rail">
              <span class="homepage-howto-step-index">{String(index + 1).padStart(2, '0')}</span>
            </div>
            <div class="homepage-howto-step-card">
              <h3>{step.title}</h3>
              <p>{step.description}</p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .homepage-howto {
    padding: 0 0 28px;
  }

  .homepage-howto-shell {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1.08fr) minmax(0, 1fr);
    gap: clamp(24px, 4vw, 48px);
    padding: clamp(28px, 4vw, 42px);
    border-radius: 36px;
    border: 1px solid rgba(15, 23, 42, 0.08);
    background:
      radial-gradient(circle at top left, rgba(37, 99, 235, 0.08), transparent 32%),
      linear-gradient(180deg, rgba(255, 255, 255, 0.96), rgba(255, 255, 255, 0.86));
    box-shadow: 0 28px 72px rgba(15, 23, 42, 0.08);
    overflow: clip;
  }

  .homepage-howto-shell::after {
    content: '';
    position: absolute;
    right: -72px;
    top: -72px;
    width: 220px;
    height: 220px;
    border-radius: 999px;
    background: radial-gradient(circle, rgba(249, 115, 22, 0.12) 0%, rgba(249, 115, 22, 0) 70%);
    pointer-events: none;
  }

  .homepage-howto-lead {
    position: relative;
    z-index: 1;
    max-width: 34rem;
    padding-top: 4px;
  }

  .homepage-howto-lead h2 {
    font-size: clamp(1.7rem, 2.8vw, 2.35rem);
    line-height: 1.12;
    letter-spacing: 0;
  }

  .homepage-howto-subtitle {
    margin-top: 12px;
    color: var(--color-gray-600);
    font-size: 15px;
    line-height: 1.65;
  }

  .homepage-howto-timeline {
    position: relative;
    display: grid;
    gap: 16px;
  }

  .homepage-howto-timeline::before {
    content: '';
    position: absolute;
    left: 27px;
    top: 28px;
    bottom: 28px;
    width: 1px;
    background: linear-gradient(180deg, rgba(37, 99, 235, 0.34), rgba(37, 99, 235, 0.08));
  }

  .homepage-howto-step {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 18px;
    align-items: start;
  }

  .homepage-howto-step-rail {
    display: flex;
    align-items: flex-start;
    justify-content: center;
    width: 56px;
    padding-top: 6px;
  }

  .homepage-howto-step-index {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 40px;
    height: 40px;
    padding: 0 12px;
    border-radius: 999px;
    color: var(--color-primary);
    font-size: 13px;
    font-weight: 800;
    letter-spacing: 0.1em;
    background: rgba(255, 255, 255, 0.96);
    border: 1px solid rgba(37, 99, 235, 0.12);
    box-shadow: 0 10px 24px rgba(37, 99, 235, 0.12);
  }

  .homepage-howto-step-card {
    min-height: 148px;
    padding: 24px 24px 22px;
    border-radius: 26px;
    border: 1px solid rgba(15, 23, 42, 0.08);
    background: rgba(248, 250, 252, 0.92);
    box-shadow: 0 20px 40px rgba(15, 23, 42, 0.06);
  }

  .homepage-howto-step-card h3 {
    font-size: clamp(1.2rem, 1.7vw, 1.45rem);
    line-height: 1.18;
    letter-spacing: 0;
  }

  .homepage-howto-step-card p {
    margin-top: 10px;
    color: var(--color-gray-600);
    font-size: 15px;
    line-height: 1.75;
  }

  @media (max-width: 960px) {
    .homepage-howto-shell {
      grid-template-columns: 1fr;
    }

    .homepage-howto-lead {
      max-width: none;
    }
  }

  @media (max-width: 640px) {
    .homepage-howto {
      padding-bottom: 20px;
    }

    .homepage-howto-shell {
      padding: 24px 20px;
      border-radius: 28px;
      gap: 24px;
    }

    .homepage-howto-timeline::before {
      left: 22px;
      top: 24px;
      bottom: 24px;
    }

    .homepage-howto-step {
      gap: 14px;
    }

    .homepage-howto-step-rail {
      width: 46px;
    }

    .homepage-howto-step-index {
      min-width: 32px;
      height: 32px;
      padding: 0 8px;
      font-size: 11px;
    }

    .homepage-howto-step-card {
      min-height: 0;
      padding: 20px 18px 18px;
      border-radius: 22px;
    }

    .homepage-howto-step-card h3 {
      font-size: 1.25rem;
    }
  }
</style>
