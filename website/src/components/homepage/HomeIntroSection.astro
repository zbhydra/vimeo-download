---
/**
 * 插件展示：标题、导语、两个 CTA（主按钮进商店，次按钮进 Pricing），下方是插件界面示意。
 * 本区块放在首页 hero 舞台里，与首屏共用同一个 SiteStage，自己不再包底色与分隔线。
 * 示意图由 ExtensionMockup 渲染（纯 HTML/CSS，不使用截图）。
 */
import ExtensionMockup from './ExtensionMockup.astro'
import type { HomepageContent } from '../../i18n/schema'

const { copy, installUrl, pricingPath, brand, callouts } = Astro.props as {
  copy: HomepageContent['intro']
  installUrl: string
  pricingPath: string
  /** popup 标题（品牌名）。 */
  brand: string
  /** 标注胶囊文案：复用功能卡标题（页内面板 / popup）。 */
  callouts: { panel: string; popup: string }
}
---

<section class="home-intro" id="home-intro" aria-labelledby="home-intro-heading">
  <div class="container">
    <div class="home-intro-copy">
      <h2 id="home-intro-heading" class="home-intro-heading">{copy.heading}</h2>
      <p class="home-intro-lead">{copy.lead}</p>
      <div class="home-actions">
        <a
          class="btn-primary"
          href={installUrl}
          target="_blank"
          rel="noopener"
          data-ga-event="outbound_chrome_store_click"
          data-ga-source="homepage_intro"
        >
          <!-- Chrome 图标放在共享的小白底板上（.btn-chrome-plate，Layout 全局）。 -->
          <span class="btn-chrome-plate">
            <img src="/googe-ext-logo-192px.svg" alt="" width="16" height="16" loading="lazy" aria-hidden="true" />
          </span>
          <span>{copy.primaryCta}</span>
        </a>
        <a
          class="btn-secondary"
          href={pricingPath}
          data-ga-event="internal_workflow_click"
          data-ga-source="homepage_intro"
          data-ga-target="pricing"
        >{copy.secondaryCta}</a>
      </div>
    </div>

    <ExtensionMockup
      ariaLabel={copy.panel.ariaLabel}
      rows={copy.panel.rows}
      callouts={callouts}
      brand={brand}
    />
  </div>
</section>

<style>
  /* 透视地面比窗口宽，横向裁掉超出视口的部分，避免页面横向滚动（clip 不产生滚动容器，纵向不受影响）。 */
  .home-intro {
    padding: 40px 0 176px;
    overflow-x: clip;
  }

  .home-intro-copy {
    max-width: 760px;
    margin: 0 auto;
    text-align: center;
  }

  .home-intro-heading {
    color: var(--gray-1000);
    font-size: clamp(32px, 4vw, 44px);
    font-weight: 700;
    line-height: 1.1;
    letter-spacing: -0.035em;
  }

  .home-intro-lead {
    margin-top: 18px;
    color: var(--gray-900);
    font-size: 18px;
    line-height: 1.6;
  }

  .home-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px;
    margin-top: 28px;
  }

  /* 本地化按钮文案可能很长，允许换行而不是撑破布局。 */
  .home-actions :global(a) {
    height: auto;
    min-height: 48px;
    padding: 10px 22px;
    border-radius: var(--radius-md);
    font-size: 15px;
    white-space: normal;
    text-align: center;
  }

  @media (max-width: 600px) {
    .home-intro {
      padding: 40px 0 120px;
    }

    .home-intro-heading {
      font-size: 30px;
      line-height: 1.15;
      letter-spacing: -0.03em;
    }

    .home-intro-lead {
      margin-top: 14px;
      font-size: 16px;
    }

    .home-actions {
      flex-direction: column;
      gap: 10px;
      margin-top: 24px;
    }
  }
</style>
