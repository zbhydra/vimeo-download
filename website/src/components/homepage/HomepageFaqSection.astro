---
import type { FAQItemMessage } from '../../i18n/schema'

interface Props {
  copy: {
    title: string
    description?: string
    items: FAQItemMessage[]
  }
}

const { copy } = Astro.props as Props
---

<section class="homepage-faq" data-homepage-faq>
  <div class="container">
    <div class="homepage-faq-shell">
      <div class="homepage-faq-header">
        <p class="homepage-faq-kicker">FAQ</p>
        <h2>{copy.title}</h2>
        {copy.description && <p class="homepage-faq-description">{copy.description}</p>}
      </div>

      <div class="homepage-faq-list">
        {copy.items.map(item => (
          <details class="homepage-faq-item" data-homepage-faq-item open>
            <summary class="homepage-faq-question">
              <span>{item.question}</span>
              <span class="homepage-faq-marker" aria-hidden="true"></span>
            </summary>
            <p class="homepage-faq-answer">{item.answer}</p>
          </details>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .homepage-faq {
    padding: 0 0 88px;
  }

  .homepage-faq-shell {
    padding: clamp(28px, 4vw, 42px);
    border-radius: 36px;
    border: 1px solid rgba(15, 23, 42, 0.08);
    background:
      radial-gradient(circle at top right, rgba(37, 99, 235, 0.06), transparent 28%),
      linear-gradient(180deg, rgba(255, 255, 255, 0.94), rgba(255, 255, 255, 0.88));
    box-shadow: 0 28px 72px rgba(15, 23, 42, 0.08);
  }

  .homepage-faq-header {
    max-width: 42rem;
  }

  .homepage-faq-kicker {
    color: var(--color-accent);
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 0.14em;
  }

  .homepage-faq-header h2 {
    margin-top: 12px;
    font-size: clamp(1.75rem, 3vw, 2.5rem);
    line-height: 1.1;
    letter-spacing: 0;
  }

  .homepage-faq-description {
    margin-top: 12px;
    color: var(--color-gray-600);
    font-size: 15px;
    line-height: 1.65;
  }

  .homepage-faq-list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 14px;
    margin-top: 28px;
  }

  .homepage-faq-item {
    align-self: start;
    padding: 20px 22px;
    border-radius: 24px;
    border: 1px solid rgba(15, 23, 42, 0.08);
    background: rgba(248, 250, 252, 0.94);
    transition: border-color var(--transition-normal), box-shadow var(--transition-normal), background var(--transition-normal);
  }

  .homepage-faq-item[open] {
    border-color: rgba(37, 99, 235, 0.14);
    background: rgba(255, 255, 255, 0.98);
    box-shadow: 0 18px 36px rgba(37, 99, 235, 0.08);
  }

  .homepage-faq-question {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    list-style: none;
    cursor: pointer;
    font-size: 16px;
    font-weight: 700;
    line-height: 1.45;
    color: var(--color-gray-900);
  }

  .homepage-faq-question::-webkit-details-marker {
    display: none;
  }

  .homepage-faq-marker {
    position: relative;
    flex: 0 0 auto;
    width: 28px;
    height: 28px;
    border-radius: 999px;
    background: rgba(37, 99, 235, 0.08);
  }

  .homepage-faq-marker::before,
  .homepage-faq-marker::after {
    content: '';
    position: absolute;
    left: 50%;
    top: 50%;
    width: 12px;
    height: 2px;
    border-radius: 999px;
    background: var(--color-primary);
    transform: translate(-50%, -50%);
  }

  .homepage-faq-marker::after {
    transform: translate(-50%, -50%) rotate(90deg);
    transition: transform var(--transition-fast);
  }

  .homepage-faq-item[open] .homepage-faq-marker::after {
    transform: translate(-50%, -50%) rotate(0deg);
  }

  .homepage-faq-answer {
    margin-top: 14px;
    color: var(--color-gray-600);
    font-size: 15px;
    line-height: 1.8;
  }

  @media (max-width: 960px) {
    .homepage-faq-list {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 640px) {
    .homepage-faq {
      padding-bottom: 72px;
    }

    .homepage-faq-shell {
      padding: 24px 20px;
      border-radius: 28px;
    }

    .homepage-faq-question {
      font-size: 15px;
    }

    .homepage-faq-item {
      padding: 18px 18px;
      border-radius: 20px;
    }
  }
</style>
