---
/**
 * Pricing 页面 DOM 壳。
 *
 * 静态装配 Unlimited 订阅商品，并提供账号摘要与订阅管理入口。
 * 交互逻辑由 pricing-page-controller.ts 使用命令式 DOM 接管。
 */
import OrderCheckoutModal from '../order-checkout/OrderCheckoutModal.astro'
import type { OrderCheckoutModalContent } from '../order-checkout/order-checkout-types'
import PricingAuthModal from './PricingAuthModal.astro'
import type { PricingAuthCopy } from '../../i18n/schema'
import PricingSubscriptionConfirmModal from './PricingSubscriptionConfirmModal.astro'

interface PricingPageContent {
  seo: {
    title: string
    description: string
  }
  hero: {
    eyebrow: string
    title: string
    description: string
  }
  /** 主推订阅卡的徽章文案；未配置的站点不渲染徽章。 */
  popularLabel?: string
  account: {
    title: string
    loading: string
    signedOutTitle: string
    signedOutDescription: string
    signInCta: string
    signedInLabel: string
    subscriptionLabel: string
    expiresLabel: string
    statusLabel: string
    dailyUsageLabel: string
    resetLabel: string
    autoRenewLabel: string
    active: string
    expired: string
    noExpiry: string
    freePlan: string
    unlimited: string
    loadFailed: string
  }
  /** 账户菜单无障碍文案。 */
  accountMenu: {
    accountButtonLabel: string
    accountMenuLabel: string
  }
  /** 登录弹窗与订单结算弹窗读取的文案。 */
  auth: PricingAuthCopy
  checkout: OrderCheckoutModalContent['checkout']
  subscriptionManagement: {
    /** 账号订阅行的管理入口文案。 */
    buttonLabel: string
    /** 创建订阅管理入口失败时的用户提示。 */
    loadFailed: string
  }
  subscription: OrderCheckoutModalContent['subscription'] & {
    title: string
    eyebrow: string
    /** 订阅卡的卖点清单，逐条 SSR 渲染；未配置的站点不渲染清单。 */
    benefits?: readonly string[]
    /** 购买按钮下的支付保障说明；未配置的站点不渲染。 */
    trustNote?: string
    monthlyLabel: string
    yearlyLabel: string
    /** 订阅卡价格旁的终生周期标签，也用于账户区终生权益的到期栏。 */
    lifetimeLabel: string
    /** 订阅季卡价格下方的省钱标注；未配置的站点不渲染。 */
    quarterlySavingsLabel?: string
    dailyLimitLabel: string
    autoRenewOn: string
    autoRenewOff: string
    usageNotice: string
    loading: string
    loadFailed: string
    noPlan: string
    noChannels: string
    buyNow: string
    loginToBuy: string
    alreadyActive: string
    creatingOrder: string
    pendingPaymentTitle: string
    pendingPayment: string
    successTitle: string
    successDescription: string
    failedTitle: string
    close: string
    cancelPayment: string
    supportMailPrefix: string
    createFailed: string
    invalidPaymentData: string
    priceUpdated: string
    gatewayFailed: string
    orderNotFound: string
    orderExpired: string
    paymentCanceled: string
    fulfillmentFailed: string
    pollFailed: string
    pollTimeout: string
    authExpired: string
    installConfirmTitle: string
    installConfirmMessage: string
    installConfirmLinkLabel: string
    installConfirmCancel: string
    installConfirmContinue: string
    reviewReward?: {
      offerMessage: string
      reviewButton: string
      checkingTitle: string
      checkingMessage: string
      countdown: string
      claimingTitle: string
      claimingMessage: string
      successTitle: string
      successMessage: string
      alreadyClaimedTitle: string
      alreadyClaimedMessage: string
      failedTitle: string
      failedMessage: string
      busyMessage: string
      retry: string
      close: string
    }
  }
  extensionSource: {
    primaryCta: string
    signedOutCta: string
    /** 符合资格账号在插件来源页看到的好评赠送标题。 */
    reviewRewardTitle?: string
    /** 好评赠送入口的操作说明。 */
    reviewRewardDescription?: string
  }
  /** 页底购买答疑；未配置的站点不渲染 FAQ 区块。 */
  faq?: {
    title: string
    description?: string
    items: readonly {
      question: string
      answer: string
    }[]
  }
}

const { copy, extensionInstallUrl, supportEmail, showHero = false } = Astro.props as {
  copy: PricingPageContent
  extensionInstallUrl: string
  /** 商品卡下方展示的支持邮箱；未配置的站点不渲染。 */
  supportEmail?: string
  /** 是否渲染页面 hero 标题区（默认关闭，保持既有页面不变）。 */
  showHero?: boolean
}
---

<section class="pricing-page" data-pricing-page>
  <script is:inline type="application/json" data-pricing-copy set:html={JSON.stringify(copy)} />

  <div class="container pricing-container">
    {
      showHero && (
        <header class="pricing-hero">
          <p class="pricing-hero-eyebrow">{copy.hero.eyebrow}</p>
          <h1 class="pricing-hero-title" data-pricing-hero-title>{copy.hero.title}</h1>
          <p class="pricing-hero-description" data-pricing-hero-description>{copy.hero.description}</p>
        </header>
      )
    }

    <div class="pricing-account-stack">
      <aside class="pricing-account" data-pricing-account>
        <p class="pricing-account-loading" data-pricing-account-loading>
          {copy.account.loading}
        </p>
        <div class="pricing-account-signed-out" data-pricing-account-signed-out hidden>
          <p class="pricing-account-title">{copy.account.signedOutTitle}</p>
          <p>{copy.account.signedOutDescription}</p>
          <button type="button" class="btn-secondary pricing-secondary-button" data-pricing-login>
            {copy.account.signInCta}
          </button>
        </div>
        <div class="pricing-account-signed-in" data-pricing-account-signed-in hidden>
          <div class="pricing-account-balance-row">
            <div class="pricing-account-menu-wrap">
              <button
                type="button"
                class="pricing-avatar"
                data-pricing-account-button
                aria-label={copy.accountMenu.accountButtonLabel}
                aria-expanded="false"
              >
                <img class="pricing-avatar-image" data-pricing-user-avatar alt="" hidden />
                <span class="pricing-avatar-initial" data-pricing-user-initial aria-hidden="true"></span>
              </button>
              <div
                class="pricing-account-menu"
                data-pricing-account-menu
                role="menu"
                aria-label={copy.accountMenu.accountMenuLabel}
                hidden
              >
                <div class="pricing-account-email" data-pricing-account-email role="presentation"></div>
                <button type="button" class="pricing-account-logout" data-pricing-account-logout role="menuitem">
                  {copy.auth.logout}
                </button>
              </div>
            </div>
          </div>
          <div class="pricing-account-plan-row">
            <p class="pricing-account-plan-line">
              <span data-pricing-user-subscription></span>
              <span aria-hidden="true">·</span>
              <span data-pricing-user-expires></span>
            </p>
            <button
              type="button"
              class="btn-secondary pricing-subscription-manage-button"
              data-pricing-subscription-manage-button
              hidden
            >
              {copy.subscriptionManagement.buttonLabel}
            </button>
          </div>
        </div>
        <p class="pricing-inline-error" data-pricing-account-error hidden></p>
      </aside>

      {
        copy.subscription.reviewReward &&
          copy.extensionSource.reviewRewardTitle &&
          copy.extensionSource.reviewRewardDescription && (
          <button
            type="button"
            class="pricing-review-reward-banner"
            data-pricing-review-reward-banner
            hidden
          >
            <span class="pricing-review-reward-days" aria-hidden="true">7</span>
            <span class="pricing-review-reward-content">
              <span class="pricing-review-reward-title">{copy.extensionSource.reviewRewardTitle}</span>
              <span class="pricing-review-reward-description">
                {copy.extensionSource.reviewRewardDescription}
              </span>
            </span>
            <span class="pricing-review-reward-chevron" aria-hidden="true"></span>
          </button>
        )
      }
    </div>

    <section class="pricing-product-section" aria-label={copy.hero.title}>
      <div class="pricing-product-list" data-pricing-product-list>
        <div class="pricing-subscription-list" data-pricing-subscription-list>
          <p class="pricing-inline-status sr-only" role="status">{copy.subscription.loading}</p>
          {[0, 1, 2].map(() => (
            <div class="pricing-skeleton-card" aria-hidden="true">
              <span class="pricing-skeleton-name" />
              <span class="pricing-skeleton-eyebrow" />
              <span class="pricing-skeleton-price" />
              <span class="pricing-skeleton-button" />
              <span class="pricing-skeleton-note" />
              <div class="pricing-skeleton-benefits">
                <span /><span /><span />
              </div>
            </div>
          ))}
        </div>
      </div>
      {supportEmail && (
        <p class="pricing-support-email">
          {copy.subscription.supportMailPrefix}<a href={`mailto:${supportEmail}`}>{supportEmail}</a>
        </p>
      )}
    </section>
  </div>

  {
    copy.faq && (
      <div class="container pricing-faq-container">
        <section class="pricing-faq" data-pricing-faq aria-labelledby="pricing-faq-title">
          <header class="pricing-faq-header">
            <p class="pricing-faq-eyebrow">FAQ</p>
            <h2 class="pricing-faq-title" id="pricing-faq-title">
              {copy.faq.title}
            </h2>
            {copy.faq.description && <p class="pricing-faq-description">{copy.faq.description}</p>}
          </header>
          <div class="pricing-faq-list">
            {copy.faq.items.map(item => (
              <details class="pricing-faq-item" data-pricing-faq-item>
                <summary class="pricing-faq-question">
                  <span>{item.question}</span>
                  <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                    <path d="M6 9.5 12 15.5 18 9.5" fill="none" stroke-linecap="round" stroke-linejoin="round" />
                  </svg>
                </summary>
                <p class="pricing-faq-answer">{item.answer}</p>
              </details>
            ))}
          </div>
        </section>
      </div>
    )
  }

  <template data-pricing-subscription-card-template>
    <article class="pricing-product-card pricing-subscription-card" data-pricing-subscription-card>
      {copy.popularLabel && <p class="pricing-card-badge">{copy.popularLabel}</p>}
      <p class="pricing-card-name">{copy.subscription.title}</p>
      <p class="pricing-card-quota">{copy.subscription.eyebrow}</p>

      <div class="pricing-subscription-price-row">
        <p class="pricing-price" data-pricing-subscription-price></p>
        <p class="pricing-period" data-pricing-subscription-period></p>
      </div>
      <p class="pricing-savings" data-pricing-subscription-savings hidden></p>

      <p class="pricing-inline-error" data-pricing-subscription-error hidden></p>
      <button
        type="button"
        class="btn-primary pricing-primary-button"
        data-pricing-subscription-buy
        data-ga-event="upgrade_cta_click"
        data-ga-source="pricing"
        data-ga-location="subscription_card"
        disabled
      >
        {copy.subscription.buyNow}
      </button>
      {copy.subscription.trustNote && <p class="pricing-trust-note">{copy.subscription.trustNote}</p>}
      {
        copy.subscription.benefits && (
          <ul class="pricing-benefits">
            {copy.subscription.benefits.map(benefit => (
              <li>
                <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                  <path d="M4.5 12.5 9.8 17.8 19.5 6.5" fill="none" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
                <span>{benefit}</span>
              </li>
            ))}
            <li data-pricing-subscription-billing-row hidden>
              <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                <path d="M4.5 12.5 9.8 17.8 19.5 6.5" fill="none" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
              <span data-pricing-subscription-billing></span>
            </li>
          </ul>
        )
      }
    </article>
  </template>

  <template data-pricing-skeleton-template>
    <div class="pricing-skeleton-card" aria-hidden="true">
      <span class="pricing-skeleton-name" />
      <span class="pricing-skeleton-eyebrow" />
      <span class="pricing-skeleton-price" />
      <span class="pricing-skeleton-button" />
      <span class="pricing-skeleton-note" />
      <div class="pricing-skeleton-benefits">
        <span /><span /><span />
      </div>
    </div>
  </template>

  <PricingAuthModal copy={copy} />
  <OrderCheckoutModal copy={copy} />
  {copy.subscription.reviewReward && (
    <PricingSubscriptionConfirmModal copy={copy.subscription} extensionInstallUrl={extensionInstallUrl} />
  )}
</section>

<script>
  import './pricing-page-controller'
</script>

<style is:global>
  .pricing-page {
    padding: clamp(32px, 4vw, 64px) 0 32px;
  }

  .pricing-container,
  .pricing-product-section,
  .pricing-product-list,
  .pricing-product-card,
  .pricing-account,
  .pricing-account-stack {
    min-width: 0;
  }

  .pricing-container {
    display: grid;
    gap: 32px;
  }

  .pricing-account,
  .pricing-product-card {
    position: relative;
    border: 1px solid var(--gray-alpha-400);
    border-radius: var(--radius-md);
    background: var(--background-100);
    box-shadow: var(--shadow-card);
  }

  .pricing-account-stack {
    display: grid;
    gap: 8px;
    justify-self: center;
    width: auto;
    max-width: 100%;
  }

  .pricing-account {
    display: grid;
    gap: 16px;
    justify-self: center;
    width: auto;
    max-width: 100%;
    padding: 12px 24px;
    align-content: start;
  }

  .pricing-account-loading {
    text-align: center;
    color: var(--gray-900);
    font-size: 14px;
    line-height: 20px;
  }

  .pricing-account-signed-out,
  .pricing-account-signed-in {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 8px 16px;
    text-align: center;
  }

  .pricing-account-balance-row {
    justify-content: center;
  }

  .pricing-review-reward-banner {
    display: grid;
    grid-template-columns: 36px minmax(0, 1fr) 10px;
    align-items: center;
    gap: 12px;
    width: 100%;
    min-height: 72px;
    padding: 12px 16px 12px 12px;
    border: 1px solid var(--blue-400);
    border-radius: var(--radius-md);
    background: var(--blue-100);
    color: var(--gray-1000);
    box-shadow: var(--shadow-card);
    text-align: left;
    cursor: pointer;
    transition:
      background var(--transition-fast),
      border-color var(--transition-fast);
  }

  .pricing-review-reward-banner[hidden] {
    display: none;
  }

  .pricing-review-reward-days {
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    border-radius: var(--radius-sm);
    background: var(--gray-1000);
    color: var(--background-100);
    font-size: 14px;
    font-weight: 600;
    line-height: 1;
  }

  .pricing-review-reward-content {
    display: grid;
    gap: 2px;
    min-width: 0;
  }

  .pricing-review-reward-title {
    font-size: 14px;
    font-weight: 600;
    line-height: 20px;
    overflow-wrap: anywhere;
  }

  .pricing-review-reward-description {
    color: var(--gray-900);
    font-size: 13px;
    line-height: 18px;
    overflow-wrap: anywhere;
  }

  .pricing-review-reward-chevron {
    width: 8px;
    height: 8px;
    border-top: 2px solid var(--gray-900);
    border-right: 2px solid var(--gray-900);
    transform: rotate(45deg);
  }

  .pricing-review-reward-banner:hover {
    border-color: var(--blue-500);
    background: var(--blue-200);
  }

  /* ---------- Hero ---------- */
  .pricing-hero {
    display: grid;
    justify-items: center;
    gap: 12px;
    text-align: center;
  }

  .pricing-hero-eyebrow {
    color: var(--gray-900);
    font-size: 13px;
    font-weight: 500;
    line-height: 18px;
  }

  .pricing-hero-title {
    max-width: 720px;
    color: var(--gray-1000);
    font-size: clamp(32px, 5vw, 48px);
    font-weight: 600;
    letter-spacing: -0.06em;
    line-height: 1.1;
    text-wrap: balance;
  }

  .pricing-hero-description {
    max-width: 600px;
    color: var(--gray-900);
    font-size: 16px;
    line-height: 24px;
    text-wrap: balance;
  }

  /* ---------- 商品卡内容（套餐名 / 额度行 / 主推徽章 / 卖点清单 / 保障说明） ---------- */
  .pricing-card-name {
    color: var(--gray-1000);
    font-size: 20px;
    font-weight: 600;
    letter-spacing: -0.4px;
    line-height: 26px;
  }

  .pricing-card-quota {
    color: var(--gray-900);
    font-size: 13px;
    line-height: 18px;
  }

  .pricing-card-badge {
    position: absolute;
    top: -13px;
    left: 50%;
    transform: translateX(-50%);
    padding: 4px 12px;
    border-radius: 9999px;
    background: var(--gray-1000);
    color: var(--background-100);
    font-size: 12px;
    font-weight: 500;
    line-height: 16px;
    white-space: nowrap;
  }

  /* 订阅卡徽章只标记列表首张主推卡。 */
  .pricing-subscription-card > .pricing-card-badge {
    display: none;
  }

  .pricing-benefits {
    display: grid;
    gap: 12px;
    margin: 0;
    padding: 20px 0 0;
    border-top: 1px solid var(--gray-alpha-400);
    list-style: none;
  }

  .pricing-benefits li {
    display: flex;
    align-items: flex-start;
    gap: 8px;
    color: var(--gray-900);
    font-size: 14px;
    line-height: 20px;
  }

  /* 仅一条可见权益时居中（隐藏的计费行不计入），多条保持左对齐列表。 */
  .pricing-benefits li:only-child,
  .pricing-benefits:has(> li:nth-child(2):last-child[hidden]) > li:first-child {
    justify-self: center;
  }

  .pricing-benefits [data-pricing-subscription-billing-row] {
    padding: 8px 12px;
    border-radius: var(--radius-sm);
    background: var(--gray-100);
    color: var(--gray-1000);
    font-weight: 500;
  }

  .pricing-benefits li[hidden] {
    display: none;
  }

  .pricing-benefits svg {
    width: 16px;
    height: 16px;
    margin-top: 2px;
    stroke: var(--gray-1000);
    stroke-width: 2.4;
    flex: 0 0 auto;
  }

  .pricing-support-email {
    margin: 24px auto 0;
    color: var(--gray-900);
    font-size: 14px;
    line-height: 20px;
    text-align: center;
    overflow-wrap: anywhere;
  }

  .pricing-support-email a {
    color: var(--blue-700);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .pricing-support-email a:hover {
    color: var(--blue-800);
  }

  /* ---------- 加载骨架卡：与商品卡同框同栅格，光带扫过表示加载中 ---------- */
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .pricing-skeleton-card {
    display: grid;
    align-content: start;
    gap: 12px;
    padding: 24px;
    border: 1px solid var(--gray-alpha-400);
    border-radius: var(--radius-md);
    background: var(--background-100);
    box-shadow: var(--shadow-card);
  }

  .pricing-skeleton-name,
  .pricing-skeleton-eyebrow,
  .pricing-skeleton-price,
  .pricing-skeleton-note,
  .pricing-skeleton-button,
  .pricing-skeleton-benefits span {
    display: block;
    border-radius: var(--radius-sm);
    background: linear-gradient(90deg, var(--gray-100) 32%, var(--background-200) 50%, var(--gray-100) 68%);
    background-size: 200% 100%;
    animation: pricing-skeleton-sweep 1.4s ease-in-out infinite;
  }

  .pricing-skeleton-name {
    width: 56%;
    height: 20px;
  }

  .pricing-skeleton-eyebrow {
    width: 36%;
    height: 12px;
  }

  .pricing-skeleton-price {
    width: 46%;
    height: 34px;
  }

  .pricing-skeleton-note {
    width: 52%;
    height: 12px;
    justify-self: center;
  }

  .pricing-skeleton-button {
    min-height: 48px;
  }

  .pricing-skeleton-benefits {
    display: grid;
    gap: 12px;
    padding-top: 20px;
    border-top: 1px solid var(--gray-alpha-400);
  }

  .pricing-skeleton-benefits span {
    height: 14px;
  }

  .pricing-skeleton-benefits span:nth-child(1) {
    width: 82%;
  }

  .pricing-skeleton-benefits span:nth-child(2) {
    width: 68%;
  }

  .pricing-skeleton-benefits span:nth-child(3) {
    width: 76%;
  }

  @keyframes pricing-skeleton-sweep {
    from {
      background-position: 180% 0;
    }
    to {
      background-position: -80% 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .pricing-skeleton-name,
    .pricing-skeleton-eyebrow,
    .pricing-skeleton-price,
    .pricing-skeleton-note,
    .pricing-skeleton-benefits span,
    .pricing-skeleton-button {
      animation: none;
    }
  }

  .pricing-trust-note {
    margin-top: -4px;
    color: var(--gray-900);
    font-size: 13px;
    line-height: 18px;
    text-align: center;
  }

  .pricing-account-signed-out p,
  .pricing-inline-status {
    color: var(--gray-900);
    font-size: 14px;
    line-height: 20px;
  }

  .pricing-subscription-card {
    display: grid;
    gap: 12px;
  }

  .pricing-account-title {
    color: var(--gray-1000);
    font-size: 14px;
    font-weight: 600;
    line-height: 20px;
  }

  .pricing-product-section {
    display: grid;
    gap: 16px;
  }

  .pricing-account-balance-row,
  .pricing-account-plan-row,
  .pricing-account-plan-line {
    display: flex;
    align-items: center;
