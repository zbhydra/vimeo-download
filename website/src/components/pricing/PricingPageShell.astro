---
/**
 * Pricing 页面 DOM 壳。
 *
 * 静态装配 Unlimited 订阅商品，并提供账号摘要与订阅管理入口。
 * 页头带走 SiteStage band，价格卡用负 margin 跨在舞台底边上（定位见样式注释）。
 * 交互逻辑由 pricing-page-controller.ts 使用命令式 DOM 接管。
 */
import OrderCheckoutModal from '../order-checkout/OrderCheckoutModal.astro'
import SiteStage from '../site/SiteStage.astro'
import type { OrderCheckoutModalContent } from '../order-checkout/order-checkout-types'
import PricingAuthModal from './PricingAuthModal.astro'
import type { PricingAuthCopy } from '../../i18n/schema'
import PricingSubscriptionConfirmModal from './PricingSubscriptionConfirmModal.astro'

interface PricingPageContent {
  seo: {
    title: string
    description: string
  }
  hero: {
    eyebrow: string
    title: string
    description: string
  }
  /** 主推订阅卡的徽章文案；未配置的站点不渲染徽章。 */
  popularLabel?: string
  account: {
    title: string
    loading: string
    signedOutTitle: string
    signedOutDescription: string
    signInCta: string
    signedInLabel: string
    subscriptionLabel: string
    expiresLabel: string
    statusLabel: string
    dailyUsageLabel: string
    resetLabel: string
    autoRenewLabel: string
    active: string
    expired: string
    noExpiry: string
    freePlan: string
    unlimited: string
    loadFailed: string
  }
  /** 账户菜单无障碍文案。 */
  accountMenu: {
    accountButtonLabel: string
    accountMenuLabel: string
  }
  /** 登录弹窗与订单结算弹窗读取的文案。 */
  auth: PricingAuthCopy
  checkout: OrderCheckoutModalContent['checkout']
  subscriptionManagement: {
    /** 账号订阅行的管理入口文案。 */
    buttonLabel: string
    /** 创建订阅管理入口失败时的用户提示。 */
    loadFailed: string
  }
  subscription: OrderCheckoutModalContent['subscription'] & {
    title: string
    eyebrow: string
    /** 订阅卡的卖点清单，逐条 SSR 渲染；未配置的站点不渲染清单。 */
    benefits?: readonly string[]
    /** 购买按钮下的支付保障说明；未配置的站点不渲染。 */
    trustNote?: string
    monthlyLabel: string
    yearlyLabel: string
    /** 订阅卡价格旁的终生周期标签，也用于账户区终生权益的到期栏。 */
    lifetimeLabel: string
    /** 订阅季卡价格下方的省钱标注；未配置的站点不渲染。 */
    quarterlySavingsLabel?: string
    dailyLimitLabel: string
    autoRenewOn: string
    autoRenewOff: string
    usageNotice: string
    loading: string
    loadFailed: string
    noPlan: string
    noChannels: string
    buyNow: string
    loginToBuy: string
    alreadyActive: string
    creatingOrder: string
    pendingPaymentTitle: string
    pendingPayment: string
    successTitle: string
    successDescription: string
    failedTitle: string
    close: string
    cancelPayment: string
    supportMailPrefix: string
    createFailed: string
    invalidPaymentData: string
    priceUpdated: string
    gatewayFailed: string
    orderNotFound: string
    orderExpired: string
    paymentCanceled: string
    fulfillmentFailed: string
    pollFailed: string
    pollTimeout: string
    authExpired: string
    installConfirmTitle: string
    installConfirmMessage: string
    installConfirmLinkLabel: string
    installConfirmCancel: string
    installConfirmContinue: string
    reviewReward?: {
      offerMessage: string
      reviewButton: string
      checkingTitle: string
      checkingMessage: string
      countdown: string
      claimingTitle: string
      claimingMessage: string
      successTitle: string
      successMessage: string
      alreadyClaimedTitle: string
      alreadyClaimedMessage: string
      failedTitle: string
      failedMessage: string
      busyMessage: string
      retry: string
      close: string
    }
  }
  extensionSource: {
    primaryCta: string
    signedOutCta: string
    /** 符合资格账号在插件来源页看到的好评赠送标题。 */
    reviewRewardTitle?: string
    /** 好评赠送入口的操作说明。 */
    reviewRewardDescription?: string
  }
  /** 页底购买答疑；未配置的站点不渲染 FAQ 区块。 */
  faq?: {
    title: string
    description?: string
    items: readonly {
      question: string
      answer: string
    }[]
  }
}

const { copy, extensionInstallUrl, supportEmail, showHero = false } = Astro.props as {
  copy: PricingPageContent
  extensionInstallUrl: string
  /** 商品卡下方展示的支持邮箱；未配置的站点不渲染。 */
  supportEmail?: string
  /** 是否渲染页面 hero 标题区（默认关闭，保持既有页面不变）。 */
  showHero?: boolean
}
---

<section class="pricing-page" data-pricing-page>
  <script is:inline type="application/json" data-pricing-copy set:html={JSON.stringify(copy)} />

  <SiteStage variant="band">
    <div class="container pricing-band">
      {
        showHero && (
          <header class="pricing-hero">
            <p class="pricing-hero-eyebrow">
              <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                <path d="M10 3.5a1.5 1.5 0 0 1 3 0V5h3.5A1.5 1.5 0 0 1 18 6.5V10h1.5a1.5 1.5 0 0 1 0 3H18v4.5a1.5 1.5 0 0 1-1.5 1.5H13v-1.5a1.5 1.5 0 0 0-3 0V19H6.5A1.5 1.5 0 0 1 5 17.5V14h1.5a1.5 1.5 0 0 0 0-3H5V6.5A1.5 1.5 0 0 1 6.5 5H10z" />
              </svg>
              {copy.hero.eyebrow}
            </p>
            <h1 class="pricing-hero-title" data-pricing-hero-title>{copy.hero.title}</h1>
            <p class="pricing-hero-description" data-pricing-hero-description>{copy.hero.description}</p>
          </header>
        )
      }

      <div class="pricing-account-stack">
        <aside class="pricing-account" data-pricing-account>
          <p class="pricing-account-loading" data-pricing-account-loading>
            {copy.account.loading}
          </p>
          <div class="pricing-account-signed-out" data-pricing-account-signed-out hidden>
            <span class="pricing-account-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" focusable="false">
                <circle cx="12" cy="8" r="3.5" />
                <path d="M5 20a7 7 0 0 1 14 0" />
              </svg>
            </span>
            <div class="pricing-account-signed-out-text">
              <p class="pricing-account-title">{copy.account.signedOutTitle}</p>
              <p>{copy.account.signedOutDescription}</p>
            </div>
            <button type="button" class="btn-secondary pricing-secondary-button" data-pricing-login>
              {copy.account.signInCta}
            </button>
          </div>
          <div class="pricing-account-signed-in" data-pricing-account-signed-in hidden>
            <div class="pricing-account-balance-row">
              <div class="pricing-account-menu-wrap">
                <button
                  type="button"
                  class="pricing-avatar"
                  data-pricing-account-button
                  aria-label={copy.accountMenu.accountButtonLabel}
                  aria-expanded="false"
                >
                  <img class="pricing-avatar-image" data-pricing-user-avatar alt="" hidden />
                  <span class="pricing-avatar-initial" data-pricing-user-initial aria-hidden="true"></span>
                </button>
                <div
                  class="pricing-account-menu"
                  data-pricing-account-menu
                  role="menu"
                  aria-label={copy.accountMenu.accountMenuLabel}
                  hidden
                >
                  <div class="pricing-account-email" data-pricing-account-email role="presentation"></div>
                  <button type="button" class="pricing-account-logout" data-pricing-account-logout role="menuitem">
                    {copy.auth.logout}
                  </button>
                </div>
              </div>
            </div>
            <div class="pricing-account-plan-row">
              <p class="pricing-account-plan-line">
                <span data-pricing-user-subscription></span>
                <span aria-hidden="true">·</span>
                <span data-pricing-user-expires></span>
              </p>
              <button
                type="button"
                class="btn-secondary pricing-subscription-manage-button"
                data-pricing-subscription-manage-button
                hidden
              >
                {copy.subscriptionManagement.buttonLabel}
              </button>
            </div>
          </div>
          <p class="pricing-inline-error" data-pricing-account-error hidden></p>
        </aside>

        {
          copy.subscription.reviewReward &&
            copy.extensionSource.reviewRewardTitle &&
            copy.extensionSource.reviewRewardDescription && (
            <button
              type="button"
              class="pricing-review-reward-banner"
              data-pricing-review-reward-banner
              hidden
            >
              <span class="pricing-review-reward-days" aria-hidden="true">7</span>
              <span class="pricing-review-reward-content">
                <span class="pricing-review-reward-title">{copy.extensionSource.reviewRewardTitle}</span>
                <span class="pricing-review-reward-description">
                  {copy.extensionSource.reviewRewardDescription}
                </span>
              </span>
              <span class="pricing-review-reward-chevron" aria-hidden="true"></span>
            </button>
          )
        }
      </div>
    </div>
  </SiteStage>

  <div class="container pricing-plans">
    <section class="pricing-product-section" aria-label={copy.hero.title}>
      <div class="pricing-product-list" data-pricing-product-list>
        <div class="pricing-subscription-list" data-pricing-subscription-list>
          <p class="pricing-inline-status sr-only" role="status">{copy.subscription.loading}</p>
          {[0, 1, 2].map(() => (
            <div class="pricing-skeleton-card" aria-hidden="true">
              <span class="pricing-skeleton-name" />
              <span class="pricing-skeleton-eyebrow" />
              <span class="pricing-skeleton-price" />
              <span class="pricing-skeleton-button" />
              <span class="pricing-skeleton-note" />
              <div class="pricing-skeleton-benefits">
                <span /><span /><span />
              </div>
            </div>
          ))}
        </div>
      </div>
      {
        copy.subscription.trustNote && (
          <div class="pricing-trust-row">
            <span class="pricing-trust-text">
              <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                <path d="M12 3l7 3v6c0 4.5-3 7.5-7 9-4-1.5-7-4.5-7-9V6z" />
                <path d="M9 12l2 2 4-4" />
              </svg>
              {copy.subscription.trustNote}
            </span>
            <span class="pricing-trust-icons" aria-hidden="true">
              <span class="pricing-trust-icon">
                <img src="/payment-icons/paypal-monogram.png" alt="" width="13" height="16" />
              </span>
              <span class="pricing-trust-icon">
                <img class="pricing-trust-card-icon" src="/payment-icons/bank-card.svg" alt="" width="18" height="18" />
              </span>
            </span>
          </div>
        )
      }
      {supportEmail && (
        <p class="pricing-support-email">
          {copy.subscription.supportMailPrefix}<a href={`mailto:${supportEmail}`}>{supportEmail}</a>
        </p>
      )}
    </section>
  </div>

  {
    copy.faq && (
      <section class="pricing-faq-section" data-pricing-faq aria-labelledby="pricing-faq-title">
        <div class="container pricing-faq">
          <header class="pricing-faq-header">
            <h2 class="pricing-faq-title" id="pricing-faq-title">
              {copy.faq.title}
            </h2>
            {copy.faq.description && <p class="pricing-faq-description">{copy.faq.description}</p>}
          </header>
          <div class="pricing-faq-list">
            {copy.faq.items.map(item => (
              <details class="pricing-faq-item" data-pricing-faq-item>
                <summary class="pricing-faq-question">
                  <span>{item.question}</span>
                  <span class="pricing-faq-toggle" aria-hidden="true">
                    <svg viewBox="0 0 24 24" focusable="false">
                      <path d="M5 12h14" />
                      <path class="pricing-faq-toggle-bar" d="M12 5v14" />
                    </svg>
                  </span>
                </summary>
                <p class="pricing-faq-answer">{item.answer}</p>
              </details>
            ))}
          </div>
        </div>
      </section>
    )
  }

  <template data-pricing-subscription-card-template>
    <article class="pricing-product-card pricing-subscription-card" data-pricing-subscription-card>
      {
        copy.popularLabel && (
          <p class="pricing-card-badge">
            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
              <path d="M12 3l2.2 5.3L20 9l-4.4 3.9L17 19l-5-3-5 3 1.4-6.1L4 9l5.8-.7z" />
            </svg>
            {copy.popularLabel}
          </p>
        )
      }
      <p class="pricing-card-name">{copy.subscription.title}</p>
      <p class="pricing-card-quota">{copy.subscription.eyebrow}</p>

      <div class="pricing-subscription-price-row">
        <p class="pricing-price" data-pricing-subscription-price></p>
        <p class="pricing-period" data-pricing-subscription-period></p>
      </div>
      <p class="pricing-savings" data-pricing-subscription-savings hidden></p>

      <p class="pricing-inline-error" data-pricing-subscription-error hidden></p>
      <button
        type="button"
        class="btn-secondary pricing-buy-button"
        data-pricing-subscription-buy
        data-ga-event="upgrade_cta_click"
        data-ga-source="pricing"
        data-ga-location="subscription_card"
        disabled
      >
        {copy.subscription.buyNow}
      </button>
      {
        copy.subscription.trustNote && (
          <p class="pricing-trust-note">
            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
              <rect x="5" y="11" width="14" height="9" rx="2" />
              <path d="M8 11V8a4 4 0 0 1 8 0v3" />
            </svg>
            {copy.subscription.trustNote}
          </p>
        )
      }
      {
        copy.subscription.benefits && (
          <ul class="pricing-benefits">
            {copy.subscription.benefits.map(benefit => (
              <li>
                <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                  <path d="M4.5 12.5 9.8 17.8 19.5 6.5" fill="none" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
                <span>{benefit}</span>
              </li>
            ))}
            <li data-pricing-subscription-billing-row hidden>
              <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                <path d="M4.5 12.5 9.8 17.8 19.5 6.5" fill="none" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
              <span data-pricing-subscription-billing></span>
            </li>
          </ul>
        )
      }
    </article>
  </template>

  <template data-pricing-skeleton-template>
    <div class="pricing-skeleton-card" aria-hidden="true">
      <span class="pricing-skeleton-name" />
      <span class="pricing-skeleton-eyebrow" />
      <span class="pricing-skeleton-price" />
      <span class="pricing-skeleton-button" />
      <span class="pricing-skeleton-note" />
      <div class="pricing-skeleton-benefits">
        <span /><span /><span />
      </div>
    </div>
  </template>

  <PricingAuthModal copy={copy} />
  <OrderCheckoutModal copy={copy} />
  {copy.subscription.reviewReward && (
    <PricingSubscriptionConfirmModal copy={copy.subscription} extensionInstallUrl={extensionInstallUrl} />
  )}
</section>

<script>
  import './pricing-page-controller'
</script>

<style is:global>
  /*
    页头带（SiteStage band）与价格卡的叠放：
    band 内容底部留 240px，价格区用 -200px 上移，让 3 张卡跨在舞台底边上，两者之间留 40px 缓冲，
    账号菜单展开时不会被卡片盖住。价格区 z-index 高于舞台，卡片之外的区域透明，舞台仍可见。
  */
  .pricing-band {
    display: grid;
    justify-items: center;
    gap: 32px;
    padding: 88px 0 240px;
    text-align: center;
  }

  .pricing-plans {
    position: relative;
    z-index: 2;
    margin-top: -200px;
    padding-bottom: 72px;
  }

  .pricing-plans,
  .pricing-product-section,
  .pricing-product-list,
  .pricing-product-card,
  .pricing-account,
  .pricing-account-stack {
    min-width: 0;
  }

  .pricing-product-section {
    display: grid;
    gap: 40px;
  }

  /* ---------- 页头 ---------- */
  .pricing-hero {
    display: grid;
    justify-items: center;
    gap: 18px;
  }

  .pricing-hero-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-height: 30px;
    padding: 0 12px;
    border: 1px solid var(--blue-500);
    border-radius: 9999px;
    background: var(--blue-200);
    color: var(--blue-800);
    font-size: 13px;
    font-weight: 600;
    line-height: 18px;
  }

  .pricing-hero-eyebrow svg {
    width: 14px;
    height: 14px;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .pricing-hero-title {
    max-width: 880px;
    color: var(--gray-1000);
    font-size: clamp(40px, 5.4vw, 64px);
    font-weight: 700;
    letter-spacing: -0.045em;
    line-height: 1.04;
    text-wrap: balance;
  }

  .pricing-hero-description {
    max-width: 560px;
    color: var(--gray-900);
    font-size: 19px;
    line-height: 1.6;
    text-wrap: balance;
  }

  /* ---------- 登录条 / 账号摘要（玻璃面） ---------- */
  .pricing-account-stack {
    display: grid;
    justify-items: center;
    gap: 12px;
    max-width: 100%;
  }

  .pricing-account {
    position: relative;
    display: grid;
    max-width: 100%;
    padding: 8px 8px 8px 12px;
    border: 1px solid var(--glass-border);
    border-radius: var(--radius-2xl);
    background: var(--glass-bg);
  }

  .pricing-account-loading {
    padding: 6px 4px;
    color: var(--gray-900);
    font-size: 14px;
    line-height: 20px;
  }

  .pricing-account-signed-out,
  .pricing-account-signed-in {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 8px 14px;
  }

  .pricing-account-signed-in {
    padding: 4px 8px 4px 4px;
  }

  .pricing-account-icon {
    display: inline-grid;
    place-items: center;
    flex: 0 0 30px;
    width: 30px;
    height: 30px;
    border-radius: 9999px;
    background: var(--blue-200);
    color: var(--blue-700);
  }

  .pricing-account-icon svg {
    width: 16px;
    height: 16px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.9;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .pricing-account-signed-out-text {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: center;
    gap: 2px 14px;
    min-width: 0;
    text-align: left;
  }

  .pricing-account-signed-out-text p {
    color: var(--gray-900);
    font-size: 14px;
    line-height: 20px;
  }

  .pricing-account-signed-out-text .pricing-account-title {
    color: var(--gray-1000);
    font-weight: 600;
  }

  .pricing-account-balance-row,
  .pricing-account-plan-row,
  .pricing-account-plan-line {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .pricing-account-plan-row,
  .pricing-account-plan-line {
    flex-wrap: wrap;
  }

  .pricing-account-plan-line {
    color: var(--gray-900);
    font-size: 14px;
    font-weight: 500;
    line-height: 20px;
  }

  /* 账户区按钮沿用共享 .btn-secondary，只定尺寸；登录按钮在桌面是药丸，手机改满宽（见 ≤ 600 px）。 */
  .btn-secondary.pricing-secondary-button,
  .btn-secondary.pricing-subscription-manage-button {
    height: 36px;
    padding: 0 16px;
    border-radius: 9999px;
  }

  .pricing-subscription-manage-button[hidden] {
    display: none;
  }

  .pricing-avatar {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    flex: 0 0 40px;
    overflow: hidden;
    border: 1px solid var(--blue-500);
    border-radius: 9999px;
    background: var(--blue-200);
    color: var(--blue-800);
    font-weight: 600;
    font-size: 16px;
    cursor: pointer;
  }

  .pricing-account-menu-wrap {
    position: relative;
    display: inline-flex;
    align-items: center;
    flex: 0 0 auto;
  }

  .pricing-account-menu[hidden],
  .pricing-avatar-image[hidden],
  .pricing-avatar-initial[hidden] {
    display: none;
  }

  .pricing-account-menu {
    position: absolute;
    top: calc(100% + 4px);
    left: 0;
    z-index: 30;
    width: min(280px, calc(100vw - 36px));
    padding: 4px;
    border: 1px solid var(--gray-alpha-400);
    border-radius: var(--radius-md);
    background: var(--gray-100);
    box-shadow: var(--shadow-popover);
    text-align: left;
  }

  .pricing-account-email {
    width: 100%;
    min-width: 0;
    padding: 8px 12px;
    border-bottom: 1px solid var(--gray-alpha-400);
    color: var(--gray-900);
    font-size: 13px;
    line-height: 18px;
    text-align: left;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    user-select: text;
  }

  .pricing-account-logout {
    display: flex;
    align-items: center;
    width: 100%;
    min-height: 44px;
    margin-top: 4px;
    padding: 0 12px;
    border: 0;
    border-radius: var(--radius-sm);
    color: var(--gray-1000);
    background: transparent;
    font-size: 14px;
    font-weight: 500;
    text-align: left;
    cursor: pointer;
  }

  .pricing-account-logout:hover {
    background: var(--gray-200);
  }

  .pricing-avatar-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .pricing-avatar-initial {
    font-size: 16px;
    line-height: 1;
  }

  .pricing-inline-error {
    padding: 8px 12px;
    border: 1px solid var(--red-400);
    border-radius: var(--radius-sm);
    color: var(--red-900);
