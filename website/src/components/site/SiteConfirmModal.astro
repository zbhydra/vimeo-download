---
/**
 * Website 通用确认弹窗。
 *
 * 页面脚本通过 site/confirm.ts 写入标题、正文和按钮文案，组件只负责提供稳定 DOM
 * 与全站一致的深色视觉样式（Pricing 各弹窗沿用同一写法）。
 */
---

<div class="site-confirm-modal" data-site-confirm-modal hidden>
  <button
    type="button"
    class="site-confirm-backdrop"
    data-site-confirm-cancel
    aria-label="Cancel"
  ></button>

  <div
    class="site-confirm-dialog"
    role="dialog"
    aria-modal="true"
    aria-labelledby="site-confirm-title"
    aria-describedby="site-confirm-message"
  >
    <button
      type="button"
      class="site-confirm-close"
      data-site-confirm-cancel
      aria-label="Cancel"
    >
      <span aria-hidden="true">×</span>
    </button>

    <div class="site-confirm-icon" aria-hidden="true">
      <svg viewBox="0 0 24 24" focusable="false">
        <path
          d="M12 3.2 2.8 19.1c-.6 1.1.1 2.4 1.4 2.4h15.6c1.3 0 2-1.3 1.4-2.4L12 3.2Z"
          fill="none"
          stroke="currentColor"
          stroke-width="1.8"
          stroke-linejoin="round"
        />
        <path
          d="M12 8.2v5.2M12 17.1h.01"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
        />
      </svg>
    </div>

    <div class="site-confirm-copy">
      <h2 id="site-confirm-title" data-site-confirm-title></h2>
      <p id="site-confirm-message" data-site-confirm-message></p>
    </div>

    <div class="site-confirm-actions">
      <button type="button" class="btn-secondary site-confirm-action" data-site-confirm-cancel>
        Cancel
      </button>
      <button type="button" class="btn-primary site-confirm-action" data-site-confirm-submit>
        Continue
      </button>
    </div>
  </div>
</div>

<script>
  import '../../scripts/site/confirm'
</script>

<style>
  .site-confirm-modal {
    position: fixed;
    inset: 0;
    z-index: 180;
    display: grid;
    place-items: center;
    padding: 24px;
  }

  .site-confirm-modal[hidden] {
    display: none;
  }

  .site-confirm-backdrop {
    position: absolute;
    inset: 0;
    background: var(--overlay-bg);
    -webkit-backdrop-filter: blur(6px);
    backdrop-filter: blur(6px);
  }

  .site-confirm-dialog {
    position: relative;
    display: grid;
    grid-template-columns: 40px minmax(0, 1fr);
    gap: 16px;
    width: min(520px, 100%);
    padding: 24px;
    border: 1px solid var(--gray-alpha-400);
    border-radius: var(--radius-xl);
    background: var(--gray-100);
    color: var(--gray-1000);
    box-shadow: var(--shadow-modal);
  }

  .site-confirm-close {
    position: absolute;
    top: 8px;
    right: 8px;
    width: 44px;
    height: 44px;
    border-radius: var(--radius-md);
    color: var(--gray-900);
    font-size: 22px;
    line-height: 1;
  }

  .site-confirm-close:hover {
    background: var(--glass-bg);
    color: var(--gray-1000);
  }

  .site-confirm-icon {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border-radius: var(--radius-md);
    background: var(--amber-100);
    color: var(--amber-900);
  }

  .site-confirm-icon svg {
    width: 22px;
    height: 22px;
  }

  .site-confirm-copy {
    min-width: 0;
    padding-right: 40px;
  }

  .site-confirm-copy h2 {
    margin: 0;
    font-size: 20px;
    font-weight: 600;
    line-height: 26px;
    letter-spacing: -0.4px;
  }

  .site-confirm-copy p {
    margin-top: 8px;
    color: var(--gray-900);
    font-size: 14px;
    line-height: 22px;
  }

  :global(.site-confirm-copy p a) {
    color: var(--blue-700);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  :global(.site-confirm-copy p a:hover) {
    color: var(--blue-800);
  }

  .site-confirm-actions {
    grid-column: 1 / -1;
    display: flex;
    justify-content: flex-end;
    gap: 8px;
    margin-top: 8px;
  }

  .site-confirm-action {
    min-width: 96px;
  }

  @media (max-width: 600px) {
    .site-confirm-modal {
      align-items: end;
      padding: 16px;
    }

    .site-confirm-dialog {
      grid-template-columns: 1fr;
      gap: 12px;
      padding: 20px;
    }

    .site-confirm-copy {
      padding-right: 0;
    }

    .site-confirm-actions {
      display: grid;
      grid-template-columns: 1fr;
    }

    .site-confirm-action {
      width: 100%;
      min-height: 44px;
    }
  }
</style>
