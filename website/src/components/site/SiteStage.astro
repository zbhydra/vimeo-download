---
/**
 * 深色舞台：全站唯一的极光、网格、星点、光束与格式标签实现，页面组件不得另写。
 *
 * 页面内容放进默认 slot。舞台用负 margin 向上延伸到 header 下面（高度取
 * `--header-height`），再用 padding 补回，让玻璃 header 透出舞台背景。
 *
 * props.variant（默认 `hero`）：
 * - `hero`：首页（首屏 + 插件展示）、解析结果、状态 3。网格、星点、4 条光束、4 个格式标签、底部分界光线。
 * - `band`：Pricing、法务、公司、支付回跳的页头带。网格、星点、2 条光束、底部分界光线。
 * - `card`：首页收尾 CTA 卡。偏右的网格、2 条光束、28 px 圆角与 `--gradient-border` 描边，
 *   不延伸到 header 下面。
 *
 * ≤ 600 px 只留 2 条光束，不放格式标签。循环动效只动画 transform 与 opacity，
 * `prefers-reduced-motion: reduce` 时全部静止。
 */
interface Props {
  variant?: 'hero' | 'band' | 'card'
}

/**
 * 装饰用格式标签；与语言无关的格式标识，不走 i18n。
 * inset 为标签外缘距舞台水平中心的偏移（向外为正），top 为距舞台顶部的像素。
 * 定位时贴视口边缘（至少留 12 px），视口 ≥ 1200 px 都放得下。
 */
const FORMAT_TAGS = [
  { label: '1080p', tone: 'blue', side: 'left', inset: 690, top: 242 },
  { label: 'HLS → MP4', tone: 'violet', side: 'left', inset: 706, top: 434 },
  { label: 'M4A', tone: 'cyan', side: 'right', inset: 658, top: 306 },
  { label: 'VTT', tone: 'amber', side: 'right', inset: 658, top: 498 }
] as const

const { variant = 'hero' } = Astro.props
---

<section class={`site-stage site-stage--${variant}`}>
  <div class="site-stage-zone" aria-hidden="true">
    <div class="site-stage-grid"></div>
    <div class="site-stage-stars"></div>

    <div class="site-stage-beam site-stage-beam--a site-stage-beam--h">
      <span class="site-stage-beam-run"><span class="site-stage-beam-dot"></span></span>
    </div>
    <div class="site-stage-beam site-stage-beam--b site-stage-beam--h">
      <span class="site-stage-beam-run"><span class="site-stage-beam-dot"></span></span>
    </div>
    <div class="site-stage-beam site-stage-beam--c site-stage-beam--v">
      <span class="site-stage-beam-run"><span class="site-stage-beam-dot"></span></span>
    </div>
    <div class="site-stage-beam site-stage-beam--d site-stage-beam--v">
      <span class="site-stage-beam-run"><span class="site-stage-beam-dot"></span></span>
    </div>

    {
      variant === 'hero' &&
        FORMAT_TAGS.map(tag => (
          <span
            class={`site-stage-tag site-stage-tag--${tag.tone}`}
            style={`${tag.side}: max(12px, calc(50% - ${tag.inset}px)); top: ${tag.top}px`}
          >
            <i></i>
            {tag.label}
          </span>
        ))
    }
  </div>

  <div class="site-stage-content">
    <slot />
  </div>

  {variant !== 'card' && <div class="site-stage-edge" aria-hidden="true"></div>}
</section>

<style>
  .site-stage {
    position: relative;
    isolation: isolate;
    margin-top: calc(-1 * var(--header-height));
    padding-top: var(--header-height);
    background: linear-gradient(180deg, var(--background-100) 0%, #0b1226 100%);
  }

  .site-stage--card {
    margin-top: 0;
    padding-top: 0;
    border: 1px solid transparent;
    border-radius: 28px;
    background:
      linear-gradient(180deg, var(--background-100) 0%, #0b1226 100%) padding-box,
      var(--gradient-border) border-box;
  }

  .site-stage-content {
    position: relative;
    z-index: 1;
  }

  /* 装饰区只覆盖舞台顶部 758 px（效果稿的舞台高度），更高的舞台下半部分只保留底色渐变。 */
  .site-stage-zone {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: min(100%, 758px);
    overflow: hidden;
    border-radius: inherit;
    pointer-events: none;
    background:
      radial-gradient(ellipse 70% 60% at 50% -12%, rgba(45, 106, 232, 0.55), rgba(45, 106, 232, 0) 70%),
      radial-gradient(ellipse 42% 50% at 88% 6%, rgba(124, 92, 246, 0.42), rgba(124, 92, 246, 0) 70%),
      radial-gradient(ellipse 38% 46% at 8% 34%, rgba(6, 182, 212, 0.26), rgba(6, 182, 212, 0) 70%);
  }

  .site-stage--band .site-stage-zone,
  .site-stage--card .site-stage-zone {
    height: 100%;
  }

  /* 网格线落在 x = 50% + 64k、y = 64k 上，光束据此贴线移动。 */
  .site-stage-grid {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgba(148, 163, 255, 0.1) 1px, transparent 1px),
      linear-gradient(90deg, rgba(148, 163, 255, 0.1) 1px, transparent 1px);
    background-size: 64px 64px;
    background-position: calc(50% + 32px) 0;
    -webkit-mask-image: radial-gradient(ellipse 75% 80% at 50% 30%, #000 30%, transparent 85%);
    mask-image: radial-gradient(ellipse 75% 80% at 50% 30%, #000 30%, transparent 85%);
  }

  .site-stage--card .site-stage-grid {
    -webkit-mask-image: radial-gradient(ellipse 60% 90% at 80% 50%, #000 20%, transparent 75%);
    mask-image: radial-gradient(ellipse 60% 90% at 80% 50%, #000 20%, transparent 75%);
  }

  .site-stage-stars {
    position: absolute;
    inset: 0;
    background-image:
      radial-gradient(rgba(227, 232, 245, 0.55) 1px, transparent 1.6px),
      radial-gradient(rgba(165, 180, 252, 0.45) 1px, transparent 1.6px);
    background-size: 132px 132px, 188px 188px;
    background-position: 17px 23px, 71px 97px;
    -webkit-mask-image: linear-gradient(180deg, #000 0%, transparent 85%);
    mask-image: linear-gradient(180deg, #000 0%, transparent 85%);
  }

  .site-stage--card .site-stage-stars {
    display: none;
  }

  .site-stage-edge {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 1px;
    pointer-events: none;
    background: linear-gradient(
      90deg,
      rgba(76, 130, 255, 0),
      rgba(76, 130, 255, 0.9) 30%,
      rgba(167, 139, 250, 0.9) 70%,
      rgba(167, 139, 250, 0)
    );
    box-shadow: 0 0 18px 2px rgba(99, 102, 241, 0.55);
  }

  /* 光束：外层定位并裁切，内层 run 只做 transform / opacity 动画。 */
  .site-stage-beam {
    --beam: #8ab4ff;
    --beam-offset: 300px;
    --beam-duration: 7s;
    --beam-delay: 0s;
    position: absolute;
    overflow: hidden;
  }

  .site-stage-beam--h {
    --beam-anim: site-stage-beam-x;
    height: 7px;
  }

  .site-stage-beam--v {
    --beam-anim: site-stage-beam-y;
    width: 7px;
  }

  /*
    动画整体写成一条简写，方向用 --beam-anim 区分：reduce 规则与它同特异性且在后，
    才能整体覆盖为 none（拆成 animation-name 等长属性时，方向规则特异性更高，会盖不住）。
  */
  .site-stage-beam-run {
    position: absolute;
    animation: var(--beam-anim) var(--beam-duration) linear var(--beam-delay) infinite both;
  }

  .site-stage-beam--h .site-stage-beam-run {
    top: 3px;
    left: 0;
    width: 140px;
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--beam));
    transform: translateX(var(--beam-offset));
  }

  .site-stage-beam--v .site-stage-beam-run {
    top: 0;
    left: 3px;
    width: 1px;
    height: 140px;
    background: linear-gradient(180deg, transparent, var(--beam));
    transform: translateY(var(--beam-offset));
  }

  .site-stage-beam-dot {
    position: absolute;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--gray-1000);
    box-shadow:
      0 0 0 1.5px var(--beam),
      0 0 14px 4px color-mix(in srgb, var(--beam) 75%, transparent);
  }

  .site-stage-beam--h .site-stage-beam-dot {
    right: -3px;
    top: -3px;
  }

  .site-stage-beam--v .site-stage-beam-dot {
    bottom: -3px;
    left: -3px;
  }

  /* hero：4 条光束。 */
  .site-stage-beam--a {
    top: 125px;
    left: calc(50% - 704px);
    width: 512px;
  }

  .site-stage-beam--b {
    --beam: #67e8f9;
    --beam-offset: 180px;
    --beam-duration: 8.5s;
    --beam-delay: 2.4s;
    top: 701px;
    left: calc(50% + 192px);
    width: 512px;
  }

  .site-stage-beam--c {
    --beam: #c4b5fd;
    --beam-offset: 260px;
    --beam-duration: 6.5s;
    --beam-delay: 1.1s;
    top: 64px;
    left: calc(50% - 579px);
    height: 512px;
  }

  .site-stage-beam--d {
    --beam-offset: 120px;
    --beam-duration: 7.5s;
    --beam-delay: 3.6s;
    top: 192px;
    left: calc(50% + 573px);
    height: 512px;
  }

  /* band / card：只留 a、d 两条。 */
  .site-stage--band .site-stage-beam--b,
  .site-stage--band .site-stage-beam--c,
  .site-stage--card .site-stage-beam--b,
  .site-stage--card .site-stage-beam--c {
    display: none;
  }

  .site-stage--band .site-stage-beam--d {
    top: 64px;
    height: 320px;
  }

  .site-stage--card .site-stage-beam--a {
    top: 61px;
    left: 0;
  }

  .site-stage--card .site-stage-beam--d {
    top: 0;
    left: calc(50% + 189px);
    height: 420px;
  }

  /* 格式标签。 */
  .site-stage-tag {
    --tag: #8ab4ff;
    --tag-text: #c7d2fe;
    position: absolute;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    height: 28px;
    padding: 0 10px;
    border: 1px solid color-mix(in srgb, var(--tag) 28%, transparent);
    border-radius: 8px;
    background: var(--glass-bg);
    color: var(--tag-text);
    font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    font-size: 12px;
    white-space: nowrap;
  }

  .site-stage-tag i {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--tag);
    box-shadow: 0 0 8px var(--tag);
  }

  .site-stage-tag--violet {
    --tag: #c4b5fd;
    --tag-text: #ddd6fe;
  }

  .site-stage-tag--cyan {
    --tag: var(--neon-cyan);
    --tag-text: #a5f3fc;
  }

  .site-stage-tag--amber {
    --tag: #fdba74;
    --tag-text: #fed7aa;
  }

  /* 标签贴视口边缘，放在 1200 px 内容区之外；视口 < 1200 px 时内容区两侧无空间，不放。 */
  @media (max-width: 1199px) {
    .site-stage-tag {
      display: none;
    }
  }

  @keyframes site-stage-beam-x {
    0% {
      transform: translateX(-140px);
      opacity: 0;
    }
    12% {
      opacity: 1;
    }
    88% {
      opacity: 1;
    }
    100% {
      transform: translateX(520px);
      opacity: 0;
    }
  }

  @keyframes site-stage-beam-y {
    0% {
      transform: translateY(-140px);
      opacity: 0;
    }
    12% {
      opacity: 1;
    }
    88% {
      opacity: 1;
    }
    100% {
      transform: translateY(520px);
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .site-stage-beam-run {
      animation: none;
    }
  }

  /* ≤ 600 px：只留 2 条光束（a 横、d 竖），按手机宽度重新贴线，不放格式标签。 */
  @media (max-width: 600px) {
    .site-stage-beam--b,
    .site-stage-beam--c {
      display: none;
    }

    .site-stage-beam--a,
    .site-stage--card .site-stage-beam--a {
      top: 77px;
      left: 0;
      width: 300px;
    }

    .site-stage-beam--d,
    .site-stage--band .site-stage-beam--d,
    .site-stage--card .site-stage-beam--d {
      top: 120px;
      left: auto;
      right: 12px;
      height: 320px;
    }
  }
</style>
