---
import DownloadAnonymousModal from './DownloadAnonymousModal.astro'
import DownloadParseResults from './DownloadParseResults.astro'
import type { DownloadWorkspaceContent } from '../../i18n/schema'

const {
  copy,
  installUrl,
  deferRuntime = false
} = Astro.props as {
  copy: DownloadWorkspaceContent
  installUrl: string
  /** 匿名首屏是否延迟完整下载状态机，直到交互或发现可恢复本地状态。 */
  deferRuntime?: boolean
}
---

<div
  class="download-workspace"
  data-download-workspace
  data-defer-download-runtime={deferRuntime ? 'true' : undefined}
>
  <script is:inline type="application/json" data-download-copy set:html={JSON.stringify(copy)} />

  <div class="download-workspace-shell" data-download-workspace-shell>
    <DownloadParseResults copy={copy} installUrl={installUrl}>
      <slot />
    </DownloadParseResults>
  </div>

  <DownloadAnonymousModal copy={copy} />
</div>

<script>
  const root = document.querySelector<HTMLElement>('[data-download-workspace]')
  const runtimeImport = root?.dataset.deferDownloadRuntime === 'true'
    ? import('../../scripts/download/workspace-loader')
    : import('../../scripts/download/workspace')

  void runtimeImport.catch(error => {
    console.error(
      new Error('[download-workspace] Failed to load the workspace entry module.', {
        cause: error
      })
    )
  })
</script>

<style is:global>
  /*
    下载工作区：深色首屏。按钮、焦点环用 Layout 全局的 .btn-* 与 :focus-visible，这里只管布局与工作区专属控件。
    可交互元素上不写 box-shadow（会盖住全局焦点环，规则见 spec-website §4）。
  */
  .download-workspace {
    position: relative;
  }

  .download-workspace-shell {
    min-width: 0;
  }

  .download-results-panel {
    min-width: 0;
    text-align: center;
  }

  .download-panel-title {
    max-width: 1000px;
    margin: 0 auto;
    color: var(--gray-1000);
    font-size: clamp(40px, 6vw, 72px);
    font-weight: 700;
    line-height: 1.04;
    letter-spacing: -0.045em;
  }

  /* 品牌词渐变文字，标语纯色；两个 span 之间的空格保证 H1 的 textContent 可读。 */
  .download-panel-title .title-brand {
    display: block;
    padding-bottom: 6px;
    background: var(--gradient-brand-text);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .download-panel-title .title-tagline {
    display: block;
    color: var(--gray-1000);
  }

  .download-results-helper {
    max-width: 640px;
    margin: 24px auto 0;
    color: var(--gray-900);
    font-size: 19px;
    line-height: 1.6;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .download-parse-form {
    max-width: 780px;
    margin: 40px auto 0;
  }

  .download-field {
    display: grid;
    gap: 12px;
    min-width: 0;
  }

  /* 玻璃输入框：渐变描边靠 padding-box / border-box 双层背景实现，圆角随之保持。 */
  .download-parse-row {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 8px;
    border: 1px solid transparent;
    border-radius: var(--radius-xl);
    background:
      linear-gradient(var(--gray-100), var(--gray-100)) padding-box,
      var(--gradient-border) border-box;
    box-shadow: 0 0 0 6px rgba(76, 130, 255, 0.1), 0 24px 64px -24px rgba(45, 106, 232, 0.85);
  }

  .download-input {
    width: 100%;
    height: 52px;
    padding: 0 44px 0 44px;
    border: 0;
    border-radius: var(--radius-md);
    background: transparent;
    color: var(--gray-1000);
    font-size: 17px;
    line-height: 24px;
  }

  .download-input::placeholder {
    color: var(--gray-700);
  }

  .download-parse-input-shell {
    position: relative;
    flex: 1 1 auto;
    min-width: 0;
  }

  .download-parse-input-icon {
    position: absolute;
    top: 50%;
    left: 14px;
    width: 20px;
    height: 20px;
    fill: none;
    stroke: var(--gray-700);
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
    pointer-events: none;
    transform: translateY(-50%);
  }

  /* 解析提交与批量下载是视图主操作，升到 large。 */
  .download-workspace .download-parse-submit {
    flex: 0 0 auto;
    height: 52px;
    padding: 0 24px;
    border-radius: var(--radius-md);
    font-size: 16px;
  }

  .download-parse-clear-button[hidden] {
    display: none;
  }

  .download-parse-clear-button {
    position: absolute;
    top: 50%;
    right: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    padding: 0;
    border-radius: 10px;
    color: var(--gray-700);
    transform: translateY(-50%);
  }

  .download-parse-clear-button:hover {
    background: var(--gray-alpha-100);
    color: var(--gray-900);
  }

  .download-parse-clear-button:disabled {
    cursor: not-allowed;
    color: var(--gray-700);
  }

  .download-parse-clear-button svg {
    width: 18px;
    height: 18px;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
  }

  .download-pending-resume-actions[hidden] {
    display: none;
  }

  .download-pending-resume-actions {
    display: grid;
    gap: 12px;
    min-width: 0;
    max-width: 100%;
    padding: 16px;
    border: 1px solid var(--gray-alpha-400);
    border-radius: var(--radius-md);
    background: var(--gray-100);
    text-align: left;
  }

  .download-pending-resume-hint {
    margin: 0;
    min-width: 0;
    color: var(--gray-1000);
    font-size: 14px;
    line-height: 20px;
    overflow-wrap: anywhere;
  }

  .download-pending-resume-buttons {
    display: flex;
    gap: 8px;
    min-width: 0;
    flex-wrap: wrap;
  }

  .download-results-list {
    display: grid;
    gap: 12px;
    max-width: 780px;
    margin: 16px auto 0;
    text-align: left;
  }

  .download-results-list:empty {
    margin-top: 0;
  }

  /* 提示条：默认红色状态色；引导卡可见（失败或只能用插件）时改琥珀，纯 CSS 判断，不加脚本状态。 */
  .download-inline-error {
    max-width: 780px;
    margin: 16px auto 0;
    padding: 12px 16px;
    border: 1px solid var(--red-400);
    border-radius: var(--radius-md);
    background: var(--red-100);
    color: var(--red-900);
    font-size: 15px;
    line-height: 22px;
    text-align: left;
    white-space: pre-line;
  }

  .download-results-panel:has(> .download-large-file-extension-inline:not([hidden])) > .download-inline-error {
    border-color: var(--amber-400);
    background: var(--amber-100);
    color: var(--amber-900);
  }

  .download-results-actions[hidden] {
    display: none;
  }

  .download-results-actions {
    max-width: 780px;
    margin: 16px auto 0;
  }

  .download-all-button {
    width: 100%;
    height: 48px;
    font-size: 16px;
  }

  .download-result-card {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 16px 20px;
    padding: 16px;
    border: 1px solid var(--gray-alpha-400);
    border-radius: var(--radius-lg);
    background: var(--gray-100);
    box-shadow: var(--shadow-card);
  }

  .download-result-meta {
    min-width: 0;
    flex: 1 1 240px;
  }

  .download-result-thumbnail {
    flex: 0 0 176px;
    width: 176px;
    height: auto;
    aspect-ratio: 16 / 9;
    border-radius: var(--radius-md);
    object-fit: cover;
    background: var(--gray-200);
  }

  .download-result-actions {
    display: flex;
    align-items: center;
    gap: 8px;
    min-width: 0;
    flex-shrink: 0;
    flex-wrap: wrap;
    justify-content: flex-end;
  }

  .download-result-actions .download-resource-button {
    height: 48px;
    padding: 0 20px;
    border-radius: var(--radius-md);
    font-size: 15px;
  }

  .download-resource-button-label {
    min-width: 0;
  }

  .download-result-name {
    min-width: 0;
    color: var(--gray-1000);
    font-size: 16px;
    font-weight: 600;
    line-height: 24px;
    word-break: break-word;
    overflow-wrap: anywhere;
  }

  .download-result-detail {
    margin-top: 6px;
    min-width: 0;
    color: var(--gray-900);
    font-size: 14px;
    line-height: 20px;
    font-variant-numeric: tabular-nums;
    overflow-wrap: anywhere;
  }

  .download-large-file-extension-inline[hidden] {
    display: none;
  }

  .download-large-file-extension-inline {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px;
    max-width: 780px;
    margin: 16px auto 0;
    text-align: left;
  }

  .download-large-file-extension-card {
    display: flex;
    flex-direction: column;
    padding: 24px;
    border: 1px solid var(--blue-400);
    border-radius: var(--radius-lg);
    background: var(--gray-100);
    box-shadow: var(--shadow-card);
  }

  .download-large-file-extension-head {
    display: flex;
    align-items: center;
    gap: 14px;
  }

  .download-large-file-extension-logo-plate {
    display: inline-flex;
    flex: 0 0 48px;
    align-items: center;
    justify-content: center;
    width: 48px;
    height: 48px;
    border: 1px solid var(--gray-alpha-400);
    border-radius: 14px;
    background: var(--glass-bg);
  }

  .download-large-file-extension-logo {
    display: block;
    object-fit: contain;
  }

  .download-large-file-extension-title {
    margin: 0;
    color: var(--gray-1000);
    font-size: 18px;
    font-weight: 600;
    line-height: 24px;
  }

  .download-large-file-extension-card p.download-large-file-extension-description {
    flex: 1 1 auto;
    margin: 14px 0 0;
    color: var(--gray-900);
    font-size: 15px;
    line-height: 1.6;
  }

  /* 本地化文案可能很长，允许按钮换行而不是撑破卡片。 */
  .download-large-file-extension-card a {
    width: 100%;
    height: auto;
    min-height: 48px;
    margin-top: 20px;
    padding: 10px 14px;
    border-radius: var(--radius-md);
    font-size: 15px;
    white-space: normal;
    text-align: center;
  }

  .download-large-file-extension-card a svg {
    width: 18px;
    height: 18px;
    flex-shrink: 0;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  /* 一行插件入口：引导卡出现（状态 3）时隐藏，靠兄弟选择器，不需要脚本状态。 */
  .download-extension-entry {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 8px 12px;
    width: fit-content;
    max-width: 100%;
    margin: 28px auto 0;
    padding: 6px 6px 6px 16px;
    border: 1px solid var(--glass-border);
    border-radius: 999px;
    background: var(--glass-bg);
    color: var(--gray-1000);
    font-size: 14px;
    line-height: 20px;
  }

  .download-large-file-extension-inline:not([hidden]) ~ .download-extension-entry {
    display: none;
  }

  .download-extension-entry-actions {
    display: inline-flex;
    gap: 6px;
  }

  /* 外观复用全站 .btn-secondary，这里只改成药丸入口需要的尺寸。 */
  .download-extension-entry-link {
    gap: 6px;
    height: 32px;
    padding: 0 12px;
    border-radius: 999px;
    font-size: 13px;
    text-decoration: none;
  }

  .download-extension-entry-link img {
    display: block;
  }

  @media (max-width: 600px) {
    .download-results-helper {
      margin-top: 18px;
      font-size: 16px;
    }

    .download-parse-form {
      margin-top: 28px;
    }

    .download-parse-row {
      flex-direction: column;
      align-items: stretch;
    }

    .download-workspace .download-parse-submit {
      width: 100%;
    }

    .download-pending-resume-buttons {
      flex-direction: column;
    }

    .download-result-card {
      align-items: stretch;
      flex-direction: column;
    }

    .download-result-thumbnail {
      flex: 0 0 auto;
      width: 100%;
    }

    .download-result-actions {
      width: 100%;
      justify-content: stretch;
    }

    .download-result-actions .btn-primary,
    .download-pending-resume-buttons .btn-primary,
    .download-pending-resume-buttons .btn-secondary {
      width: 100%;
    }

    .download-large-file-extension-inline {
      grid-template-columns: 1fr;
    }

    /* 一行入口变成：文案在上，两个等宽按钮在下，去掉药丸外框。 */
    .download-extension-entry {
      flex-direction: column;
      align-items: stretch;
      width: 100%;
      padding: 0;
      border: 0;
      background: none;
      gap: 10px;
    }

    .download-extension-entry-actions {
      gap: 8px;
    }

    .download-extension-entry-link {
      flex: 1 1 0;
      height: 44px;
      font-size: 14px;
    }
  }
</style>
