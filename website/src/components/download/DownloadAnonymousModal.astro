---
/** 匿名下载等待窗口；原生 dialog 管理键盘焦点与模态背景。 */
import type { DownloadWorkspaceContent } from '../../i18n/schema'
const { copy } = Astro.props as { copy: DownloadWorkspaceContent }
---
<dialog class="download-anonymous-dialog" data-download-anonymous-modal aria-labelledby="download-anonymous-title">
  <h2 id="download-anonymous-title">{copy.anonymousQueue.title}</h2>
  <p data-download-anonymous-countdown></p>
  <button type="button" class="btn-secondary download-anonymous-close" data-download-anonymous-close aria-label={copy.anonymousQueue.close} autofocus><span aria-hidden="true">×</span></button>
</dialog>
<style>
  .download-anonymous-dialog {
    position: fixed;
    margin: auto;
    width: min(480px, calc(100% - 32px));
    max-height: calc(100dvh - 32px);
    overflow-y: auto;
    padding: 24px;
    border: 1px solid var(--gray-alpha-400);
    border-radius: var(--radius-md);
    background: var(--background-100);
    box-shadow: var(--shadow-modal);
    color: var(--gray-1000);
  }
  .download-anonymous-dialog::backdrop { background: rgba(0, 0, 0, 0.4); }
  .download-anonymous-dialog h2 { margin: 0 0 8px; padding-right: 48px; font-size: 24px; font-weight: 600; line-height: 32px; letter-spacing: -0.96px; }
  .download-anonymous-dialog p { margin: 0; color: var(--gray-900); font-size: 14px; line-height: 20px; }
  .download-anonymous-close {
    position: absolute;
    top: 16px;
    right: 16px;
    width: 32px;
    height: 32px;
    padding: 0;
    font-size: 20px;
    line-height: 1;
  }
</style>
