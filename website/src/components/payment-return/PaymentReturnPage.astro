---
/**
 * PayPal / Clink 支付回跳页（success / cancel）。
 *
 * 舞台 band 作背景，深色状态卡用负 margin 跨在舞台底边上（做法同 Pricing 价格卡）。
 * 状态图标按 data-payment-return-state 用 CSS 切换，状态切换仍只由 payment-return.ts 写 data 属性。
 */
import Layout from '../../layouts/Layout.astro'
import SiteStage from '../site/SiteStage.astro'
import { paymentReturnContent } from '../../i18n/payment-return'
import { PRODUCT_NAME } from '../../lib/site.mjs'

interface Props {
  /** 支付渠道。 */
  provider: 'paypal' | 'clink'
  /** 支付结果。 */
  status: 'success' | 'cancel'
}

const { provider, status } = Astro.props
const providerLabel = provider === 'paypal' ? 'PayPal' : 'Clink'
const iconSrc =
  provider === 'paypal' ? '/payment-icons/paypal-monogram.png' : '/payment-icons/clinkbill.png'
const { success, cancel } = paymentReturnContent
const initial = status === 'success' ? success.waiting : cancel
---

<Layout
  locale="en-US"
  title={`${initial.title} | ${PRODUCT_NAME}`}
  description={initial.description}
  includeSoftwareApplicationSchema={false}
  alternateLocales={[]}
  availableLocales={['en-US']}
  robots="noindex, nofollow, noarchive"
>
  <section
    class="payment-return-page"
    data-payment-return
    data-payment-return-provider={provider}
    data-payment-return-status={status}
    data-payment-return-state={status === 'success' ? 'waiting' : 'cancelled'}
  >
    {
      status === 'success' &&
        (['waiting', 'confirmed', 'failed', 'submitted'] as const).map((state) => (
          <span
            data-payment-return-copy={state}
            data-title={success[state].title}
            data-description={success[state].description}
            hidden
          />
        ))
    }
    <SiteStage variant="band">
      <div class="container payment-return-band">
        <p class="payment-return-provider">
          <img src={iconSrc} alt="" aria-hidden="true" width="24" height="24" />
          {providerLabel}
        </p>
      </div>
    </SiteStage>

    <div class="container payment-return-body">
      <div class="payment-return-card" aria-live="polite">
        <div class="payment-return-icon" aria-hidden="true">
          <svg class="payment-return-glyph payment-return-glyph--waiting" viewBox="0 0 24 24" focusable="false">
            <circle cx="12" cy="12" r="9" opacity="0.25" />
            <path d="M12 3a9 9 0 0 1 9 9" />
          </svg>
          <svg class="payment-return-glyph payment-return-glyph--confirmed" viewBox="0 0 24 24" focusable="false">
            <path d="M5 12.5l4.5 4.5L19 7.5" />
          </svg>
          <svg class="payment-return-glyph payment-return-glyph--failed" viewBox="0 0 24 24" focusable="false">
            <path d="M6 6l12 12M18 6L6 18" />
          </svg>
          <svg class="payment-return-glyph payment-return-glyph--submitted" viewBox="0 0 24 24" focusable="false">
            <circle cx="12" cy="12" r="9" />
            <path d="M12 7.5V12l3 2" />
          </svg>
        </div>
        <h1 data-payment-return-title>{initial.title}</h1>
        <p data-payment-return-description>{initial.description}</p>
        <a class="btn-primary payment-return-pricing" href="/ext-pricing/">{paymentReturnContent.backToPricing}</a>
      </div>
    </div>
  </section>
</Layout>

<script>
  import { initPaymentReturnPage } from './payment-return'

  const root = document.querySelector<HTMLElement>('[data-payment-return]')
  const provider = root?.dataset.paymentReturnProvider
  const status = root?.dataset.paymentReturnStatus
  if ((provider === 'paypal' || provider === 'clink') && (status === 'success' || status === 'cancel')) {
    initPaymentReturnPage({ provider, status })
  } else {
    console.error(
      new Error(`payment return page: invalid provider=${String(provider)} status=${String(status)}`)
    )
  }
</script>

<style>
  /*
    状态色与图标：waiting 品牌蓝（加载中），confirmed 绿，failed 红，
    submitted 中性（本页无法确认），cancelled 琥珀。--tone-* 由状态选择器改写。
  */
  .payment-return-page {
    --tone-bg: var(--blue-100);
    --tone-border: var(--blue-400);
    --tone-fg: var(--blue-700);
  }

  [data-payment-return-state='confirmed'] {
    --tone-bg: var(--green-100);
    --tone-border: var(--green-400);
    --tone-fg: var(--green-900);
  }

  [data-payment-return-state='failed'] {
    --tone-bg: var(--red-100);
    --tone-border: var(--red-400);
    --tone-fg: var(--red-900);
  }

  [data-payment-return-state='submitted'] {
    --tone-bg: var(--gray-alpha-100);
    --tone-border: var(--gray-alpha-500);
    --tone-fg: var(--gray-900);
  }

  [data-payment-return-state='cancelled'] {
    --tone-bg: var(--amber-100);
    --tone-border: var(--amber-400);
    --tone-fg: var(--amber-900);
  }

  [data-payment-return-copy][hidden] {
    display: none;
  }

  /* band 内容底部留 200px，状态卡用 -120px 上移，跨在舞台底边上。 */
  .payment-return-band {
    display: grid;
    justify-items: center;
    padding: 88px 0 200px;
  }

  .payment-return-provider {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 40px;
    padding: 0 16px 0 8px;
    border: 1px solid var(--glass-border);
    border-radius: 9999px;
    background: var(--glass-bg);
    color: var(--gray-1000);
    font-size: 14px;
    font-weight: 600;
    line-height: 20px;
  }

  .payment-return-provider img {
    display: block;
    width: 24px;
    height: 24px;
    border-radius: 50%;
  }

  .payment-return-body {
    position: relative;
    z-index: 2;
    display: grid;
    justify-items: center;
    margin-top: -120px;
    padding-bottom: 96px;
  }

  .payment-return-card {
    display: grid;
    justify-items: center;
    width: min(560px, 100%);
    padding: 40px 32px 36px;
    border: 1px solid var(--tone-border);
    border-radius: var(--radius-2xl);
    background: var(--gray-100);
    box-shadow: var(--shadow-card);
    text-align: center;
  }

  .payment-return-icon {
    display: grid;
    width: 56px;
    height: 56px;
    place-items: center;
    border: 1px solid var(--tone-border);
    border-radius: var(--radius-lg);
    background: var(--tone-bg);
    color: var(--tone-fg);
  }

  .payment-return-glyph {
    display: none;
    width: 28px;
    height: 28px;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  [data-payment-return-state='waiting'] .payment-return-glyph--waiting,
  [data-payment-return-state='confirmed'] .payment-return-glyph--confirmed,
  [data-payment-return-state='failed'] .payment-return-glyph--failed,
  [data-payment-return-state='submitted'] .payment-return-glyph--submitted,
  [data-payment-return-state='cancelled'] .payment-return-glyph--failed {
    display: block;
  }

  /* 功能性加载指示：只动画 transform，减少动态效果时停止，静态时仍是缺口环。 */
  [data-payment-return-state='waiting'] .payment-return-glyph--waiting {
    animation: payment-return-spin 1s linear infinite;
  }

  @keyframes payment-return-spin {
    to {
      transform: rotate(360deg);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    [data-payment-return-state='waiting'] .payment-return-glyph--waiting {
      animation: none;
    }
  }

  .payment-return-card h1 {
    margin: 24px 0 0;
    color: var(--gray-1000);
    font-size: 32px;
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 40px;
  }

  [data-payment-return-description] {
    max-width: 440px;
    margin: 12px 0 0;
    color: var(--gray-900);
    font-size: 16px;
    line-height: 1.7;
  }

  .payment-return-pricing {
    min-height: 44px;
    margin-top: 28px;
    padding: 0 24px;
  }

  @media (max-width: 600px) {
    .payment-return-band {
      padding: 48px 0 160px;
    }

    .payment-return-body {
      margin-top: -100px;
      padding-bottom: 64px;
    }

    .payment-return-card {
      padding: 32px 20px 24px;
    }

    .payment-return-card h1 {
      font-size: 26px;
      line-height: 34px;
    }

    .payment-return-pricing {
      width: 100%;
    }
  }
</style>
