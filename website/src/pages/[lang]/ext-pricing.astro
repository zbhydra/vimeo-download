---
// 各语言插件订阅购买页。
import PricingPage from '../../components/pages/PricingPage.astro'
import { localePaths } from '../../i18n/ui'
import type { Locale } from '../../i18n/content'

export function getStaticPaths() {
  return Object.entries(localePaths)
    .filter(([locale]) => locale !== 'en-US')
    .map(([locale, path]) => ({ params: { lang: path }, props: { locale } }))
}

const { locale } = Astro.props as { locale: Locale }
---

<PricingPage locale={locale} mode="subscription" />
