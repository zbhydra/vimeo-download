---
/**
 * Vimeo Downloader 落地页 — 多语言入口
 */
import PlatformDownloaderPage from '../../components/pages/PlatformDownloaderPage.astro'
import { localePaths } from '../../i18n/ui'
import type { Locale } from '../../i18n/content'

export function getStaticPaths() {
  return Object.entries(localePaths)
    .filter(([locale]) => locale !== 'en-US')
    .map(([locale, path]) => ({
      params: { lang: path },
      props: { locale: locale as Locale }
    }))
}

const { locale } = Astro.props as { locale: Locale }
---

<PlatformDownloaderPage locale={locale} platform="vimeo" />
