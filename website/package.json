{
  "name": "vimeo-downloader-website",
  "type": "module",
  "version": "1.0.0",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro check && astro build",
    "preview": "astro preview",
    "astro": "astro",
    "test:module-scripts": "node --test tests/module-scripts.test.js",
    "test:e2e": "playwright test",
    "test:e2e:identity": "playwright test browser-identity.spec.ts --project=chromium",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:parse-smoke": "cd ../backend && uv run python scripts/e2e_parse_download_smoke.py",
    "test:e2e:pricing-review-reward-smoke": "E2E_REAL_API_BASE_URL=${E2E_REAL_API_BASE_URL:-http://localhost:7900} E2E_WEB_PORT=${E2E_WEB_PORT:-7930} E2E_SEED_SCENARIO=pricing-review-reward playwright test --project=pricing-review-reward-smoke"
  },
  "dependencies": {
    "astro": "^5.5.2",
    "mediabunny": "1.46.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "@playwright/test": "^1.50.0",
    "sharp": "^0.34.5",
    "typescript": "^5.8.3"
  }
}
