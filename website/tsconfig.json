{
  "extends": "@vue/tsconfig/tsconfig.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "allowJs": true,
    "types": ["astro/client"],
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@website-shared/*": ["../website-shared/src/*"],
      "mediabunny": ["./node_modules/mediabunny/dist/modules/src/index.d.ts"]
    }
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.d.ts",
    "src/**/*.tsx",
    "src/**/*.astro",
    "../website-shared/src/**/*.ts",
    "../website-shared/src/**/*.d.ts",
    "../website-shared/src/**/*.astro"
  ],
  "exclude": ["node_modules", "dist"]
}
