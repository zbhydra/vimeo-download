---
/**
 * Credits 购买弹窗 DOM 壳。
 *
 * 这里只展示 Credits 商品包；支付方式选择和订单等待统一交给公共 OrderCheckoutModal。
 */
import type { DownloadWorkspaceContent } from '../../download/schema'

const { copy, installUrl, deferController = false } = Astro.props as {
  copy: DownloadWorkspaceContent
  installUrl: string
  /** 是否由下载工作区渐进加载入口统一加载 controller。 */
  deferController?: boolean
}
const creditCopy = copy.creditPurchase
---

<div
  class="credit-purchase-modal"
  data-credit-purchase-modal
  data-defer-controller={deferController ? 'true' : undefined}
  hidden
>
  <script
    is:inline
    type="application/json"
    data-credit-purchase-copy
    set:html={JSON.stringify(creditCopy)}
  />

  <div class="credit-purchase-backdrop" aria-hidden="true"></div>
  <section
    class="credit-purchase-dialog"
    data-credit-purchase-shop-dialog
    role="dialog"
    aria-modal="true"
    aria-labelledby="credit-purchase-title"
  >
    <header class="credit-purchase-header">
      <h2 id="credit-purchase-title" data-credit-purchase-title>{creditCopy.title}</h2>
      <button
        type="button"
        class="credit-purchase-close"
        data-credit-purchase-close
        aria-label={creditCopy.close}
      >
        <span aria-hidden="true">×</span>
      </button>
    </header>

    <div class="credit-purchase-install-guide" data-credit-purchase-install-guide>
      <p data-credit-purchase-install-guide-text>{creditCopy.installGuide}</p>
      <a
        class="credit-purchase-install-button"
        data-credit-purchase-install-link
        data-install-url={installUrl}
        href={installUrl}
        target="_blank"
        rel="noopener noreferrer"
      >{creditCopy.installExtension}</a>
    </div>

    <main class="credit-purchase-middle credit-purchase-shop-middle">
      <p class="credit-purchase-error" data-credit-purchase-error role="alert" hidden></p>
      <div class="credit-purchase-list" data-credit-purchase-list></div>
    </main>

    <template data-credit-purchase-card-template>
      <article class="credit-purchase-card">
        <div class="credit-purchase-card-top">
          <p class="credit-purchase-card-eyebrow" data-credit-purchase-card-eyebrow></p>
        </div>
        <p class="credit-purchase-price" data-credit-purchase-price></p>
        <div class="credit-purchase-package-row">
          <p class="credit-purchase-credits" data-credit-purchase-credits></p>
          <p class="credit-purchase-unit-price" data-credit-purchase-unit-price></p>
        </div>
        <button type="button" class="credit-purchase-buy" data-credit-purchase-buy></button>
      </article>
    </template>
  </section>

</div>

<script>
  const modal = document.querySelector<HTMLElement>('[data-credit-purchase-modal]')
  if (modal?.dataset.deferController !== 'true') {
    void import('./credit-purchase-controller').catch(error => {
      console.error(
        new Error('[credit-purchase-modal] Failed to load the purchase controller.', {
          cause: error
        })
      )
    })
  }
</script>

<style is:global>
  .credit-purchase-modal[hidden] {
    display: none;
  }

  .credit-purchase-dialog[hidden] {
    display: none;
  }

  .credit-purchase-modal {
    position: fixed;
    inset: 0;
    z-index: 140;
    display: grid;
    place-items: center;
    padding: 24px;
    color: var(--color-gray-900);
  }

  .credit-purchase-backdrop {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(circle at 20% 16%, rgba(37, 99, 235, 0.18), transparent 30%),
      radial-gradient(circle at 84% 10%, rgba(245, 158, 11, 0.18), transparent 28%),
      rgba(15, 23, 42, 0.42);
    backdrop-filter: blur(14px);
  }

  .credit-purchase-dialog {
    position: relative;
    display: grid;
    grid-template-rows: auto auto minmax(0, 1fr);
    width: min(1120px, calc(100vw - 48px));
    max-height: min(760px, calc(100vh - 48px));
    overflow: hidden;
    border: 1px solid rgba(15, 23, 42, 0.08);
    border-radius: 30px;
    background:
      radial-gradient(circle at 12% 0%, rgba(37, 99, 235, 0.1), transparent 34%),
      radial-gradient(circle at 88% 10%, rgba(245, 158, 11, 0.16), transparent 30%),
      rgba(255, 255, 255, 0.96);
    box-shadow:
      0 34px 90px rgba(15, 23, 42, 0.2),
      inset 0 1px 0 rgba(255, 255, 255, 0.9);
  }

  .credit-purchase-header,
  .credit-purchase-header {
    min-height: 82px;
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 18px;
    padding: 0 28px;
    border-color: rgba(15, 23, 42, 0.08);
    background: rgba(255, 255, 255, 0.72);
  }

  .credit-purchase-header {
    border-bottom: 1px solid rgba(15, 23, 42, 0.08);
  }

  .credit-purchase-header h2 {
    overflow-wrap: anywhere;
    margin: 0;
    color: var(--color-gray-900);
    font-size: 32px;
    line-height: 1;
    letter-spacing: -0.04em;
  }

  .credit-purchase-close {
    flex-shrink: 0;
    display: inline-grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border: 1px solid rgba(15, 23, 42, 0.08);
    border-radius: 999px;
    background: rgba(15, 23, 42, 0.04);
    color: var(--color-gray-700);
    cursor: pointer;
    font-size: 26px;
    line-height: 1;
    transition:
      background 160ms ease,
      border-color 160ms ease,
      color 160ms ease;
  }

  .credit-purchase-close:hover {
    border-color: rgba(37, 99, 235, 0.24);
    background: rgba(37, 99, 235, 0.08);
    color: var(--color-primary);
  }

  .credit-purchase-install-guide {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 16px;
    padding: 12px 28px;
    border-bottom: 1px solid rgba(15, 23, 42, 0.08);
    color: var(--color-gray-700);
    font-size: 14px;
    line-height: 1.55;
    overflow-wrap: anywhere;
  }

  .credit-purchase-install-guide p {
    margin: 0;
  }

  .credit-purchase-install-button {
    display: inline-flex;
    align-items: center;
    flex-shrink: 0;
    height: 34px;
    padding: 0 16px;
    border-radius: 999px;
    background: linear-gradient(135deg, #2563eb, #1d4ed8);
    color: #ffffff;
    font-size: 13px;
    font-weight: 700;
    text-decoration: none;
    box-shadow: 0 8px 18px rgba(37, 99, 235, 0.22);
    transition:
      transform 160ms ease,
      box-shadow 160ms ease;
  }

  .credit-purchase-install-button:hover {
    transform: translateY(-1px);
    box-shadow: 0 12px 24px rgba(37, 99, 235, 0.28);
  }

  @media (max-width: 960px) {
    .credit-purchase-install-guide {
      padding: 12px 18px;
    }
  }

  .credit-purchase-middle {
    position: relative;
    z-index: 1;
    min-height: 0;
    overflow-y: auto;
    padding: 26px 28px;
  }

  .credit-purchase-error {
    margin: 0;
    font-size: 14px;
    font-weight: 700;
    line-height: 1.55;
  }

  .credit-purchase-error {
    margin-bottom: 16px;
    padding: 12px 14px;
    border: 1px solid rgba(220, 38, 38, 0.16);
    border-radius: 16px;
    background: rgba(254, 242, 242, 0.92);
    color: #b91c1c;
  }

  .credit-purchase-list {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 16px;
  }

  .credit-purchase-empty {
    grid-column: 1 / -1;
    margin: 0;
    padding: 24px;
    border: 1px dashed rgba(15, 23, 42, 0.14);
    border-radius: 20px;
    color: var(--color-gray-600);
    text-align: center;
  }

  .credit-purchase-card {
    display: grid;
    align-content: start;
    min-height: 224px;
    padding: 22px;
    border: 1px solid rgba(15, 23, 42, 0.08);
    border-radius: 20px;
    background:
      radial-gradient(circle at top right, rgba(245, 158, 11, 0.16), transparent 44%),
      linear-gradient(180deg, rgba(255, 255, 255, 0.98), rgba(248, 250, 252, 0.94));
    box-shadow: 0 18px 42px rgba(15, 23, 42, 0.08);
    transition:
      border-color 180ms ease,
      transform 180ms ease,
      box-shadow 180ms ease;
  }

  .credit-purchase-card.is-selected,
  .credit-purchase-card:hover {
    border-color: rgba(37, 99, 235, 0.34);
    box-shadow:
      0 22px 50px rgba(37, 99, 235, 0.14),
      inset 0 1px 0 rgba(255, 255, 255, 0.95);
    transform: translateY(-2px);
  }

  .credit-purchase-card-top {
    display: grid;
    gap: 8px;
  }

  .credit-purchase-card-eyebrow {
    margin: 0;
  }

  .credit-purchase-card-eyebrow {
    color: var(--color-primary);
    font-size: 16px;
    font-weight: 800;
  }

  .credit-purchase-price {
    margin: 28px 0 14px;
    color: var(--color-gray-900);
    font-size: 48px;
    font-weight: 900;
    line-height: 0.95;
    letter-spacing: -0.06em;
  }

  .credit-purchase-package-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    width: 100%;
    min-width: 0;
    margin: 0 0 18px;
    padding: 10px 12px;
    border: 1px solid rgba(251, 191, 36, 0.26);
    border-radius: 16px;
    background: rgba(255, 251, 235, 0.96);
  }

  .credit-purchase-credits,
  .credit-purchase-unit-price {
    margin: 0;
    min-width: 0;
    font-size: 13px;
    font-weight: 900;
    line-height: 1.35;
  }

  .credit-purchase-credits {
    color: #92400e;
  }

  .credit-purchase-unit-price {
    color: var(--color-gray-700);
    overflow-wrap: anywhere;
    text-align: right;
  }

  .credit-purchase-buy {
    width: 100%;
    height: 52px;
    border: 0;
    border-radius: 16px;
    background: linear-gradient(135deg, #2563eb, #1d4ed8);
    color: #ffffff;
    cursor: pointer;
    font-size: 15px;
    font-weight: 900;
    box-shadow: 0 18px 34px rgba(37, 99, 235, 0.24);
    transition:
      opacity 160ms ease,
      transform 160ms ease,
      box-shadow 160ms ease;
  }

  .credit-purchase-buy {
    margin-top: 24px;
  }

  .credit-purchase-buy:hover:not(:disabled) {
    transform: translateY(-1px);
    box-shadow: 0 22px 44px rgba(37, 99, 235, 0.3);
  }

  .credit-purchase-buy:disabled {
    cursor: not-allowed;
    opacity: 0.58;
    transform: none;
    box-shadow: none;
  }

  .credit-purchase-close:focus-visible,
  .credit-purchase-install-button:focus-visible,
  .credit-purchase-buy:focus-visible {
    outline: 2px solid rgba(37, 99, 235, 0.34);
    outline-offset: 3px;
  }

  @media (prefers-reduced-motion: reduce) {
    .credit-purchase-card,
    .credit-purchase-install-button,
    .credit-purchase-buy {
      transition: none;
    }
  }

  @media (max-width: 760px) {
    .credit-purchase-modal {
      padding: 12px;
    }

    .credit-purchase-dialog {
      width: calc(100vw - 24px);
      max-height: calc(100vh - 24px);
      border-radius: 24px;
    }

    .credit-purchase-header {
      padding: 0 18px;
    }

    .credit-purchase-header h2 {
      font-size: 24px;
    }

    .credit-purchase-middle {
      padding: 20px 18px;
    }

    .credit-purchase-list {
      grid-template-columns: 1fr;
    }

    .credit-purchase-card {
      min-height: 220px;
    }

    .credit-purchase-price {
      font-size: 36px;
    }

  }

  /* 手机浏览器的 100vh 含工具栏后方区域，会把弹窗底部和最后一个按钮藏在工具栏后；支持动态视口单位时只占可视高度。 */
  @supports (height: 100dvh) {
    .credit-purchase-modal {
      height: 100dvh;
    }

    .credit-purchase-dialog {
      max-height: min(760px, calc(100dvh - 48px));
    }

    @media (max-width: 760px) {
      .credit-purchase-dialog {
        max-height: calc(100dvh - 24px);
      }
    }
  }
</style>
