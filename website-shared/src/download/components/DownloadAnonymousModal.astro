---
/** 匿名下载等待窗口；原生 dialog 管理键盘焦点与模态背景。 */
import type { DownloadWorkspaceContent } from '../schema'
const { copy } = Astro.props as { copy: DownloadWorkspaceContent }
---
<dialog class="download-anonymous-dialog download-auth-dialog" data-download-anonymous-modal aria-labelledby="download-anonymous-title">
  <div class="download-auth-heading">
    <h2 id="download-anonymous-title">{copy.anonymousQueue.title}</h2>
    <p data-download-anonymous-countdown></p>
    <p>{copy.anonymousQueue.hint}</p>
  </div>
  <button type="button" class="download-auth-close" data-download-anonymous-close aria-label={copy.anonymousQueue.close}><span aria-hidden="true">×</span></button>
  <button type="button" class="download-primary-button" data-download-anonymous-login autofocus>{copy.anonymousQueue.login}</button>
</dialog>
<style>
  .download-anonymous-dialog { position: fixed; margin: auto; width: min(520px, calc(100% - 40px)); max-height: calc(100dvh - 40px); overflow-y: auto; }
  .download-anonymous-dialog::backdrop { background: rgba(15, 23, 42, 0.46); backdrop-filter: blur(12px); }
  [data-download-anonymous-login] { display: flex; width: fit-content; margin-inline: auto; }
  @media (max-width: 960px) { .download-anonymous-dialog { width: calc(100% - 28px); padding: 30px 18px 20px; } }
</style>
